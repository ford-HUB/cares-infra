OPENWEATHER_API_KEY=your_key_here

# NestJS API base URL (/api only — /v1 is added by ApiClient)
# Android emulator only: http://10.0.2.2:8000/api
# iOS simulator: http://localhost:8000/api
# Physical phone (same Wi‑Fi): http://<your-pc-lan-ip>:8000/api  e.g. http://192.168.1.22:8000/api
API_BASE_URL=http://10.0.2.2:8000/api
