OPENWEATHER_API_KEY=

# NestJS API base URL (/api only — /v1 is added by ApiClient)
# Android emulator only: http://10.0.2.2:8000/api
# iOS simulator: http://localhost:8000/api
# Physical phone (same Wi‑Fi): http://<your-pc-lan-ip>:8000/api  e.g. http://192.168.1.22:8000/api
API_BASE_URL=http://10.0.2.2:8000/api

# --- Donor social sign-in ----------------------------------------------------
# Google: the WEB client id from the same Google Cloud project as the Android/iOS
# clients. It goes in the ID token's `aud`, which is what the server checks, so it
# must match GOOGLE_MOBILE_CLIENT_ID in server/.env.
GOOGLE_SERVER_CLIENT_ID=

# Facebook: from developers.facebook.com > your app > Settings > Basic. Supply these
# together with android/app/src/main/res/values/strings.xml. While they are blank the
# Facebook button stays visible but tells the user it is not set up yet, instead of
# calling an SDK that has no app id to work with.
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=
