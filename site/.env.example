# Set to false to use the NestJS API (requires server running).
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=http://localhost:8000
# Mapbox public token for event area drawing (Mapbox GL Draw + Turf.js)
VITE_MAPBOX_TOKEN=
# Set to false when NestJS /api/v1/events is deployed
VITE_EVENTS_USE_MOCK=true
# Gmail recipient for staff/coordinator access requests
VITE_ADMIN_REQUEST_EMAIL=icoyleap@gmail.com
