// CARES - Module 07: Portal Messaging (DBML, Crow's Foot)
// Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
// 4 tables + 1 referenced stub tables, 5 foreign-key relationships
//
// Paste into https://dbdiagram.io (renders Crow's Foot notation).
// Ref operators:  >  many-to-one (M:1)   <  one-to-many (1:M)   -  one-to-one (1:1)
// Optionality: a nullable FK column ("null") = optional participation of the child
// (zero-or-one parent); "not null" FK = mandatory (exactly one parent).
//
// Many-to-many (M:N) relationships are resolved through associative tables:
//   Conversation  M:N  User   via ConversationParticipant

Project CARES {
  database_type: 'PostgreSQL'
  Note: 'CARES platform database - Module 07: Portal Messaging. Generated from the Prisma schema.'
}

// ----------------------------------------------------------------------------
Table Conversation {
  conversation_id text [pk, default: `uuid()`, note: 'PK']
  last_message_at "timestamp(3)" [null, note: 'Mirrors the newest message so the contact list can sort without a join.']
  createdAt       "timestamp(3)" [not null, default: `now()`]
  updatedAt       "timestamp(3)" [not null, note: 'auto-updated on write']

  Note: 'Direct (1:1) portal messaging. Participants are portal staff — volunteers use the mobile app and are not addressable here.'
}

// ----------------------------------------------------------------------------
Table ConversationParticipant {
  conversation_participant_id text [pk, default: `uuid()`, note: 'PK']
  conversation_id             text [not null, note: 'FK -> Conversation.conversation_id']
  user_id                     text [not null, note: 'FK -> User.user_id']
  last_read_at                "timestamp(3)" [null, note: 'Everything sent after this timestamp counts as unread for this participant.']
  createdAt                   "timestamp(3)" [not null, default: `now()`]

  indexes {
    (conversation_id, user_id) [unique]
    user_id
  }
}

// ----------------------------------------------------------------------------
Table ChatMessage {
  message_id      text [pk, default: `uuid()`, note: 'PK']
  conversation_id text [not null, note: 'FK -> Conversation.conversation_id']
  sender_id       text [not null, note: 'FK -> User.user_id']
  body            text [not null]
  createdAt       "timestamp(3)" [not null, default: `now()`]

  indexes {
    (conversation_id, createdAt)
  }
}

// ----------------------------------------------------------------------------
Table ChatAttachment {
  attachment_id text [pk, default: `uuid()`, note: 'PK']
  message_id    text [not null, note: 'FK -> ChatMessage.message_id']
  name          text [not null]
  size          integer [not null]
  mime_type     text [not null]
  url           text [not null, note: 'S3 object URL; streamed back through the API, never exposed as a public link.']
  createdAt     "timestamp(3)" [not null, default: `now()`]
}

// ----------------------------------------------------------------------------
Table User {
  user_id text [pk, note: 'PK']

  Note: 'Stub - Defined in module 01 - Identity & Access. Only the key is shown here.'
}

// ----------------------------------------------------------------------------
// Relationships (child.fk  > / -  parent.pk)
// ----------------------------------------------------------------------------
Ref: ConversationParticipant.conversation_id > Conversation.conversation_id [delete: cascade]  // M:1, mandatory
Ref: ConversationParticipant.user_id > User.user_id [delete: cascade]  // M:1, mandatory
Ref: ChatMessage.conversation_id > Conversation.conversation_id [delete: cascade]  // M:1, mandatory
Ref: ChatMessage.sender_id > User.user_id [delete: cascade]  // M:1, mandatory
Ref: ChatAttachment.message_id > ChatMessage.message_id [delete: cascade]  // M:1, mandatory
