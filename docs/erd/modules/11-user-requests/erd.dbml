// CARES - Module 11: User Requests (DBML, Crow's Foot)
// Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
// 2 tables + 2 referenced stub tables, 4 foreign-key relationships
//
// Paste into https://dbdiagram.io (renders Crow's Foot notation).
// Ref operators:  >  many-to-one (M:1)   <  one-to-many (1:M)   -  one-to-one (1:1)
// Optionality: a nullable FK column ("null") = optional participation of the child
// (zero-or-one parent); "not null" FK = mandatory (exactly one parent).

Project CARES {
  database_type: 'PostgreSQL'
  Note: 'CARES platform database - Module 11: User Requests. Generated from the Prisma schema.'
}

// ----------------------------------------------------------------------------
Table UserRequest {
  user_request_id      text [pk, default: `uuid()`, note: 'PK']
  reference_number     integer [increment, unique, not null, note: 'Sequential tracking number; the portal renders it as `REQ-007`.']
  kind                 UserRequestKind [not null]
  status               UserRequestStatus [not null, default: 'PENDING']
  user_id              text [not null, note: 'FK -> User.user_id']
  requested_role       RoleType [null, note: 'ROLE_ACCESS only — the role being asked for.']
  event_id             integer [null, note: 'FK -> Event.event_id | EVENT_JOIN / EVENT_ROLE — the event the request is about.']
  participation_role   EventParticipationRole [null, note: 'EVENT_ROLE only — the event role the volunteer asked to take.']
  id_front_url         text [null, note: 'ROLE_ACCESS / ALUMNI_REGISTRATION / PARTNER_BARANGAY_REGISTRATION / MANUAL_REGISTRATION — the ID presented with the request.']
  id_back_url          text [null]
  selfie_url           text [null]
  face_similarity      float8 [null]
  summary              text [not null, note: 'One-line statement of what is being asked for, written at filing time.']
  decided_by_user_id   text [null, note: 'FK -> User.user_id']
  decided_at           "timestamp(3)" [null]
  rejection_reason     text [null, note: 'Set when a director rejects the request — the reason the requester sees in the app. Cleared never: a re-application is a new row.']
  createdAt            "timestamp(3)" [not null, default: `now()`]
  updatedAt            "timestamp(3)" [not null, note: 'auto-updated on write']
  selfie_embedding     jsonb [null, note: 'The 512-dim face embedding from the session\'s match, kept so acceptance can enrol the biometric without re-running the face service.']
  residency_proof_url  text [null, note: 'EVENT_JOIN only — the proof of residency the beneficiary attached.']
  residency_proof_name text [null]
  residency_proof_mime text [null]
  document_url         text [null, note: 'BENEFICIARY_REGISTRATION only — the supporting document attached to the sign-up form. Any file type; the director opens it before approving.']
  document_name        text [null]
  document_mime        text [null]
  document_size_bytes  integer [null]

  indexes {
    user_id
    status
    (kind, status)
  }

  Note: 'One request filed from the mobile app for a director to rule on. The proof behind a ROLE_ACCESS request (ID sides, selfie) is copied off the Redis registration session at filing time so it outlives that session\'s TTL.'
}

// ----------------------------------------------------------------------------
Table UserRequestTrailEntry {
  user_request_trail_entry_id text [pk, default: `uuid()`, note: 'PK']
  user_request_id             text [not null, note: 'FK -> UserRequest.user_request_id']
  label                       text [not null]
  actor_name                  text [not null, note: 'Who caused it — the requester for the filing, a portal account after that.']
  createdAt                   "timestamp(3)" [not null, default: `now()`]

  indexes {
    user_request_id
  }

  Note: 'One line on a request\'s history — filed, accepted, removed, restored.'
}

// ----------------------------------------------------------------------------
Table User {
  user_id text [pk, note: 'PK']

  Note: 'Stub - Defined in module 01 - Identity & Access. Only the key is shown here.'
}

// ----------------------------------------------------------------------------
Table Event {
  event_id integer [pk, note: 'PK']

  Note: 'Stub - Defined in module 04 - Events, Attendance & Engagement. Only the key is shown here.'
}

// ----------------------------------------------------------------------------
// Relationships (child.fk  > / -  parent.pk)
// ----------------------------------------------------------------------------
Ref UserRequestDecider: UserRequest.decided_by_user_id > User.user_id  // M:1, optional
Ref: UserRequest.event_id > Event.event_id [delete: cascade]  // M:1, optional
Ref UserRequestRequester: UserRequest.user_id > User.user_id [delete: cascade]  // M:1, mandatory
Ref: UserRequestTrailEntry.user_request_id > UserRequest.user_request_id [delete: cascade]  // M:1, mandatory

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
Enum RoleType {
  ADMIN
  DIRECTOR
  COORDINATOR
  VOLUNTEER
  DONOR
  BENEFICIARY
}

Enum EventParticipationRole {
  REGULAR
  ORGANIZER
  FACILITATOR
  SPEAKER
}

Enum UserRequestKind {
  ROLE_ACCESS
  EVENT_JOIN
  BENEFICIARY_REGISTRATION
  EVENT_ROLE
  RESIDENCY_VERIFICATION
  ALUMNI_REGISTRATION
  PARTNER_BARANGAY_REGISTRATION
  MANUAL_REGISTRATION [note: 'A staff or alumni sign-up whose ID photo the app could not recognize: the registrant chose manual registration, so the ID skipped the automatic checks and the face scan, and a director verifies it by hand.']
}

Enum UserRequestStatus {
  PENDING
  ACCEPTED
  DELETED
  REJECTED
}
