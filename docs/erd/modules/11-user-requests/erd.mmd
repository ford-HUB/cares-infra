%% CARES - Module 11: User Requests (Mermaid erDiagram, Crow's Foot)
%% Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
%% 2 tables + 2 referenced stub tables, 4 foreign-key relationships
%% Paste into https://mermaid.live
%% Cardinality symbols:  ||  exactly one   |o  zero or one   o{  zero or many   |{  one or many
%% Parent side: || when the FK is NOT NULL (mandatory), |o when the FK is nullable (optional).
%% Child side:  o{ for 1:M, o| for 1:1 (FK column is UNIQUE).
erDiagram
  User |o--o{ UserRequest : "decided_by"
  Event |o--o{ UserRequest : "event"
  User ||--o{ UserRequest : "user"
  UserRequest ||--o{ UserRequestTrailEntry : "user_request"

  UserRequest {
    text user_request_id PK
    serial reference_number UK
    UserRequestKind kind
    UserRequestStatus status
    text user_id FK
    RoleType requested_role "nullable"
    integer event_id FK "nullable"
    EventParticipationRole participation_role "nullable"
    text id_front_url "nullable"
    text id_back_url "nullable"
    text selfie_url "nullable"
    float8 face_similarity "nullable"
    text summary
    text decided_by_user_id FK "nullable"
    timestamp decided_at "nullable"
    text rejection_reason "nullable"
    timestamp createdAt
    timestamp updatedAt
    jsonb selfie_embedding "nullable"
    text residency_proof_url "nullable"
    text residency_proof_name "nullable"
    text residency_proof_mime "nullable"
    text document_url "nullable"
    text document_name "nullable"
    text document_mime "nullable"
    integer document_size_bytes "nullable"
  }
  UserRequestTrailEntry {
    text user_request_trail_entry_id PK
    text user_request_id FK
    text label
    text actor_name
    timestamp createdAt
  }
  User {
    text user_id PK "stub - module 01"
  }
  Event {
    serial event_id PK "stub - module 04"
  }
