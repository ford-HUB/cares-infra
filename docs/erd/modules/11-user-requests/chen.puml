@startchen
' CARES - Module 11: User Requests (Chen notation)
' Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
' 2 entities + 2 referenced stub entities, 4 relationships
' Paste into https://www.plantuml.com/plantuml or https://www.planttext.com
'
' Legend
'   rectangle = entity          oval = attribute (name : data type)
'   diamond   = relationship    underlined oval = key attribute (PK)
'   double oval = multivalued attribute (array column)
'   1 / N on a line = cardinality of the entity at that end (1:1 or 1:N)
'   double line = total participation (FK is NOT NULL: every row must take part)
'   single line = partial participation (optional)
'   Foreign-key columns are not drawn as ovals - in Chen notation the
'   relationship diamond is what represents them.
'
' Stub entities (key only) come from other modules: User (01), Event (04)

entity UserRequest {
  user_request_id : TEXT <<key>>
  reference_number : SERIAL
  kind : UserRequestKind
  status : UserRequestStatus
  requested_role : RoleType
  participation_role : EventParticipationRole
  id_front_url : TEXT
  id_back_url : TEXT
  selfie_url : TEXT
  face_similarity : FLOAT
  summary : TEXT
  decided_at : TIMESTAMP
  rejection_reason : TEXT
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
  selfie_embedding : JSONB
  residency_proof_url : TEXT
  residency_proof_name : TEXT
  residency_proof_mime : TEXT
  document_url : TEXT
  document_name : TEXT
  document_mime : TEXT
  document_size_bytes : INTEGER
}

entity UserRequestTrailEntry {
  user_request_trail_entry_id : TEXT <<key>>
  label : TEXT
  actor_name : TEXT
  createdAt : TIMESTAMP
}

entity User {
  user_id : TEXT <<key>>
}

entity Event {
  event_id : SERIAL <<key>>
}

relationship DECIDES_REQUEST {
}
DECIDES_REQUEST -1- User
DECIDES_REQUEST -N- UserRequest

relationship REQUEST_CONCERNS_EVENT {
}
REQUEST_CONCERNS_EVENT -1- Event
REQUEST_CONCERNS_EVENT -N- UserRequest

relationship FILES_REQUEST {
}
FILES_REQUEST -1- User
FILES_REQUEST =N= UserRequest

relationship REQUEST_HAS_TRAIL {
}
REQUEST_HAS_TRAIL -1- UserRequest
REQUEST_HAS_TRAIL =N= UserRequestTrailEntry

@endchen
