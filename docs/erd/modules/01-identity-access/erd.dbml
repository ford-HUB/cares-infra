// CARES - Module 01: Identity & Access (DBML, Crow's Foot)
// Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
// 9 tables, 7 foreign-key relationships
//
// Paste into https://dbdiagram.io (renders Crow's Foot notation).
// Ref operators:  >  many-to-one (M:1)   <  one-to-many (1:M)   -  one-to-one (1:1)
// Optionality: a nullable FK column ("null") = optional participation of the child
// (zero-or-one parent); "not null" FK = mandatory (exactly one parent).

Project CARES {
  database_type: 'PostgreSQL'
  Note: 'CARES platform database - Module 01: Identity & Access. Generated from the Prisma schema.'
}

// ----------------------------------------------------------------------------
Table User {
  user_id           text [pk, default: `uuid()`, note: 'PK']
  firstname         text [not null]
  lastname          text [not null]
  middle_name       text [null]
  gender            GenderType [not null, default: 'OTHER']
  age               integer [not null, default: 0]
  current_address   text [not null]
  phone_number      text [unique, not null]
  avatar            text [null]
  role_id           text [not null, note: 'FK -> Role.role_id']
  createdAt         "timestamp(3)" [not null, default: `now()`]
  updatedAt         "timestamp(3)" [not null, note: 'auto-updated on write']
  portal_department text [null]
  address_street    text [null]
  address_barangay  text [null]
  address_city      text [null]
  address_province  text [null]
  household_size    integer [null, note: 'Beneficiaries only — how many people the assistance has to cover.']
  partner_barangay  text [null, note: 'Partner-barangay volunteers only — the partner barangay they signed up through (one of PARTNER_BARANGAYS in the auth module).']
  beneficiary_type  BeneficiaryType [null, note: 'Beneficiaries only: REGULAR signed up without an ID; STUDENT verified a UC school ID with a face match, which also opens their Volunteer side.']
}

// ----------------------------------------------------------------------------
Table Role {
  role_id   text [pk, default: `uuid()`, note: 'PK']
  type      RoleType [not null, default: 'VOLUNTEER']
  createdAt "timestamp(3)" [not null, default: `now()`]
  updatedAt "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table Account {
  account_id             text [pk, default: `uuid()`, note: 'PK']
  email                  text [unique, not null]
  password               text [null, note: 'Null for an account that only ever signs in through a social provider — see `OAuthIdentity`. Password sign-in is refused outright when this is null.']
  credential_expires_at  "timestamp(3)" [null, note: 'Set when an administrator provisioned this account with temporary credentials. Sign-in is refused once it passes; null means the password does not expire, which is what a self-registered account and a completed hand-over both look like.']
  provisioned_by_user_id text [null, note: 'logical ref -> User.user_id (no FK constraint) | The administrator who issued the credential in force — null for self-registration.']
  email_verified_at      "timestamp(3)" [null, note: 'When the owner proved the address — the sign-up OTP, a provider that vouches for it, or an administrator mailing the credential to it. Mobile password sign-in is refused while this is null.']
  signature_url          text [null, note: 'Portal signatory image (directors/coordinators); printed onto certificates.']
  is_restricted          boolean [not null, default: false]
  restricted_at          "timestamp(3)" [null]
  restriction_reason     text [null]
  last_login_ip          text [null]
  user_id                text [not null, note: 'FK -> User.user_id']
  createdAt              "timestamp(3)" [not null, default: `now()`]
  updatedAt              "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table OAuthIdentity {
  oauth_identity_id text [pk, default: `uuid()`, note: 'PK']
  provider          AuthProvider [not null]
  provider_user_id  text [not null, note: 'The provider\'s immutable subject id (`sub` for Google, `id` for Facebook). The email is not the key — providers let people change it.']
  email             text [null, note: 'Whatever the provider last reported, kept for support lookups only.']
  user_id           text [not null, note: 'FK -> User.user_id']
  createdAt         "timestamp(3)" [not null, default: `now()`]
  updatedAt         "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (provider, provider_user_id) [unique]
    user_id
  }

  Note: 'A social identity that may sign in as `user`. One row per provider account, so a donor can attach both Google and Facebook to the same CARES user.  Unlike `GmailConnection` — which stores mailbox tokens and grants no access on its own — a row here *is* an authentication factor, so no provider token is kept: the token is verified with the provider at sign-in and then discarded.'
}

// ----------------------------------------------------------------------------
Table GmailConnection {
  gmail_connection_id text [pk, default: `uuid()`, note: 'PK']
  user_id             text [unique, not null, note: 'FK -> User.user_id']
  google_sub          text [not null]
  email               text [not null]
  scope               text [not null, note: 'Granted scopes, space separated, exactly as Google returned them.']
  access_token        text [not null]
  refresh_token       text [not null, note: 'Google only returns this on the first consent, so it is never overwritten with null.']
  access_expires_at   "timestamp(3)" [not null]
  createdAt           "timestamp(3)" [not null, default: `now()`]
  updatedAt           "timestamp(3)" [not null, note: 'auto-updated on write']

  Note: 'One linked Google mailbox per portal user. Tokens are issued by Google OAuth and refreshed server-side; disconnecting deletes the row so nothing stale is kept.'
}

// ----------------------------------------------------------------------------
Table UserRoleAvatar {
  user_role_avatar_id text [pk, default: `uuid()`, note: 'PK']
  user_id             text [not null, note: 'FK -> User.user_id']
  role_type           RoleType [not null]
  avatar_url          text [not null]
  createdAt           "timestamp(3)" [not null, default: `now()`]
  updatedAt           "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (user_id, role_type) [unique]
  }

  Note: 'A mobile user\'s profile photo for one side of their account. The role switcher is local to the app, so the same person can be a volunteer, donor and beneficiary; each side keeps its own picture here instead of sharing `User.avatar`.'
}

// ----------------------------------------------------------------------------
Table RolePermissionDefault {
  role_permission_default_id text [pk, default: `uuid()`, note: 'PK']
  role_type                  RoleType [not null]
  permission                 PermissionKey [not null]
  createdAt                  "timestamp(3)" [not null, default: `now()`]
  updatedAt                  "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (role_type, permission) [unique]
  }

  Note: 'Baseline rights every user of a role inherits. Keyed by `RoleType` rather than `role_id` because `Role` has no unique constraint on `type` — see the admin seeder.'
}

// ----------------------------------------------------------------------------
Table UserPermissionOverride {
  user_permission_override_id text [pk, default: `uuid()`, note: 'PK']
  user_id                     text [not null, note: 'FK -> User.user_id']
  permission                  PermissionKey [not null]
  effect                      PermissionOverrideEffect [not null]
  reason                      text [null]
  granted_by_user_id          text [not null, note: 'logical ref -> User.user_id (no FK constraint)']
  createdAt                   "timestamp(3)" [not null, default: `now()`]
  updatedAt                   "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (user_id, permission) [unique]
    user_id
  }

  Note: 'A per-user departure from the role baseline. Only rows that actually differ from the role default are stored, so an untouched user has none.'
}

// ----------------------------------------------------------------------------
Table UserActionSuspension {
  user_action_suspension_id text [pk, default: `uuid()`, note: 'PK']
  user_id                   text [not null, note: 'FK -> User.user_id']
  permission                PermissionKey [not null]
  reason                    text [not null]
  issued_by_user_id         text [not null, note: 'logical ref -> User.user_id (no FK constraint)']
  expires_at                "timestamp(3)" [null, note: 'Null means indefinite — it stays in force until an admin lifts it.']
  lifted_at                 "timestamp(3)" [null]
  lifted_by_user_id         text [null, note: 'logical ref -> User.user_id (no FK constraint)']
  createdAt                 "timestamp(3)" [not null, default: `now()`]
  updatedAt                 "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    user_id
  }

  Note: 'A violation-driven suspension of one action. Layers *over* the granted rights: the grant is preserved so lifting the suspension restores the original scope.'
}

// ----------------------------------------------------------------------------
// Relationships (child.fk  > / -  parent.pk)
// ----------------------------------------------------------------------------
Ref: User.role_id > Role.role_id  // M:1, mandatory
Ref: UserRoleAvatar.user_id > User.user_id [delete: cascade]  // M:1, mandatory
Ref: UserPermissionOverride.user_id > User.user_id [delete: cascade]  // M:1, mandatory
Ref: UserActionSuspension.user_id > User.user_id [delete: cascade]  // M:1, mandatory
Ref: OAuthIdentity.user_id > User.user_id [delete: cascade]  // M:1, mandatory
Ref: GmailConnection.user_id - User.user_id [delete: cascade]  // 1:1, mandatory
Ref: Account.user_id > User.user_id  // M:1, mandatory

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
Enum GenderType {
  MALE
  FEMALE
  OTHER
}

Enum RoleType {
  ADMIN
  DIRECTOR
  COORDINATOR
  VOLUNTEER
  DONOR
  BENEFICIARY
}

Enum PermissionKey {
  USERS_VIEW
  USERS_RESTRICT
  USERS_BLOCK_IP
  USERS_EXPORT
  USERS_REQUEST
  ACCESS_CONTROL_VIEW
  ACCESS_CONTROL_MANAGE
  EVENTS_VIEW
  EVENTS_CREATE
  EVENTS_UPDATE
  EVENTS_DELETE
  EVENTS_PUBLISH
  ATTENDANCE_VIEW
  ATTENDANCE_RECORD
  ATTENDANCE_EXPORT
  CERTIFICATES_VIEW
  CERTIFICATES_TEMPLATE_MANAGE
  CERTIFICATES_ISSUE
  DONATIONS_VIEW
  DONATIONS_RECORD
  REPORTS_VIEW
  REPORTS_PUBLISH
  SECURITY_AUDIT_VIEW
  SECURITY_SESSION_REVOKE
  SECURITY_POLICY_MANAGE
  PAYMENT_SETTINGS_MANAGE
  SYSTEM_PERFORMANCE_VIEW
  SYSTEM_NOTICE_MANAGE
  SYSTEM_SERVICE_MANAGE
  SYSTEM_MAINTENANCE_MANAGE
  CHAT_ACCESS
  MAIL_ACCESS
  SUPPORT_TICKET_MANAGE
  MOBILE_APP_ACCESS
  ATTENDANCE_MANUAL_MARK
}

Enum PermissionOverrideEffect {
  GRANT
  REVOKE
}

Enum AuthProvider {
  GOOGLE
  FACEBOOK
}

Enum BeneficiaryType {
  REGULAR
  STUDENT
}
