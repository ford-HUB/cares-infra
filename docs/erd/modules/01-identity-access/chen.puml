@startchen
' CARES - Module 01: Identity & Access (Chen notation)
' Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
' 9 entities, 7 relationships
' Paste into https://www.plantuml.com/plantuml or https://www.planttext.com
'
' Legend
'   rectangle = entity          oval = attribute (name : data type)
'   diamond   = relationship    underlined oval = key attribute (PK)
'   double oval = multivalued attribute (array column)
'   1 / N on a line = cardinality of the entity at that end (1:1 or 1:N)
'   double line = total participation (FK is NOT NULL: every row must take part)
'   single line = partial participation (optional)
'   Foreign-key columns are not drawn as ovals - in Chen notation the
'   relationship diamond is what represents them.

entity User {
  user_id : TEXT <<key>>
  firstname : TEXT
  lastname : TEXT
  middle_name : TEXT
  gender : GenderType
  age : INTEGER
  current_address : TEXT
  phone_number : TEXT
  avatar : TEXT
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
  portal_department : TEXT
  address_street : TEXT
  address_barangay : TEXT
  address_city : TEXT
  address_province : TEXT
  household_size : INTEGER
  partner_barangay : TEXT
  beneficiary_type : BeneficiaryType
}

entity Role {
  role_id : TEXT <<key>>
  type : RoleType
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity Account {
  account_id : TEXT <<key>>
  email : TEXT
  password : TEXT
  credential_expires_at : TIMESTAMP
  provisioned_by_user_id : TEXT
  email_verified_at : TIMESTAMP
  signature_url : TEXT
  is_restricted : BOOLEAN
  restricted_at : TIMESTAMP
  restriction_reason : TEXT
  last_login_ip : TEXT
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity OAuthIdentity {
  oauth_identity_id : TEXT <<key>>
  provider : AuthProvider
  provider_user_id : TEXT
  email : TEXT
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity GmailConnection {
  gmail_connection_id : TEXT <<key>>
  google_sub : TEXT
  email : TEXT
  scope : TEXT
  access_token : TEXT
  refresh_token : TEXT
  access_expires_at : TIMESTAMP
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity UserRoleAvatar {
  user_role_avatar_id : TEXT <<key>>
  role_type : RoleType
  avatar_url : TEXT
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity RolePermissionDefault {
  role_permission_default_id : TEXT <<key>>
  role_type : RoleType
  permission : PermissionKey
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity UserPermissionOverride {
  user_permission_override_id : TEXT <<key>>
  permission : PermissionKey
  effect : PermissionOverrideEffect
  reason : TEXT
  granted_by_user_id : TEXT
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity UserActionSuspension {
  user_action_suspension_id : TEXT <<key>>
  permission : PermissionKey
  reason : TEXT
  issued_by_user_id : TEXT
  expires_at : TIMESTAMP
  lifted_at : TIMESTAMP
  lifted_by_user_id : TEXT
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

relationship HAS_ROLE {
}
HAS_ROLE -1- Role
HAS_ROLE =N= User

relationship HAS_ROLE_AVATAR {
}
HAS_ROLE_AVATAR -1- User
HAS_ROLE_AVATAR =N= UserRoleAvatar

relationship HAS_PERMISSION_OVERRIDE {
}
HAS_PERMISSION_OVERRIDE -1- User
HAS_PERMISSION_OVERRIDE =N= UserPermissionOverride

relationship HAS_SUSPENSION {
}
HAS_SUSPENSION -1- User
HAS_SUSPENSION =N= UserActionSuspension

relationship LINKS_OAUTH_IDENTITY {
}
LINKS_OAUTH_IDENTITY -1- User
LINKS_OAUTH_IDENTITY =N= OAuthIdentity

relationship CONNECTS_GMAIL {
}
CONNECTS_GMAIL -1- User
CONNECTS_GMAIL =1= GmailConnection

relationship OWNS_ACCOUNT {
}
OWNS_ACCOUNT -1- User
OWNS_ACCOUNT =N= Account

@endchen
