%% CARES - Module 01: Identity & Access (Mermaid erDiagram, Crow's Foot)
%% Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
%% 9 tables, 7 foreign-key relationships
%% Paste into https://mermaid.live
%% Cardinality symbols:  ||  exactly one   |o  zero or one   o{  zero or many   |{  one or many
%% Parent side: || when the FK is NOT NULL (mandatory), |o when the FK is nullable (optional).
%% Child side:  o{ for 1:M, o| for 1:1 (FK column is UNIQUE).
erDiagram
  Role ||--o{ User : "role"
  User ||--o{ UserRoleAvatar : "user"
  User ||--o{ UserPermissionOverride : "user"
  User ||--o{ UserActionSuspension : "user"
  User ||--o{ OAuthIdentity : "user"
  User ||--o| GmailConnection : "user"
  User ||--o{ Account : "user"

  User {
    text user_id PK
    text firstname
    text lastname
    text middle_name "nullable"
    GenderType gender
    integer age
    text current_address
    text phone_number UK
    text avatar "nullable"
    text role_id FK
    timestamp createdAt
    timestamp updatedAt
    text portal_department "nullable"
    text address_street "nullable"
    text address_barangay "nullable"
    text address_city "nullable"
    text address_province "nullable"
    integer household_size "nullable"
    text partner_barangay "nullable"
    BeneficiaryType beneficiary_type "nullable"
  }
  Role {
    text role_id PK
    RoleType type
    timestamp createdAt
    timestamp updatedAt
  }
  Account {
    text account_id PK
    text email UK
    text password "nullable"
    timestamp credential_expires_at "nullable"
    text provisioned_by_user_id "nullable, ref User"
    timestamp email_verified_at "nullable"
    text signature_url "nullable"
    boolean is_restricted
    timestamp restricted_at "nullable"
    text restriction_reason "nullable"
    text last_login_ip "nullable"
    text user_id FK
    timestamp createdAt
    timestamp updatedAt
  }
  OAuthIdentity {
    text oauth_identity_id PK
    AuthProvider provider
    text provider_user_id
    text email "nullable"
    text user_id FK
    timestamp createdAt
    timestamp updatedAt
  }
  GmailConnection {
    text gmail_connection_id PK
    text user_id FK, UK
    text google_sub
    text email
    text scope
    text access_token
    text refresh_token
    timestamp access_expires_at
    timestamp createdAt
    timestamp updatedAt
  }
  UserRoleAvatar {
    text user_role_avatar_id PK
    text user_id FK
    RoleType role_type
    text avatar_url
    timestamp createdAt
    timestamp updatedAt
  }
  RolePermissionDefault {
    text role_permission_default_id PK
    RoleType role_type
    PermissionKey permission
    timestamp createdAt
    timestamp updatedAt
  }
  UserPermissionOverride {
    text user_permission_override_id PK
    text user_id FK
    PermissionKey permission
    PermissionOverrideEffect effect
    text reason "nullable"
    text granted_by_user_id "ref User"
    timestamp createdAt
    timestamp updatedAt
  }
  UserActionSuspension {
    text user_action_suspension_id PK
    text user_id FK
    PermissionKey permission
    text reason
    text issued_by_user_id "ref User"
    timestamp expires_at "nullable"
    timestamp lifted_at "nullable"
    text lifted_by_user_id "nullable, ref User"
    timestamp createdAt
    timestamp updatedAt
  }
