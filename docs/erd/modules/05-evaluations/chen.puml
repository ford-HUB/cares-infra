@startchen
' CARES - Module 05: Post-Event Evaluations (Chen notation)
' Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
' 3 entities + 2 referenced stub entities, 6 relationships
' Paste into https://www.plantuml.com/plantuml or https://www.planttext.com
'
' Legend
'   rectangle = entity          oval = attribute (name : data type)
'   diamond   = relationship    underlined oval = key attribute (PK)
'   double oval = multivalued attribute (array column)
'   1 / N on a line = cardinality of the entity at that end (1:1 or 1:N)
'   double line = total participation (FK is NOT NULL: every row must take part)
'   single line = partial participation (optional)
'   Foreign-key columns are not drawn as ovals - in Chen notation the
'   relationship diamond is what represents them.
'
' M:N relationships are resolved through associative entities:
'   Event M:N User via EvaluationResponse
'
' Stub entities (key only) come from other modules: User (01), Event (04)

entity EvaluationForm {
  evaluation_form_id : TEXT <<key>>
  title : TEXT
  description : TEXT
  header_typography : JSONB
  questions : JSONB
  status : EvaluationFormStatus
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
  is_default : BOOLEAN
}

entity EvaluationAssignment {
  evaluation_assignment_id : TEXT <<key>>
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity EvaluationResponse {
  evaluation_response_id : TEXT <<key>>
  answers : JSONB
  rating : INTEGER
  status : EvaluationResponseStatus
  submitted_at : TIMESTAMP
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity User {
  user_id : TEXT <<key>>
}

entity Event {
  event_id : SERIAL <<key>>
}

relationship ASSIGNS_EVALUATION {
}
ASSIGNS_EVALUATION -1- User
ASSIGNS_EVALUATION -N- EvaluationAssignment

relationship EVENT_USES_FORM {
}
EVENT_USES_FORM -1- Event
EVENT_USES_FORM =1= EvaluationAssignment

relationship FORM_ASSIGNED_TO {
}
FORM_ASSIGNED_TO -1- EvaluationForm
FORM_ASSIGNED_TO =N= EvaluationAssignment

relationship EVENT_HAS_RESPONSE {
}
EVENT_HAS_RESPONSE -1- Event
EVENT_HAS_RESPONSE =N= EvaluationResponse

relationship FORM_HAS_RESPONSE {
}
FORM_HAS_RESPONSE -1- EvaluationForm
FORM_HAS_RESPONSE =N= EvaluationResponse

relationship SUBMITS_EVALUATION {
}
SUBMITS_EVALUATION -1- User
SUBMITS_EVALUATION =N= EvaluationResponse

@endchen
