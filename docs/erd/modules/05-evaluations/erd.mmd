%% CARES - Module 05: Post-Event Evaluations (Mermaid erDiagram, Crow's Foot)
%% Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
%% 3 tables + 2 referenced stub tables, 6 foreign-key relationships
%% Paste into https://mermaid.live
%% Cardinality symbols:  ||  exactly one   |o  zero or one   o{  zero or many   |{  one or many
%% Parent side: || when the FK is NOT NULL (mandatory), |o when the FK is nullable (optional).
%% Child side:  o{ for 1:M, o| for 1:1 (FK column is UNIQUE).
%% M:N relationships are resolved through associative entities:
%%   Event M:N User via EvaluationResponse
erDiagram
  User |o--o{ EvaluationAssignment : "assigned_by"
  Event ||--o| EvaluationAssignment : "event"
  EvaluationForm ||--o{ EvaluationAssignment : "form"
  Event ||--o{ EvaluationResponse : "event"
  EvaluationForm ||--o{ EvaluationResponse : "form"
  User ||--o{ EvaluationResponse : "user"

  EvaluationForm {
    text evaluation_form_id PK
    text title
    text description
    jsonb header_typography
    jsonb questions
    EvaluationFormStatus status
    timestamp createdAt
    timestamp updatedAt
    boolean is_default
  }
  EvaluationAssignment {
    text evaluation_assignment_id PK
    text form_id FK
    integer event_id FK, UK
    text assigned_by_id FK "nullable"
    timestamp createdAt
    timestamp updatedAt
  }
  EvaluationResponse {
    text evaluation_response_id PK
    text form_id FK
    integer event_id FK
    text user_id FK
    jsonb answers
    integer rating "nullable"
    EvaluationResponseStatus status
    timestamp submitted_at
    timestamp createdAt
    timestamp updatedAt
  }
  User {
    text user_id PK "stub - module 01"
  }
  Event {
    serial event_id PK "stub - module 04"
  }
