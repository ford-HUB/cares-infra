%% CARES - Module 09: Support Tickets (Mermaid erDiagram, Crow's Foot)
%% Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
%% 2 tables + 1 referenced stub tables, 4 foreign-key relationships
%% Paste into https://mermaid.live
%% Cardinality symbols:  ||  exactly one   |o  zero or one   o{  zero or many   |{  one or many
%% Parent side: || when the FK is NOT NULL (mandatory), |o when the FK is nullable (optional).
%% Child side:  o{ for 1:M, o| for 1:1 (FK column is UNIQUE).
erDiagram
  User |o--o{ SupportTicket : "assignee"
  User ||--o{ SupportTicket : "requester"
  User |o--o{ SupportTicketReply : "author"
  SupportTicket ||--o{ SupportTicketReply : "ticket"

  SupportTicket {
    text support_ticket_id PK
    serial reference_number UK
    text subject
    text description
    SupportTicketType type
    SupportTicketStatus status
    SupportTicketPriority priority
    text requester_id FK
    text assignee_id FK "nullable"
    LoginSource source
    timestamp createdAt
    timestamp updatedAt
  }
  SupportTicketReply {
    text support_ticket_reply_id PK
    text support_ticket_id FK
    text author_id FK "nullable"
    text author_name
    SupportTicketAuthorType author_type
    text body
    timestamp createdAt
  }
  User {
    text user_id PK "stub - module 01"
  }
