// CARES - Module 09: Support Tickets (DBML, Crow's Foot)
// Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
// 2 tables + 1 referenced stub tables, 4 foreign-key relationships
//
// Paste into https://dbdiagram.io (renders Crow's Foot notation).
// Ref operators:  >  many-to-one (M:1)   <  one-to-many (1:M)   -  one-to-one (1:1)
// Optionality: a nullable FK column ("null") = optional participation of the child
// (zero-or-one parent); "not null" FK = mandatory (exactly one parent).

Project CARES {
  database_type: 'PostgreSQL'
  Note: 'CARES platform database - Module 09: Support Tickets. Generated from the Prisma schema.'
}

// ----------------------------------------------------------------------------
Table SupportTicket {
  support_ticket_id text [pk, default: `uuid()`, note: 'PK']
  reference_number  integer [increment, unique, not null]
  subject           text [not null]
  description       text [not null]
  type              SupportTicketType [not null]
  status            SupportTicketStatus [not null, default: 'OPEN']
  priority          SupportTicketPriority [not null, default: 'MEDIUM']
  requester_id      text [not null, note: 'FK -> User.user_id']
  assignee_id       text [null, note: 'FK -> User.user_id | Null while the ticket is unassigned; cleared rather than deleted if the staff account goes away, so the ticket itself survives.']
  source            LoginSource [not null]
  createdAt         "timestamp(3)" [not null, default: `now()`]
  updatedAt         "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    status
    priority
    requester_id
    assignee_id
    updatedAt
  }

  Note: 'A reported problem or request. `reference_number` is the tracking number shown to the requester — sequential and never reused, which is why it is a DB sequence rather than a count of rows.'
}

// ----------------------------------------------------------------------------
Table SupportTicketReply {
  support_ticket_reply_id text [pk, default: `uuid()`, note: 'PK']
  support_ticket_id       text [not null, note: 'FK -> SupportTicket.support_ticket_id']
  author_id               text [null, note: 'FK -> User.user_id | Null once the author\'s account is removed; the thread keeps the message.']
  author_name             text [not null, note: 'Snapshot of the name shown in the thread, so a deleted author still reads right.']
  author_type             SupportTicketAuthorType [not null]
  body                    text [not null]
  createdAt               "timestamp(3)" [not null, default: `now()`]

  indexes {
    (support_ticket_id, createdAt)
  }
}

// ----------------------------------------------------------------------------
Table User {
  user_id text [pk, note: 'PK']

  Note: 'Stub - Defined in module 01 - Identity & Access. Only the key is shown here.'
}

// ----------------------------------------------------------------------------
// Relationships (child.fk  > / -  parent.pk)
// ----------------------------------------------------------------------------
Ref SupportTicketAssignee: SupportTicket.assignee_id > User.user_id  // M:1, optional
Ref SupportTicketRequester: SupportTicket.requester_id > User.user_id [delete: cascade]  // M:1, mandatory
Ref SupportTicketReplyAuthor: SupportTicketReply.author_id > User.user_id  // M:1, optional
Ref: SupportTicketReply.support_ticket_id > SupportTicket.support_ticket_id [delete: cascade]  // M:1, mandatory

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
Enum LoginSource {
  PORTAL
  MOBILE
}

Enum SupportTicketPriority {
  HIGH
  MEDIUM
  LOW
}

Enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  UNDER_VERIFICATION [note: 'Fix is in — waiting for the requester to confirm it works on their side.']
  CLIENT_FEEDBACK [note: 'Blocked on the requester: more detail or a decision is needed from them.']
  RESOLVED
  CLOSED
}

Enum SupportTicketType {
  BUG
  LOGIN
  ACCOUNT
  VERIFICATION
  EVENT
  MOBILE_APP
  FEATURE_REQUEST
  OTHER
  REPORT [note: 'Flagging another user, event, campaign, or content — raised from the app\'s "Report a Problem" flow rather than a help request about the reporter\'s own account.']
}

Enum SupportTicketAuthorType {
  STAFF
  REQUESTER
}
