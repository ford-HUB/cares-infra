@startchen
' CARES - Module 09: Support Tickets (Chen notation)
' Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
' 2 entities + 1 referenced stub entities, 4 relationships
' Paste into https://www.plantuml.com/plantuml or https://www.planttext.com
'
' Legend
'   rectangle = entity          oval = attribute (name : data type)
'   diamond   = relationship    underlined oval = key attribute (PK)
'   double oval = multivalued attribute (array column)
'   1 / N on a line = cardinality of the entity at that end (1:1 or 1:N)
'   double line = total participation (FK is NOT NULL: every row must take part)
'   single line = partial participation (optional)
'   Foreign-key columns are not drawn as ovals - in Chen notation the
'   relationship diamond is what represents them.
'
' Stub entities (key only) come from other modules: User (01)

entity SupportTicket {
  support_ticket_id : TEXT <<key>>
  reference_number : SERIAL
  subject : TEXT
  description : TEXT
  type : SupportTicketType
  status : SupportTicketStatus
  priority : SupportTicketPriority
  source : LoginSource
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity SupportTicketReply {
  support_ticket_reply_id : TEXT <<key>>
  author_name : TEXT
  author_type : SupportTicketAuthorType
  body : TEXT
  createdAt : TIMESTAMP
}

entity User {
  user_id : TEXT <<key>>
}

relationship ASSIGNED_TICKET {
}
ASSIGNED_TICKET -1- User
ASSIGNED_TICKET -N- SupportTicket

relationship FILES_TICKET {
}
FILES_TICKET -1- User
FILES_TICKET =N= SupportTicket

relationship WRITES_REPLY {
}
WRITES_REPLY -1- User
WRITES_REPLY -N- SupportTicketReply

relationship TICKET_HAS_REPLY {
}
TICKET_HAS_REPLY -1- SupportTicket
TICKET_HAS_REPLY =N= SupportTicketReply

@endchen
