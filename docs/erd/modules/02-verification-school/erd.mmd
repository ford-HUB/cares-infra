%% CARES - Module 02: Verification & School Records (Mermaid erDiagram, Crow's Foot)
%% Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
%% 7 tables + 1 referenced stub tables, 7 foreign-key relationships
%% Paste into https://mermaid.live
%% Cardinality symbols:  ||  exactly one   |o  zero or one   o{  zero or many   |{  one or many
%% Parent side: || when the FK is NOT NULL (mandatory), |o when the FK is nullable (optional).
%% Child side:  o{ for 1:M, o| for 1:1 (FK column is UNIQUE).
erDiagram
  User ||--o{ ResidencyDocument : "user"
  Department ||--o{ UserSchoolInfo : "department"
  Major ||--o{ UserSchoolInfo : "major"
  User ||--o{ UserSchoolInfo : "user"
  YearLevel ||--o{ UserSchoolInfo : "year_level"
  UserBiometric |o--o| UserVerification : "user_biometric"
  User ||--o{ UserVerification : "user"

  UserVerification {
    text user_verification_id PK
    text user_id FK
    VerificationStatus status
    timestamp createdAt
    timestamp updatedAt
    text user_biometric_id FK, UK "nullable"
  }
  UserBiometric {
    text user_biometric_id PK
    text face_url
    jsonb embedding "nullable"
    EmbeddingType embedding_type
    boolean isActive
    timestamp createdAt
    timestamp updatedAt
  }
  UserSchoolInfo {
    text user_school_info_id PK
    text id_number UK
    integer graduation_year
    integer graduation_month
    integer graduation_day
    text department_id FK
    text major_id FK
    text year_level_id FK
    text user_id FK
    timestamp createdAt
    timestamp updatedAt
    text school_id_url "nullable"
  }
  Department {
    text department_id PK
    text name
    timestamp createdAt
    timestamp updatedAt
  }
  Major {
    text major_id PK
    text name
    timestamp createdAt
    timestamp updatedAt
  }
  YearLevel {
    text year_level_id PK
    text name
    timestamp createdAt
    timestamp updatedAt
  }
  ResidencyDocument {
    text residency_document_id PK
    text user_id FK
    text file_url
    text file_name
    text mime_type
    integer size_bytes
    text extracted_address
    timestamp createdAt
  }
  User {
    text user_id PK "stub - module 01"
  }
