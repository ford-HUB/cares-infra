// CARES - Module 02: Verification & School Records (DBML, Crow's Foot)
// Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
// 7 tables + 1 referenced stub tables, 7 foreign-key relationships
//
// Paste into https://dbdiagram.io (renders Crow's Foot notation).
// Ref operators:  >  many-to-one (M:1)   <  one-to-many (1:M)   -  one-to-one (1:1)
// Optionality: a nullable FK column ("null") = optional participation of the child
// (zero-or-one parent); "not null" FK = mandatory (exactly one parent).

Project CARES {
  database_type: 'PostgreSQL'
  Note: 'CARES platform database - Module 02: Verification & School Records. Generated from the Prisma schema.'
}

// ----------------------------------------------------------------------------
Table UserVerification {
  user_verification_id text [pk, default: `uuid()`, note: 'PK']
  user_id              text [not null, note: 'FK -> User.user_id']
  status               VerificationStatus [not null, default: 'N']
  createdAt            "timestamp(3)" [not null, default: `now()`]
  updatedAt            "timestamp(3)" [not null, note: 'auto-updated on write']
  user_biometric_id    text [unique, null, note: 'FK -> UserBiometric.user_biometric_id']

  Note: 'One ID check per submission. The biometric enrolled for that check hangs off the verification rather than the user, so a face scan is always tied to the review it was captured for.'
}

// ----------------------------------------------------------------------------
Table UserBiometric {
  user_biometric_id text [pk, default: `uuid()`, note: 'PK']
  face_url          text [not null]
  embedding         jsonb [null]
  embedding_type    EmbeddingType [not null, default: 'FACE']
  isActive          boolean [not null, default: true]
  createdAt         "timestamp(3)" [not null, default: `now()`]
  updatedAt         "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table UserSchoolInfo {
  user_school_info_id text [pk, default: `uuid()`, note: 'PK']
  id_number           text [unique, not null]
  graduation_year     integer [not null]
  graduation_month    integer [not null]
  graduation_day      integer [not null]
  department_id       text [not null, note: 'FK -> Department.department_id']
  major_id            text [not null, note: 'FK -> Major.major_id']
  year_level_id       text [not null, note: 'FK -> YearLevel.year_level_id']
  user_id             text [not null, note: 'FK -> User.user_id']
  createdAt           "timestamp(3)" [not null, default: `now()`]
  updatedAt           "timestamp(3)" [not null, note: 'auto-updated on write']
  school_id_url       text [null, note: 'Scan of the school ID presented at registration; absent for ID-less roles.']
}

// ----------------------------------------------------------------------------
Table Department {
  department_id text [pk, default: `uuid()`, note: 'PK']
  name          text [not null]
  createdAt     "timestamp(3)" [not null, default: `now()`]
  updatedAt     "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table Major {
  major_id  text [pk, default: `uuid()`, note: 'PK']
  name      text [not null]
  createdAt "timestamp(3)" [not null, default: `now()`]
  updatedAt "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table YearLevel {
  year_level_id text [pk, default: `uuid()`, note: 'PK']
  name          text [not null]
  createdAt     "timestamp(3)" [not null, default: `now()`]
  updatedAt     "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table ResidencyDocument {
  residency_document_id text [pk, default: `uuid()`, note: 'PK']
  user_id               text [not null, note: 'FK -> User.user_id']
  file_url              text [not null]
  file_name             text [not null]
  mime_type             text [not null]
  size_bytes            integer [not null]
  extracted_address     text [not null, note: 'What OCR read off the document — the address it set at the time.']
  createdAt             "timestamp(3)" [not null, default: `now()`]

  indexes {
    (user_id, createdAt)
  }

  Note: 'Proof of residency (barangay certificate, clearance) a mobile user uploaded to change their address. The address itself is read off the file by OCR and written to `User.current_address`; the file stays on record here.'
}

// ----------------------------------------------------------------------------
Table User {
  user_id text [pk, note: 'PK']

  Note: 'Stub - Defined in module 01 - Identity & Access. Only the key is shown here.'
}

// ----------------------------------------------------------------------------
// Relationships (child.fk  > / -  parent.pk)
// ----------------------------------------------------------------------------
Ref: ResidencyDocument.user_id > User.user_id [delete: cascade]  // M:1, mandatory
Ref: UserSchoolInfo.department_id > Department.department_id  // M:1, mandatory
Ref: UserSchoolInfo.major_id > Major.major_id  // M:1, mandatory
Ref: UserSchoolInfo.user_id > User.user_id  // M:1, mandatory
Ref: UserSchoolInfo.year_level_id > YearLevel.year_level_id  // M:1, mandatory
Ref: UserVerification.user_biometric_id - UserBiometric.user_biometric_id  // 1:1, optional
Ref: UserVerification.user_id > User.user_id  // M:1, mandatory

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
Enum VerificationStatus {
  N
  F
  V
}

Enum EmbeddingType {
  FACE
  FINGERPRINT
  IRIS
}
