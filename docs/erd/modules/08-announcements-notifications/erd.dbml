// CARES - Module 08: Announcements & Notifications (DBML, Crow's Foot)
// Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
// 2 tables + 1 referenced stub tables, 2 foreign-key relationships
//
// Paste into https://dbdiagram.io (renders Crow's Foot notation).
// Ref operators:  >  many-to-one (M:1)   <  one-to-many (1:M)   -  one-to-one (1:1)
// Optionality: a nullable FK column ("null") = optional participation of the child
// (zero-or-one parent); "not null" FK = mandatory (exactly one parent).

Project CARES {
  database_type: 'PostgreSQL'
  Note: 'CARES platform database - Module 08: Announcements & Notifications. Generated from the Prisma schema.'
}

// ----------------------------------------------------------------------------
Table Announcement {
  announcement_id text [pk, default: `uuid()`, note: 'PK']
  title           text [not null]
  body            text [not null]
  tone            AnnouncementTone [not null, default: 'INFO']
  audiences       "AnnouncementAudience[]" [not null, default: `'{}'`]
  channels        "AnnouncementChannel[]" [not null, default: `'{}'`]
  state           AnnouncementState [not null, default: 'DRAFT']
  publish_at      "timestamp(3)" [not null]
  expires_at      "timestamp(3)" [null, note: 'Null means it stays up until taken down by hand.']
  pinned          boolean [not null, default: false]
  window_id       text [null, note: 'The maintenance window this notice was written for; windows are not persisted yet, so this is a loose reference rather than a relation.']
  author_id       text [null, note: 'FK -> User.user_id']
  author_name     text [not null, note: 'Snapshot of the author\'s name, so a rename cannot rewrite the board.']
  reach           integer [not null, default: 0, note: 'Accounts it reached when it went out; 0 until it publishes.']
  createdAt       "timestamp(3)" [not null, default: `now()`]
  updatedAt       "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    state
    publish_at
  }

  Note: 'A notice written on the Maintenance board and read back on System Notices. State moves forward on its own once a scheduled `publish_at` or `expires_at` passes; the sweep runs on read, so a page that polls sees the flip without a scheduler.'
}

// ----------------------------------------------------------------------------
Table Notification {
  notification_id text [pk, default: `uuid()`, note: 'PK']
  user_id         text [not null, note: 'FK -> User.user_id']
  title           text [not null]
  description     text [not null]
  category        NotificationCategory [not null]
  tone            NotificationTone [not null, default: 'INFO']
  href            text [null, note: 'Portal path the row opens — the screen the notice is about.']
  dedupe_key      text [null, note: 'Set by schedulers so a repeated sweep cannot notify the same thing twice.']
  audience_role   RoleType [null, note: 'Which side of a mobile account the row belongs to (a donor who also volunteers sees donation news only on the Donor side). Null means the row is about the account itself and shows on every side — and on the portal.']
  read_at         "timestamp(3)" [null]
  dismissed_at    "timestamp(3)" [null]
  createdAt       "timestamp(3)" [not null, default: `now()`]

  indexes {
    (dedupe_key, user_id) [unique]
    (user_id, dismissed_at, createdAt)
  }

  Note: 'One row per recipient. A notice addressed to a role is fanned out to every account holding that role at publish time, so read and dismissed state are per person and a later hire does not inherit a backlog.'
}

// ----------------------------------------------------------------------------
Table User {
  user_id text [pk, note: 'PK']

  Note: 'Stub - Defined in module 01 - Identity & Access. Only the key is shown here.'
}

// ----------------------------------------------------------------------------
// Relationships (child.fk  > / -  parent.pk)
// ----------------------------------------------------------------------------
Ref AnnouncementAuthor: Announcement.author_id > User.user_id  // M:1, optional
Ref UserNotifications: Notification.user_id > User.user_id [delete: cascade]  // M:1, mandatory

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
Enum RoleType {
  ADMIN
  DIRECTOR
  COORDINATOR
  VOLUNTEER
  DONOR
  BENEFICIARY
}

Enum AnnouncementTone {
  INFO
  WARNING
  CRITICAL
}

Enum AnnouncementAudience {
  VOLUNTEERS
  BENEFICIARIES
  DONORS
  COORDINATORS
}

Enum AnnouncementChannel {
  PORTAL
  MOBILE
  EMAIL
}

Enum AnnouncementState {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
}

Enum NotificationCategory {
  EVENT
  REPORT
  ACCESS
  SYSTEM
  VOLUNTEER
  CERTIFICATE
  DONATION
  USER_REQUEST
  SECURITY
  SUPPORT
  MAIL
}

Enum NotificationTone {
  INFO
  ATTENTION
  CRITICAL
}
