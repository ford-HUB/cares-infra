// CARES - Module 04: Events, Attendance & Engagement (DBML, Crow's Foot)
// Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
// 6 tables + 1 referenced stub tables, 5 foreign-key relationships
//
// Paste into https://dbdiagram.io (renders Crow's Foot notation).
// Ref operators:  >  many-to-one (M:1)   <  one-to-many (1:M)   -  one-to-one (1:1)
// Optionality: a nullable FK column ("null") = optional participation of the child
// (zero-or-one parent); "not null" FK = mandatory (exactly one parent).
//
// Many-to-many (M:N) relationships are resolved through associative tables:
//   Event  M:N  User   via EventAttendance

Project CARES {
  database_type: 'PostgreSQL'
  Note: 'CARES platform database - Module 04: Events, Attendance & Engagement. Generated from the Prisma schema.'
}

// ----------------------------------------------------------------------------
Table Event {
  event_id               integer [pk, increment, note: 'PK']
  title                  text [not null]
  description            text [not null]
  event_started          "timestamp(3)" [not null]
  event_ended            "timestamp(3)" [not null]
  location               text [not null]
  max_participants       integer [not null]
  participants           integer [not null, default: 0]
  organizer_name         text [not null]
  category               text [not null]
  department             text [null]
  specified_category     text [null]
  images                 "text[]" [not null, default: `'{}'`]
  status                 EventStatus [not null, default: 'Upcoming']
  funds_donation         boolean [not null, default: false]
  goods_donation         boolean [not null, default: false]
  goods_types            "text[]" [not null, default: `'{}'`]
  beneficiary_applicable boolean [not null, default: false]
  max_beneficiaries      integer [null]
  geojson                jsonb [null]
  area_sqm               float8 [null]
  createdAt              "timestamp(3)" [not null, default: `now()`]
  updatedAt              "timestamp(3)" [not null, note: 'auto-updated on write']
  marker_lat             float8 [null, note: 'Pin the operator dropped inside the geofence — the exact meeting spot.']
  marker_lng             float8 [null]
}

// ----------------------------------------------------------------------------
Table EventAttendance {
  event_attendance_id text [pk, default: `uuid()`, note: 'PK']
  event_id            integer [not null, note: 'FK -> Event.event_id']
  user_id             text [not null, note: 'FK -> User.user_id']
  status              AttendanceStatus [not null, default: 'PENDING']
  validation_method   GeoValidationMethod [null]
  first_ping_at       "timestamp(3)" [null, note: 'First reading inside the event geofence.']
  last_ping_at        "timestamp(3)" [null, note: 'Last reading inside the event geofence.']
  hours_rendered      float8 [null, note: 'Credited service hours; only meaningful once the row is COMPLETED.']
  participation_role  EventParticipationRole [not null, default: 'REGULAR', note: 'The role the volunteer registered for. REGULAR needs no review; the others file an EVENT_ROLE user request a director or coordinator rules on.']
  role_approval       EventRoleApproval [not null, default: 'APPROVED', note: 'Where that role stands. A REJECTED role keeps the registration — the volunteer simply takes part as a regular volunteer.']
  remarks             text [null]
  registered_at       "timestamp(3)" [not null, default: `now()`]
  createdAt           "timestamp(3)" [not null, default: `now()`]
  updatedAt           "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (event_id, user_id) [unique]
    event_id
    user_id
  }

  Note: 'One volunteer\'s registration for one event, plus whatever validation has ruled so far. The row is created on registration and stays PENDING until the coordinates are in and judged: before the event, while it runs, and after it for as long as an offline device still has not pushed.'
}

// ----------------------------------------------------------------------------
Table EventLocationPing {
  event_location_ping_id integer [pk, increment, note: 'PK']
  event_id               integer [null, note: 'FK -> Event.event_id']
  user_id                text [not null, note: 'FK -> User.user_id']
  captured_at            "timestamp(3)" [not null]
  latitude               float8 [not null]
  longitude              float8 [not null]
  accuracy_m             float8 [not null]
  in_area                boolean [not null, note: 'The device\'s own inside-the-geofence check at capture time.']
  source                 GeoValidationMethod [not null]
  createdAt              "timestamp(3)" [not null, default: `now()`]

  indexes {
    (event_id, user_id, captured_at)
    (user_id, captured_at)
  }

  Note: 'One GPS reading from a volunteer\'s device, one per second while their recorder is on. Live readings arrive one at a time (GEOFENCE); readings buffered offline arrive later as a CSV batch (OFFLINE_SYNC). `event_id` is the device\'s best guess and is null when it could not name a joined event — the validation service re-assigns rows from the coordinates, so nothing here is authoritative about attendance.'
}

// ----------------------------------------------------------------------------
Table Interest {
  interest_id text [pk, default: `uuid()`, note: 'PK']
  code        InterestCode [unique, not null]
  label       text [not null]
  description text [null]
  is_active   boolean [not null, default: true]
  sort_order  integer [not null, default: 0]
  createdAt   "timestamp(3)" [not null, default: `now()`]
  updatedAt   "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table UserInterest {
  user_interest_id text [pk, default: `uuid()`, note: 'PK']
  user_id          text [unique, not null, note: 'FK -> User.user_id']
  selected         jsonb [not null]
  other_interest   text [null, note: 'What the volunteer typed under "Others"; null unless OTHERS is selected.']
  createdAt        "timestamp(3)" [not null, default: `now()`]
  updatedAt        "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table RankingSettings {
  ranking_settings_id       text [pk, default: `uuid()`, note: 'PK']
  points_per_attendance     integer [not null, default: 10, note: 'Points a volunteer earns for every event they attended (COMPLETED).']
  absence_penalty_step      integer [not null, default: 2, note: 'First missed registration costs this much; each straight miss adds it again.']
  absence_reset_days        integer [not null, default: 7, note: 'Misses further apart than this restart the penalty at the first step.']
  default_period            text [not null, default: 'month']
  tiers                     jsonb [not null]
  createdAt                 "timestamp(3)" [not null, default: `now()`]
  updatedAt                 "timestamp(3)" [not null, note: 'auto-updated on write']
  donor_pesos_per_point     integer [not null, default: 100, note: 'Donor board: one point for every this many pesos of confirmed donations.']
  goods_type_values         jsonb [null, note: 'Peso value credited per unit of each goods type (`food`, `clothing`, …) when a goods donation is scored; null falls back to the shipped defaults.']
  participation_role_points jsonb [null, note: 'Extra points per attended event for an approved special role (`ORGANIZER`, `FACILITATOR`, `SPEAKER`), on top of `points_per_attendance`; null falls back to the shipped defaults.']

  Note: 'How the volunteer leaderboard is scored and how its tier ladder is cut. One row: the portal\'s Rankings → Customization edits it, the volunteer app reads the tiers to draw its avatar frames. `tiers` is the JSON the customization form edits (see the rankings validators) so a new frame design never needs a migration.'
}

// ----------------------------------------------------------------------------
Table User {
  user_id text [pk, note: 'PK']

  Note: 'Stub - Defined in module 01 - Identity & Access. Only the key is shown here.'
}

// ----------------------------------------------------------------------------
// Relationships (child.fk  > / -  parent.pk)
// ----------------------------------------------------------------------------
Ref: UserInterest.user_id - User.user_id [delete: cascade]  // 1:1, mandatory
Ref: EventAttendance.event_id > Event.event_id [delete: cascade]  // M:1, mandatory
Ref: EventAttendance.user_id > User.user_id [delete: cascade]  // M:1, mandatory
Ref: EventLocationPing.event_id > Event.event_id  // M:1, optional
Ref: EventLocationPing.user_id > User.user_id [delete: cascade]  // M:1, mandatory

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
Enum InterestCode {
  ACADEMIC_ACTIVITIES
  DONATION_DRIVES
  ENVIRONMENT
  SCHOOL
  COMMUNITY
  EMERGENCY
  DONATION_DRIVE
  CHARITY
  RELIEF_PROGRAM
  HEALTH
  OUTREACH
  TRAINING
  SEMINAR
  OTHERS
}

Enum EventStatus {
  Upcoming
  Ongoing
  Completed
  Cancelled
}

Enum AttendanceStatus {
  PENDING
  COMPLETED
  ABSENT
}

Enum EventParticipationRole {
  REGULAR
  ORGANIZER
  FACILITATOR
  SPEAKER
}

Enum EventRoleApproval {
  APPROVED
  PENDING
  REJECTED
}

Enum GeoValidationMethod {
  GEOFENCE
  OFFLINE_SYNC
  AWAITING_SYNC
  MANUAL
}
