@startchen
' CARES - Module 04: Events, Attendance & Engagement (Chen notation)
' Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
' 6 entities + 1 referenced stub entities, 5 relationships
' Paste into https://www.plantuml.com/plantuml or https://www.planttext.com
'
' Legend
'   rectangle = entity          oval = attribute (name : data type)
'   diamond   = relationship    underlined oval = key attribute (PK)
'   double oval = multivalued attribute (array column)
'   1 / N on a line = cardinality of the entity at that end (1:1 or 1:N)
'   double line = total participation (FK is NOT NULL: every row must take part)
'   single line = partial participation (optional)
'   Foreign-key columns are not drawn as ovals - in Chen notation the
'   relationship diamond is what represents them.
'
' M:N relationships are resolved through associative entities:
'   Event M:N User via EventAttendance
'
' Stub entities (key only) come from other modules: User (01)

entity Event {
  event_id : SERIAL <<key>>
  title : TEXT
  description : TEXT
  event_started : TIMESTAMP
  event_ended : TIMESTAMP
  location : TEXT
  max_participants : INTEGER
  participants : INTEGER
  organizer_name : TEXT
  category : TEXT
  department : TEXT
  specified_category : TEXT
  images : TEXT <<multi>>
  status : EventStatus
  funds_donation : BOOLEAN
  goods_donation : BOOLEAN
  goods_types : TEXT <<multi>>
  beneficiary_applicable : BOOLEAN
  max_beneficiaries : INTEGER
  geojson : JSONB
  area_sqm : FLOAT
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
  marker_lat : FLOAT
  marker_lng : FLOAT
}

entity EventAttendance {
  event_attendance_id : TEXT <<key>>
  status : AttendanceStatus
  validation_method : GeoValidationMethod
  first_ping_at : TIMESTAMP
  last_ping_at : TIMESTAMP
  hours_rendered : FLOAT
  participation_role : EventParticipationRole
  role_approval : EventRoleApproval
  remarks : TEXT
  registered_at : TIMESTAMP
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity EventLocationPing {
  event_location_ping_id : SERIAL <<key>>
  captured_at : TIMESTAMP
  latitude : FLOAT
  longitude : FLOAT
  accuracy_m : FLOAT
  in_area : BOOLEAN
  source : GeoValidationMethod
  createdAt : TIMESTAMP
}

entity Interest {
  interest_id : TEXT <<key>>
  code : InterestCode
  label : TEXT
  description : TEXT
  is_active : BOOLEAN
  sort_order : INTEGER
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity UserInterest {
  user_interest_id : TEXT <<key>>
  selected : JSONB
  other_interest : TEXT
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity RankingSettings {
  ranking_settings_id : TEXT <<key>>
  points_per_attendance : INTEGER
  absence_penalty_step : INTEGER
  absence_reset_days : INTEGER
  default_period : TEXT
  tiers : JSONB
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
  donor_pesos_per_point : INTEGER
  goods_type_values : JSONB
  participation_role_points : JSONB
}

entity User {
  user_id : TEXT <<key>>
}

relationship SELECTS_INTERESTS {
}
SELECTS_INTERESTS -1- User
SELECTS_INTERESTS =1= UserInterest

relationship EVENT_HAS_ATTENDANCE {
}
EVENT_HAS_ATTENDANCE -1- Event
EVENT_HAS_ATTENDANCE =N= EventAttendance

relationship REGISTERS_ATTENDANCE {
}
REGISTERS_ATTENDANCE -1- User
REGISTERS_ATTENDANCE =N= EventAttendance

relationship EVENT_RECEIVES_PING {
}
EVENT_RECEIVES_PING -1- Event
EVENT_RECEIVES_PING -N- EventLocationPing

relationship SENDS_LOCATION_PING {
}
SENDS_LOCATION_PING -1- User
SENDS_LOCATION_PING =N= EventLocationPing

@endchen
