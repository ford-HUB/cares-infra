@startchen
' CARES - Module 13: Donations & Payments (Chen notation)
' Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
' 6 entities + 2 referenced stub entities, 8 relationships
' Paste into https://www.plantuml.com/plantuml or https://www.planttext.com
'
' Legend
'   rectangle = entity          oval = attribute (name : data type)
'   diamond   = relationship    underlined oval = key attribute (PK)
'   double oval = multivalued attribute (array column)
'   1 / N on a line = cardinality of the entity at that end (1:1 or 1:N)
'   double line = total participation (FK is NOT NULL: every row must take part)
'   single line = partial participation (optional)
'   Foreign-key columns are not drawn as ovals - in Chen notation the
'   relationship diamond is what represents them.
'
' Stub entities (key only) come from other modules: User (01), Event (04)

entity Donation {
  donation_id : TEXT <<key>>
  sequence : SERIAL
  kind : DonationKind
  status : DonationStatus
  amount : INTEGER
  goods_type : TEXT
  goods_item : TEXT
  goods_quantity : INTEGER
  donor_contact : TEXT
  delivery_date : TIMESTAMP
  confirmed_at : TIMESTAMP
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity DonationTrailEntry {
  donation_trail_entry_id : TEXT <<key>>
  status : DonationStatus
  note : TEXT
  actor_label : TEXT
  notified_email : TEXT
  createdAt : TIMESTAMP
}

entity DonationPayment {
  donation_payment_id : TEXT <<key>>
  campaign_id : TEXT
  campaign_title : TEXT
  amount : INTEGER
  currency : TEXT
  method : DonationPaymentMethod
  status : DonationPaymentStatus
  idempotency_key : TEXT
  gateway_reference : TEXT
  gateway_resource_id : TEXT
  payment_reference : TEXT
  payment_channel : TEXT
  checkout_url : TEXT
  qr_string : TEXT
  expires_at : TIMESTAMP
  paid_at : TIMESTAMP
  failure_reason : TEXT
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity PaymentWebhookEvent {
  webhook_id : TEXT <<key>>
  event : TEXT
  gateway_reference : TEXT
  payload : JSONB
  receivedAt : TIMESTAMP
}

entity PaymentGatewaySettings {
  payment_gateway_settings_id : TEXT <<key>>
  singleton : BOOLEAN
  mode : PaymentGatewayMode
  enabled : BOOLEAN
  secret_key_cipher : TEXT
  secret_key_last4 : TEXT
  webhook_token_cipher : TEXT
  api_url : TEXT
  statement_name : TEXT
  support_email : TEXT
  support_contact : TEXT
  verified_at : TIMESTAMP
  verification_error : TEXT
  updated_by_user_id : TEXT
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity PaymentMethodSetting {
  payment_method_setting_id : TEXT <<key>>
  method : DonationPaymentMethod
  enabled : BOOLEAN
  display_name : TEXT
  instructions : TEXT
  account_name : TEXT
  account_number : TEXT
  channel_codes : TEXT <<multi>>
  min_amount : INTEGER
  max_amount : INTEGER
  sort_order : INTEGER
  verification : PaymentMethodVerification
  verified_at : TIMESTAMP
  verification_message : TEXT
  verified_channel_codes : TEXT <<multi>>
  callbacks_registered_at : TIMESTAMP
  account_proof : PaymentAccountProof
  account_proof_amount : INTEGER
  account_proof_reference : TEXT
  account_proof_id : TEXT
  account_proof_sent_at : TIMESTAMP
  account_proof_attempts : INTEGER
  account_proof_message : TEXT
  account_proof_target : TEXT
  account_verified_at : TIMESTAMP
  createdAt : TIMESTAMP
  updatedAt : TIMESTAMP
}

entity User {
  user_id : TEXT <<key>>
}

entity Event {
  event_id : SERIAL <<key>>
}

relationship EVENT_RECEIVES_DONATION {
}
EVENT_RECEIVES_DONATION -1- Event
EVENT_RECEIVES_DONATION =N= Donation

relationship SETTLED_BY {
}
SETTLED_BY -1- DonationPayment
SETTLED_BY -1- Donation

relationship MAKES_DONATION {
}
MAKES_DONATION -1- User
MAKES_DONATION =N= Donation

relationship ACTS_ON_DONATION {
}
ACTS_ON_DONATION -1- User
ACTS_ON_DONATION -N- DonationTrailEntry

relationship DONATION_HAS_TRAIL {
}
DONATION_HAS_TRAIL -1- Donation
DONATION_HAS_TRAIL =N= DonationTrailEntry

relationship STARTS_PAYMENT {
}
STARTS_PAYMENT -1- User
STARTS_PAYMENT =N= DonationPayment

relationship EVENT_FUNDS_PAYMENT {
}
EVENT_FUNDS_PAYMENT -1- Event
EVENT_FUNDS_PAYMENT -N- DonationPayment

relationship CONFIGURES_METHOD {
}
CONFIGURES_METHOD -1- PaymentGatewaySettings
CONFIGURES_METHOD =N= PaymentMethodSetting

@endchen
