%% CARES - Module 13: Donations & Payments (Mermaid erDiagram, Crow's Foot)
%% Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
%% 6 tables + 2 referenced stub tables, 8 foreign-key relationships
%% Paste into https://mermaid.live
%% Cardinality symbols:  ||  exactly one   |o  zero or one   o{  zero or many   |{  one or many
%% Parent side: || when the FK is NOT NULL (mandatory), |o when the FK is nullable (optional).
%% Child side:  o{ for 1:M, o| for 1:1 (FK column is UNIQUE).
erDiagram
  Event ||--o{ Donation : "event"
  DonationPayment |o--o| Donation : "payment"
  User ||--o{ Donation : "user"
  User |o--o{ DonationTrailEntry : "actor"
  Donation ||--o{ DonationTrailEntry : "donation"
  User ||--o{ DonationPayment : "user"
  Event |o--o{ DonationPayment : "event"
  PaymentGatewaySettings ||--o{ PaymentMethodSetting : "settings"

  Donation {
    text donation_id PK
    serial sequence UK
    text user_id FK
    integer event_id FK
    DonationKind kind
    DonationStatus status
    integer amount
    text payment_id FK, UK "nullable"
    text goods_type "nullable"
    text goods_item "nullable"
    integer goods_quantity "nullable"
    text donor_contact "nullable"
    timestamp delivery_date "nullable"
    timestamp confirmed_at "nullable"
    timestamp createdAt
    timestamp updatedAt
  }
  DonationTrailEntry {
    text donation_trail_entry_id PK
    text donation_id FK
    DonationStatus status
    text note "nullable"
    text actor_id FK "nullable"
    text actor_label
    text notified_email "nullable"
    timestamp createdAt
  }
  DonationPayment {
    text donation_payment_id PK
    text user_id FK
    integer event_id FK "nullable"
    text campaign_id
    text campaign_title
    integer amount
    text currency
    DonationPaymentMethod method
    DonationPaymentStatus status
    text idempotency_key
    text gateway_reference UK
    text gateway_resource_id "nullable"
    text payment_reference "nullable"
    text payment_channel "nullable"
    text checkout_url "nullable"
    text qr_string "nullable"
    timestamp expires_at "nullable"
    timestamp paid_at "nullable"
    text failure_reason "nullable"
    timestamp createdAt
    timestamp updatedAt
  }
  PaymentWebhookEvent {
    text webhook_id PK
    text event
    text gateway_reference "nullable, ref DonationPayment"
    jsonb payload
    timestamp receivedAt
  }
  PaymentGatewaySettings {
    text payment_gateway_settings_id PK
    boolean singleton UK
    PaymentGatewayMode mode
    boolean enabled
    text secret_key_cipher "nullable"
    text secret_key_last4 "nullable"
    text webhook_token_cipher "nullable"
    text api_url "nullable"
    text statement_name "nullable"
    text support_email "nullable"
    text support_contact "nullable"
    timestamp verified_at "nullable"
    text verification_error "nullable"
    text updated_by_user_id "nullable, ref User"
    timestamp createdAt
    timestamp updatedAt
  }
  PaymentMethodSetting {
    text payment_method_setting_id PK
    text settings_id FK
    DonationPaymentMethod method
    boolean enabled
    text display_name "nullable"
    text instructions "nullable"
    text account_name "nullable"
    text account_number "nullable"
    text[] channel_codes
    integer min_amount
    integer max_amount
    integer sort_order
    PaymentMethodVerification verification
    timestamp verified_at "nullable"
    text verification_message "nullable"
    text[] verified_channel_codes
    timestamp callbacks_registered_at "nullable"
    PaymentAccountProof account_proof
    integer account_proof_amount "nullable"
    text account_proof_reference "nullable"
    text account_proof_id "nullable"
    timestamp account_proof_sent_at "nullable"
    integer account_proof_attempts
    text account_proof_message "nullable"
    text account_proof_target "nullable"
    timestamp account_verified_at "nullable"
    timestamp createdAt
    timestamp updatedAt
  }
  User {
    text user_id PK "stub - module 01"
  }
  Event {
    serial event_id PK "stub - module 04"
  }
