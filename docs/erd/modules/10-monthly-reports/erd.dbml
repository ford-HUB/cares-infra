// CARES - Module 10: Monthly Reports (DBML, Crow's Foot)
// Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
// 4 tables + 1 referenced stub tables, 6 foreign-key relationships
//
// Paste into https://dbdiagram.io (renders Crow's Foot notation).
// Ref operators:  >  many-to-one (M:1)   <  one-to-many (1:M)   -  one-to-one (1:1)
// Optionality: a nullable FK column ("null") = optional participation of the child
// (zero-or-one parent); "not null" FK = mandatory (exactly one parent).

Project CARES {
  database_type: 'PostgreSQL'
  Note: 'CARES platform database - Module 10: Monthly Reports. Generated from the Prisma schema.'
}

// ----------------------------------------------------------------------------
Table MonthlyReportFolder {
  monthly_report_folder_id text [pk, default: `uuid()`, note: 'PK']
  name                     text [not null]
  created_by_user_id       text [null, note: 'FK -> User.user_id | Null once the creating account is removed; the folder keeps the name below.']
  created_by_name          text [not null, default: '']
  createdAt                "timestamp(3)" [not null, default: `now()`]
  updatedAt                "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    createdAt
  }

  Note: 'A named tray the director builds on top of the automatic filing — an accreditation packet, a set pulled for a board meeting. College folders are *not* rows: they are derived from each report\'s `department`, so every approved report has a home before anyone files it anywhere, and deleting a folder only drops it back to its college.'
}

// ----------------------------------------------------------------------------
Table MonthlyReport {
  monthly_report_id    text [pk, default: `uuid()`, note: 'PK']
  reference            text [unique, not null, note: 'Tracking number both sides quote, e.g. `MR-2026-014`.']
  title                text [not null]
  period               text [not null, note: 'Reporting month as `YYYY-MM` — the period filter and the grouping key.']
  department           ReportDepartment [not null]
  status               MonthlyReportStatus [not null, default: 'UNDER_REVIEW']
  summary              text [not null]
  metric_events        integer [not null, default: 0]
  metric_volunteers    integer [not null, default: 0]
  metric_service_hours integer [not null, default: 0]
  metric_beneficiaries integer [not null, default: 0]
  submitted_by_user_id text [null, note: 'FK -> User.user_id']
  submitted_by_name    text [not null]
  submitted_by_email   text [not null]
  submitted_by_title   text [not null]
  submitted_at         "timestamp(3)" [not null, default: `now()`]
  reviewer_user_id     text [null, note: 'FK -> User.user_id']
  reviewer_name        text [null, note: 'Snapshot of the deciding director, shown on the row without a join.']
  decided_at           "timestamp(3)" [null]
  decision_note        text [null, note: 'Latest decision note — the only thing a returned report gives the coordinator.']
  folder_id            text [null, note: 'FK -> MonthlyReportFolder.monthly_report_folder_id | The director\'s tray this sits in. Null means it is filed under its college.']
  createdAt            "timestamp(3)" [not null, default: `now()`]
  updatedAt            "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    status
    period
    department
    folder_id
    updatedAt
  }

  Note: 'One coordinator submission for one reporting month. The submitter\'s name, email and post are snapshotted beside the account: a report already decided on must keep reading the way it read on the day, even if the coordinator is renamed or moves college.'
}

// ----------------------------------------------------------------------------
Table MonthlyReportDocument {
  monthly_report_document_id text [pk, default: `uuid()`, note: 'PK']
  monthly_report_id          text [not null, note: 'FK -> MonthlyReport.monthly_report_id']
  file_name                  text [not null, note: 'File name as the coordinator uploaded it, extension included.']
  kind                       MonthlyReportDocumentKind [not null]
  storage_key                text [not null, note: 'S3 object key, not a URL — the bucket and region are configuration.']
  content_type               text [not null]
  byte_size                  integer [not null]
  createdAt                  "timestamp(3)" [not null, default: `now()`]

  indexes {
    monthly_report_id
  }

  Note: 'A file attached to a submission. The bytes live in the private S3 bucket, so the row holds the object key and the portal reads them back through `GET /v1/monthly-reports/:id/documents/:documentId` — a stored object URL in an `<a href>` would 403.'
}

// ----------------------------------------------------------------------------
Table MonthlyReportTrailEntry {
  monthly_report_trail_entry_id text [pk, default: `uuid()`, note: 'PK']
  monthly_report_id             text [not null, note: 'FK -> MonthlyReport.monthly_report_id']
  action                        MonthlyReportTrailAction [not null]
  actor_name                    text [not null, note: 'Snapshot of the actor\'s name, so a rename cannot rewrite the trail.']
  "note"                        text [null]
  createdAt                     "timestamp(3)" [not null, default: `now()`]

  indexes {
    (monthly_report_id, createdAt)
  }

  Note: 'Append-only history of the submission: who submitted, who decided, and the note that came with it. This is the report\'s own record, kept beside the entry rather than in the global audit log because the coordinator reads it too.'
}

// ----------------------------------------------------------------------------
Table User {
  user_id text [pk, note: 'PK']

  Note: 'Stub - Defined in module 01 - Identity & Access. Only the key is shown here.'
}

// ----------------------------------------------------------------------------
// Relationships (child.fk  > / -  parent.pk)
// ----------------------------------------------------------------------------
Ref MonthlyReportFolderCreator: MonthlyReportFolder.created_by_user_id > User.user_id  // M:1, optional
Ref: MonthlyReport.folder_id > MonthlyReportFolder.monthly_report_folder_id  // M:1, optional
Ref MonthlyReportReviewer: MonthlyReport.reviewer_user_id > User.user_id  // M:1, optional
Ref MonthlyReportSubmitter: MonthlyReport.submitted_by_user_id > User.user_id  // M:1, optional
Ref: MonthlyReportDocument.monthly_report_id > MonthlyReport.monthly_report_id [delete: cascade]  // M:1, mandatory
Ref: MonthlyReportTrailEntry.monthly_report_id > MonthlyReport.monthly_report_id [delete: cascade]  // M:1, mandatory

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
Enum MonthlyReportStatus {
  UNDER_REVIEW
  APPROVED
  RETURNED
}

Enum ReportDepartment {
  CCS
  CBA
  CEA
  CNAHS
  CAS
  CCJE
}

Enum MonthlyReportDocumentKind {
  DOCX
  PDF
  XLSX
  IMAGE
}

Enum MonthlyReportTrailAction {
  SUBMITTED
  APPROVED
  RETURNED
  RESUBMITTED
}
