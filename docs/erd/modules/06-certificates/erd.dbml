// CARES - Module 06: Certificates (DBML, Crow's Foot)
// Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
// 5 tables + 2 referenced stub tables, 10 foreign-key relationships
//
// Paste into https://dbdiagram.io (renders Crow's Foot notation).
// Ref operators:  >  many-to-one (M:1)   <  one-to-many (1:M)   -  one-to-one (1:1)
// Optionality: a nullable FK column ("null") = optional participation of the child
// (zero-or-one parent); "not null" FK = mandatory (exactly one parent).
//
// Many-to-many (M:N) relationships are resolved through associative tables:
//   CertificateTemplate  M:N  User   via CertificateTemplateSignatory
//   CertificateTemplate  M:N  Event   via CertificateDeployment
//   CertificateDeployment  M:N  User   via IssuedCertificate

Project CARES {
  database_type: 'PostgreSQL'
  Note: 'CARES platform database - Module 06: Certificates. Generated from the Prisma schema.'
}

// ----------------------------------------------------------------------------
Table CertificateTemplate {
  certificate_template_id text [pk, default: `uuid()`, note: 'PK']
  reference               text [unique, not null, note: 'Human reference printed on the card, e.g. `CT-2026-014`.']
  name                    text [not null]
  description             text [not null]
  category                CertificateTemplateCategory [not null, default: 'PARTICIPATION']
  status                  CertificateTemplateStatus [not null, default: 'DRAFT']
  orientation             CertificateOrientation [not null, default: 'LANDSCAPE']
  issued                  integer [not null, default: 0, note: 'Certificates already printed from this template.']
  deployed_events         integer [not null, default: 0, note: 'Events currently deploying it.']
  design                  jsonb [not null]
  updated_by_user_id      text [null, note: 'FK -> User.user_id | Null once the editor\'s account is removed; the template keeps the name.']
  updated_by_name         text [not null, default: '', note: 'Snapshot of who last saved it, so a deleted account still reads right on the card.']
  createdAt               "timestamp(3)" [not null, default: `now()`]
  updatedAt               "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    status
    category
    updatedAt
  }

  Note: 'A certificate design a director maintains in the portal. Everything that is pure drawing instruction — accent, frame, per-block position, fonts, sizes, wording, seal and where each imported image sits — lives in `design`, shaped by `CertificateDesignSchema`. It is one document edited as a whole by one screen, so splitting it into columns would buy nothing and cost a migration per control the customizer gains. What is *not* in there is anything another feature has to join on: the signatory accounts and the uploaded files are their own rows.'
}

// ----------------------------------------------------------------------------
Table CertificateTemplateSignatory {
  certificate_template_signatory_id text [pk, default: `uuid()`, note: 'PK']
  certificate_template_id           text [not null, note: 'FK -> CertificateTemplate.certificate_template_id']
  coordinator_user_id               text [not null, note: 'FK -> User.user_id']
  name                              text [not null]
  title                             text [not null]
  department                        text [not null]
  signature_token                   text [not null, default: '{{signature-image}}', note: 'The placeholder the print job swaps for the coordinator\'s stored signature image (`User.signature_url`). The customizer never shows it — a director picks an account, not a token — but it is held per line rather than assumed globally so a line can print without a signature later without a migration.']
  position                          integer [not null, default: 0, note: 'Left-to-right order of the lines on the sheet.']
  createdAt                         "timestamp(3)" [not null, default: `now()`]
  updatedAt                         "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (certificate_template_id, coordinator_user_id) [unique]
    coordinator_user_id
    (certificate_template_id, position)
  }

  Note: 'One printed signature line. The coordinator account is the source of truth for the signature image, so the line stores the account rather than typed text; the printed strings are snapshotted beside it so a later rename or transfer cannot silently reword a template certificates were already issued from.'
}

// ----------------------------------------------------------------------------
Table CertificateTemplateAsset {
  certificate_template_asset_id text [pk, default: `uuid()`, note: 'PK']
  certificate_template_id       text [not null, note: 'FK -> CertificateTemplate.certificate_template_id']
  kind                          CertificateAssetKind [not null]
  storage_key                   text [not null, note: 'S3 object key, not a URL — the bucket and region are configuration.']
  file_name                     text [not null]
  content_type                  text [not null]
  byte_size                     integer [not null]
  createdAt                     "timestamp(3)" [not null, default: `now()`]

  indexes {
    certificate_template_id
  }

  Note: 'A file a director imported onto a sheet. The bytes live in the private S3 bucket, so `design` references the row by id and the portal reads the bytes back through `GET /v1/certificate-templates/:id/assets/:assetId` — an `<img src>` pointed at the stored object URL would render broken.'
}

// ----------------------------------------------------------------------------
Table CertificateDeployment {
  certificate_deployment_id text [pk, default: `uuid()`, note: 'PK']
  reference                 text [unique, not null, note: 'Human reference for the deployment itself, e.g. `DC-2026-014`.']
  certificate_template_id   text [not null, note: 'FK -> CertificateTemplate.certificate_template_id']
  template_name             text [not null, note: 'Snapshot of the template\'s name, category and shape as deployed.']
  category                  CertificateTemplateCategory [not null]
  orientation               CertificateOrientation [not null]
  design                    jsonb [not null, note: 'The frozen sheet: the same shape as `CertificateTemplate.design`, plus the signature lines as they read on the day.']
  event_id                  integer [not null, note: 'FK -> Event.event_id']
  event_name                text [not null, note: 'Snapshot of the event, so the list reads correctly even if the event is renamed.']
  event_venue               text [not null]
  event_date                "timestamp(3)" [not null]
  status                    CertificateDeploymentStatus [not null, default: 'SCHEDULED']
  participants              integer [not null, default: 0, note: 'Participants the deployment covers — the denominator for everything below.']
  distributed               integer [not null, default: 0, note: 'Certificates generated and released to a participant.']
  claimed                   integer [not null, default: 0, note: 'Of those, how many the recipient actually opened.']
  deployed_by_user_id       text [null, note: 'FK -> User.user_id | Null once the deploying account is removed; the row keeps the name.']
  deployed_by_name          text [not null, default: '']
  createdAt                 "timestamp(3)" [not null, default: `now()`]
  updatedAt                 "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (certificate_template_id, event_id) [unique]
    status
    event_id
    createdAt
  }

  Note: 'One template deployed to one event — what the live certificates page lists. The design, the signature lines and the event\'s own details are all frozen into the row at deploy time: the template it came from stays editable, and a certificate already promised to a volunteer must not silently change wording when a director tidies the template up afterwards. The template is still referenced, because the frozen design points at that template\'s stored artwork.'
}

// ----------------------------------------------------------------------------
Table IssuedCertificate {
  issued_certificate_id     text [pk, default: `uuid()`, note: 'PK']
  certificate_number        text [unique, not null, note: 'Printed on the sheet, e.g. `CERT-2026-000123`.']
  certificate_deployment_id text [not null, note: 'FK -> CertificateDeployment.certificate_deployment_id']
  event_id                  integer [not null, note: 'FK -> Event.event_id']
  user_id                   text [not null, note: 'FK -> User.user_id']
  recipient_name            text [not null, note: 'What the placeholders were filled with, as they read on the day of issue.']
  event_name                text [not null]
  event_date                "timestamp(3)" [not null]
  hours_rendered            float8 [not null, default: 0]
  organization              text [not null]
  template_name             text [not null]
  category                  CertificateTemplateCategory [not null]
  orientation               CertificateOrientation [not null]
  design                    jsonb [not null, note: 'The deployment\'s frozen design plus, per signature line, the S3 key of the coordinator\'s signature image at issue time (`StoredIssuedDesign`).']
  issued_at                 "timestamp(3)" [not null, default: `now()`]
  claimed_at                "timestamp(3)" [null, note: 'When the recipient first opened it in the app; null until then.']
  createdAt                 "timestamp(3)" [not null, default: `now()`]
  updatedAt                 "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (certificate_deployment_id, user_id) [unique]
    user_id
    event_id
    issued_at
  }

  Note: 'One certificate the issuing sweep generated for one participant of one deployment. The sheet is frozen here in full — the deployment\'s design with every placeholder filled and each signature line pointing at the image it printed — so what the volunteer holds never changes if the event, the template or a coordinator\'s profile is edited afterwards.'
}

// ----------------------------------------------------------------------------
Table User {
  user_id text [pk, note: 'PK']

  Note: 'Stub - Defined in module 01 - Identity & Access. Only the key is shown here.'
}

// ----------------------------------------------------------------------------
Table Event {
  event_id integer [pk, note: 'PK']

  Note: 'Stub - Defined in module 04 - Events, Attendance & Engagement. Only the key is shown here.'
}

// ----------------------------------------------------------------------------
// Relationships (child.fk  > / -  parent.pk)
// ----------------------------------------------------------------------------
Ref CertificateTemplateEditor: CertificateTemplate.updated_by_user_id > User.user_id  // M:1, optional
Ref: CertificateTemplateSignatory.certificate_template_id > CertificateTemplate.certificate_template_id [delete: cascade]  // M:1, mandatory
Ref: CertificateTemplateSignatory.coordinator_user_id > User.user_id  // M:1, mandatory
Ref: CertificateTemplateAsset.certificate_template_id > CertificateTemplate.certificate_template_id [delete: cascade]  // M:1, mandatory
Ref: CertificateDeployment.certificate_template_id > CertificateTemplate.certificate_template_id  // M:1, mandatory
Ref CertificateDeploymentDeployer: CertificateDeployment.deployed_by_user_id > User.user_id  // M:1, optional
Ref: CertificateDeployment.event_id > Event.event_id  // M:1, mandatory
Ref: IssuedCertificate.certificate_deployment_id > CertificateDeployment.certificate_deployment_id [delete: cascade]  // M:1, mandatory
Ref: IssuedCertificate.event_id > Event.event_id [delete: cascade]  // M:1, mandatory
Ref: IssuedCertificate.user_id > User.user_id [delete: cascade]  // M:1, mandatory

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
Enum CertificateTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

Enum CertificateTemplateCategory {
  PARTICIPATION
  APPRECIATION
  VOLUNTEER_HOURS
  COMPLETION
  SPONSORSHIP
}

Enum CertificateOrientation {
  LANDSCAPE
  PORTRAIT
}

Enum CertificateAssetKind {
  IMAGE
  FRAME
  SEAL
}

Enum CertificateDeploymentStatus {
  SCHEDULED
  DISTRIBUTING
  PAUSED
  COMPLETED
}
