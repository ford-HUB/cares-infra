// CARES - Module 03: Security & Audit (DBML, Crow's Foot)
// Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
// 4 tables + 1 referenced stub tables, 3 foreign-key relationships
//
// Paste into https://dbdiagram.io (renders Crow's Foot notation).
// Ref operators:  >  many-to-one (M:1)   <  one-to-many (1:M)   -  one-to-one (1:1)
// Optionality: a nullable FK column ("null") = optional participation of the child
// (zero-or-one parent); "not null" FK = mandatory (exactly one parent).

Project CARES {
  database_type: 'PostgreSQL'
  Note: 'CARES platform database - Module 03: Security & Audit. Generated from the Prisma schema.'
}

// ----------------------------------------------------------------------------
Table SecurityPolicy {
  security_policy_id           text [pk, default: `uuid()`, note: 'PK']
  singleton                    boolean [unique, not null, default: true]
  password_min_length          integer [not null, default: 8]
  password_require_uppercase   boolean [not null, default: true]
  password_require_lowercase   boolean [not null, default: true]
  password_require_number      boolean [not null, default: true]
  password_require_symbol      boolean [not null, default: false]
  lockout_enabled              boolean [not null, default: true]
  lockout_max_attempts         integer [not null, default: 5]
  lockout_window_minutes       integer [not null, default: 15, note: 'How far back failed attempts are counted, in minutes.']
  lockout_duration_minutes     integer [not null, default: 30, note: 'Minutes a lock is held. 0 means it stays until an administrator lifts it.']
  session_idle_timeout_minutes integer [not null, default: 0, note: 'Minutes of inactivity before a session is refused. 0 disables the check.']
  session_max_duration_hours   integer [not null, default: 0, note: 'Hours a session may live regardless of activity. 0 leaves it to the token\'s own expiry.']
  max_concurrent_sessions      integer [not null, default: 0, note: 'Devices one account may hold at once. 0 means unlimited.']
  login_hours_enabled          boolean [not null, default: false]
  login_hours_start_minute     integer [not null, default: 0, note: 'Minutes past midnight, server time. A start after the end wraps over midnight.']
  login_hours_end_minute       integer [not null, default: 1440]
  ip_allowlist                 "text[]" [not null, default: `'{}'`, note: 'Addresses allowed to sign in. Empty means no allowlist — see BlockedIp for the denylist.']
  updated_by_user_id           text [null, note: 'logical ref -> User.user_id (no FK constraint)']
  createdAt                    "timestamp(3)" [not null, default: `now()`]
  updatedAt                    "timestamp(3)" [not null, note: 'auto-updated on write']

  Note: 'Portal-wide security settings, held as exactly one row: `singleton` is pinned to true and unique, so an upsert can never create a second policy. Every field has a default here that matches the fallback the server applies when the row is missing.'
}

// ----------------------------------------------------------------------------
Table BlockedIp {
  blocked_ip_id      text [pk, default: `uuid()`, note: 'PK']
  ip_address         text [unique, not null]
  reason             text [null]
  user_id            text [null, note: 'FK -> User.user_id | The account the block originated from — null for a manually entered address.']
  blocked_by_user_id text [not null, note: 'logical ref -> User.user_id (no FK constraint)']
  createdAt          "timestamp(3)" [not null, default: `now()`]
  updatedAt          "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table LoginActivity {
  login_activity_id text [pk, default: `uuid()`, note: 'PK']
  user_id           text [null, note: 'FK -> User.user_id | Null when no account matched the submitted email.']
  email             text [not null, note: 'The email exactly as submitted (lowercased), kept even when no account matched.']
  ip_address        text [not null]
  user_agent        text [null]
  source            LoginSource [not null]
  outcome           LoginOutcome [not null]
  failure_reason    text [null, note: 'The message the client was shown; null on a successful sign-in.']
  createdAt         "timestamp(3)" [not null, default: `now()`]

  indexes {
    user_id
    createdAt
    ip_address
    email
  }

  Note: 'One row per sign-in attempt, successful or not. Append-only: nothing updates or deletes a row, so the trail stays reviewable. `user_id` is null when the email matched no account, which is why the typed email is stored alongside it.'
}

// ----------------------------------------------------------------------------
Table AuditLog {
  audit_log_id  text [pk, default: `uuid()`, note: 'PK']
  action        text [not null, note: 'Machine key, e.g. `access-control.permission.revoked` — stable across wording changes.']
  description   text [not null, note: 'The sentence the portal renders in the grid.']
  category      AuditCategory [not null]
  severity      AuditSeverity [not null, default: 'INFO']
  outcome       AuditOutcome [not null, default: 'SUCCESS']
  actor_user_id text [null, note: 'FK -> User.user_id | Null for background jobs, and for actors whose account was later deleted.']
  actor_name    text [not null]
  actor_email   text [not null]
  actor_role    RoleType [null, note: 'Null when the actor is the system rather than an account.']
  target_type   text [not null, note: 'What the action was performed on — `user`, `event`, `certificate`, `system`, …']
  target_label  text [not null]
  target_id     text [null, note: 'Null when the target is not a single record (a route, a role baseline, a service).']
  ip_address    text [not null]
  user_agent    text [null]
  source        AuditSource [not null, default: 'PORTAL']
  request_id    text [null, note: 'Correlates every entry written by one request.']
  reason        text [null, note: 'Operator-supplied justification, when the action asks for one.']
  changes       jsonb [not null, default: `'[]'::jsonb`, note: 'Field-level before/after pairs: `[{ field, before, after }]`.']
  metadata      jsonb [not null, default: `'{}'::jsonb`, note: 'Free-form context — counts, service scores, template names.']
  createdAt     "timestamp(3)" [not null, default: `now()`]

  indexes {
    actor_user_id
    createdAt
    category
    severity
    outcome
    action
  }

  Note: 'One row per privileged action. Append-only: nothing updates or deletes a row, so the trail stays reviewable. The actor\'s name, email, and role are denormalised at write time so a later rename or role change cannot rewrite history.'
}

// ----------------------------------------------------------------------------
Table User {
  user_id text [pk, note: 'PK']

  Note: 'Stub - Defined in module 01 - Identity & Access. Only the key is shown here.'
}

// ----------------------------------------------------------------------------
// Relationships (child.fk  > / -  parent.pk)
// ----------------------------------------------------------------------------
Ref: BlockedIp.user_id > User.user_id  // M:1, optional
Ref: LoginActivity.user_id > User.user_id  // M:1, optional
Ref: AuditLog.actor_user_id > User.user_id [delete: set null]  // M:1, optional

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
Enum RoleType {
  ADMIN
  DIRECTOR
  COORDINATOR
  VOLUNTEER
  DONOR
  BENEFICIARY
}

Enum LoginOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  BLOCKED_IP
  RESTRICTED_ACCOUNT
  ROLE_NOT_ALLOWED
  LOCKED_OUT [note: 'Refused by a SecurityPolicy rule rather than by the credentials themselves.']
  OUTSIDE_LOGIN_HOURS
  IP_NOT_ALLOWED
  CREDENTIAL_EXPIRED [note: 'The temporary credential an administrator issued has passed its expiry.']
  EMAIL_NOT_VERIFIED [note: 'The password matched but the email was never proven with the sign-up OTP.']
}

Enum LoginSource {
  PORTAL
  MOBILE
}

Enum AuditCategory {
  AUTHENTICATION
  ACCESS_CONTROL
  USER_MANAGEMENT
  VERIFICATION
  EVENT
  CERTIFICATE
  COMMUNICATION
  SYSTEM
}

Enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

Enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

Enum AuditSource {
  PORTAL
  MOBILE
  SYSTEM
}
