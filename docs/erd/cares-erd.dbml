  ALUMNI_REGISTRATION
  PARTNER_BARANGAY_REGISTRATION
  MANUAL_REGISTRATION [note: 'A staff or alumni sign-up whose ID photo the app could not recognize: the registrant chose manual registration, so the ID skipped the automatic checks and the face scan, and a director verifies it by hand.']
}

Enum BeneficiaryType {
  REGULAR
  STUDENT
}

Enum UserRequestStatus {
  PENDING
  ACCEPTED
  DELETED
  REJECTED
}

Enum AssistanceCategory {
  FOOD
  MEDICAL
  EDUCATION
  FINANCIAL
  LIVELIHOOD
  DISASTER_RELIEF
}

Enum AssistanceUrgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

Enum AssistanceRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  COMPLETED
  DECLINED
  CANCELLED [note: 'Withdrawn by the beneficiary before it was completed.']
}

Enum AssistanceAssessmentStatus {
  NOT_STARTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

Enum DonationPaymentMethod {
  GCASH
  QRPH
  CARD
  BANK_TRANSFER
}

Enum DonationPaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

Enum PaymentGatewayMode {
  TEST
  LIVE
}

Enum PaymentMethodVerification {
  NOT_VERIFIED [note: 'Never checked — the director has not switched it on yet.']
  PENDING [note: 'Asked for, but the gateway could not answer yet (no account connected).']
  VERIFIED [note: 'Xendit reports the channel activated and the callbacks registered.']
  FAILED [note: 'The gateway answered and refused it; `verification_message` says why.']
}

Enum PaymentAccountProof {
  NOT_STARTED [note: 'No payout sent yet.']
  SENDING [note: 'The payout is with the gateway, not yet reported as received.']
  AWAITING_CONFIRMATION [note: 'Money is on its way; waiting for the director to report the amount.']
  VERIFIED [note: 'The director reported the right amount — the account is theirs to reach.']
  FAILED [note: 'The payout was refused, or the amount was reported wrong too many times.']
}

Enum DonationKind {
  MONEY
  GOODS
}

Enum DonationStatus {
  PLEDGED
  AWAITING_PICKUP
  VERIFYING
  CONFIRMED
  DECLINED
  CANCELLED
}
