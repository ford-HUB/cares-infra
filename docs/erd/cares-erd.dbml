// CARES - Entity Relationship Diagram (DBML, Crow's Foot)
// Source: server/src/infastructures/prisma/schema.prisma (PostgreSQL)
// 57 tables, 70 foreign-key relationships
//
// Paste into https://dbdiagram.io (renders Crow's Foot notation).
// Ref operators:  >  many-to-one (M:1)   <  one-to-many (1:M)   -  one-to-one (1:1)
// Optionality: a nullable FK column ("null") = optional participation of the child
// (zero-or-one parent); "not null" FK = mandatory (exactly one parent).
//
// Many-to-many (M:N) relationships are resolved through associative tables:
//   Event  M:N  User   via EventAttendance
//   Conversation  M:N  User   via ConversationParticipant
//   CertificateTemplate  M:N  User   via CertificateTemplateSignatory
//   CertificateTemplate  M:N  Event   via CertificateDeployment
//   CertificateDeployment  M:N  User   via IssuedCertificate
//   Event  M:N  User   via EvaluationResponse

Project CARES {
  database_type: 'PostgreSQL'
  Note: 'CARES platform database - Entity Relationship Diagram. Generated from the Prisma schema.'
}

// ----------------------------------------------------------------------------
Table User {
  user_id           text [pk, default: `uuid()`, note: 'PK']
  firstname         text [not null]
  lastname          text [not null]
  middle_name       text [null]
  gender            GenderType [not null, default: 'OTHER']
  age               integer [not null, default: 0]
  current_address   text [not null]
  phone_number      text [unique, not null]
  avatar            text [null]
  role_id           text [not null, note: 'FK -> Role.role_id']
  createdAt         "timestamp(3)" [not null, default: `now()`]
  updatedAt         "timestamp(3)" [not null, note: 'auto-updated on write']
  portal_department text [null]
  address_street    text [null]
  address_barangay  text [null]
  address_city      text [null]
  address_province  text [null]
  household_size    integer [null, note: 'Beneficiaries only — how many people the assistance has to cover.']
  partner_barangay  text [null, note: 'Partner-barangay volunteers only — the partner barangay they signed up through (one of PARTNER_BARANGAYS in the auth module).']
  beneficiary_type  BeneficiaryType [null, note: 'Beneficiaries only: REGULAR signed up without an ID; STUDENT verified a UC school ID with a face match, which also opens their Volunteer side.']
}

// ----------------------------------------------------------------------------
Table ResidencyDocument {
  residency_document_id text [pk, default: `uuid()`, note: 'PK']
  user_id               text [not null, note: 'FK -> User.user_id']
  file_url              text [not null]
  file_name             text [not null]
  mime_type             text [not null]
  size_bytes            integer [not null]
  extracted_address     text [not null, note: 'What OCR read off the document — the address it set at the time.']
  createdAt             "timestamp(3)" [not null, default: `now()`]

  indexes {
    (user_id, createdAt)
  }

  Note: 'Proof of residency (barangay certificate, clearance) a mobile user uploaded to change their address. The address itself is read off the file by OCR and written to `User.current_address`; the file stays on record here.'
}

// ----------------------------------------------------------------------------
Table UserRoleAvatar {
  user_role_avatar_id text [pk, default: `uuid()`, note: 'PK']
  user_id             text [not null, note: 'FK -> User.user_id']
  role_type           RoleType [not null]
  avatar_url          text [not null]
  createdAt           "timestamp(3)" [not null, default: `now()`]
  updatedAt           "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (user_id, role_type) [unique]
  }

  Note: 'A mobile user\'s profile photo for one side of their account. The role switcher is local to the app, so the same person can be a volunteer, donor and beneficiary; each side keeps its own picture here instead of sharing `User.avatar`.'
}

// ----------------------------------------------------------------------------
Table UserSchoolInfo {
  user_school_info_id text [pk, default: `uuid()`, note: 'PK']
  id_number           text [unique, not null]
  graduation_year     integer [not null]
  graduation_month    integer [not null]
  graduation_day      integer [not null]
  department_id       text [not null, note: 'FK -> Department.department_id']
  major_id            text [not null, note: 'FK -> Major.major_id']
  year_level_id       text [not null, note: 'FK -> YearLevel.year_level_id']
  user_id             text [not null, note: 'FK -> User.user_id']
  createdAt           "timestamp(3)" [not null, default: `now()`]
  updatedAt           "timestamp(3)" [not null, note: 'auto-updated on write']
  school_id_url       text [null, note: 'Scan of the school ID presented at registration; absent for ID-less roles.']
}

// ----------------------------------------------------------------------------
Table Department {
  department_id text [pk, default: `uuid()`, note: 'PK']
  name          text [not null]
  createdAt     "timestamp(3)" [not null, default: `now()`]
  updatedAt     "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table Major {
  major_id  text [pk, default: `uuid()`, note: 'PK']
  name      text [not null]
  createdAt "timestamp(3)" [not null, default: `now()`]
  updatedAt "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table YearLevel {
  year_level_id text [pk, default: `uuid()`, note: 'PK']
  name          text [not null]
  createdAt     "timestamp(3)" [not null, default: `now()`]
  updatedAt     "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table UserVerification {
  user_verification_id text [pk, default: `uuid()`, note: 'PK']
  user_id              text [not null, note: 'FK -> User.user_id']
  status               VerificationStatus [not null, default: 'N']
  createdAt            "timestamp(3)" [not null, default: `now()`]
  updatedAt            "timestamp(3)" [not null, note: 'auto-updated on write']
  user_biometric_id    text [unique, null, note: 'FK -> UserBiometric.user_biometric_id']

  Note: 'One ID check per submission. The biometric enrolled for that check hangs off the verification rather than the user, so a face scan is always tied to the review it was captured for.'
}

// ----------------------------------------------------------------------------
Table UserBiometric {
  user_biometric_id text [pk, default: `uuid()`, note: 'PK']
  face_url          text [not null]
  embedding         jsonb [null]
  embedding_type    EmbeddingType [not null, default: 'FACE']
  isActive          boolean [not null, default: true]
  createdAt         "timestamp(3)" [not null, default: `now()`]
  updatedAt         "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table Role {
  role_id   text [pk, default: `uuid()`, note: 'PK']
  type      RoleType [not null, default: 'VOLUNTEER']
  createdAt "timestamp(3)" [not null, default: `now()`]
  updatedAt "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table RolePermissionDefault {
  role_permission_default_id text [pk, default: `uuid()`, note: 'PK']
  role_type                  RoleType [not null]
  permission                 PermissionKey [not null]
  createdAt                  "timestamp(3)" [not null, default: `now()`]
  updatedAt                  "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (role_type, permission) [unique]
  }

  Note: 'Baseline rights every user of a role inherits. Keyed by `RoleType` rather than `role_id` because `Role` has no unique constraint on `type` — see the admin seeder.'
}

// ----------------------------------------------------------------------------
Table UserPermissionOverride {
  user_permission_override_id text [pk, default: `uuid()`, note: 'PK']
  user_id                     text [not null, note: 'FK -> User.user_id']
  permission                  PermissionKey [not null]
  effect                      PermissionOverrideEffect [not null]
  reason                      text [null]
  granted_by_user_id          text [not null, note: 'logical ref -> User.user_id (no FK constraint)']
  createdAt                   "timestamp(3)" [not null, default: `now()`]
  updatedAt                   "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (user_id, permission) [unique]
    user_id
  }

  Note: 'A per-user departure from the role baseline. Only rows that actually differ from the role default are stored, so an untouched user has none.'
}

// ----------------------------------------------------------------------------
Table UserActionSuspension {
  user_action_suspension_id text [pk, default: `uuid()`, note: 'PK']
  user_id                   text [not null, note: 'FK -> User.user_id']
  permission                PermissionKey [not null]
  reason                    text [not null]
  issued_by_user_id         text [not null, note: 'logical ref -> User.user_id (no FK constraint)']
  expires_at                "timestamp(3)" [null, note: 'Null means indefinite — it stays in force until an admin lifts it.']
  lifted_at                 "timestamp(3)" [null]
  lifted_by_user_id         text [null, note: 'logical ref -> User.user_id (no FK constraint)']
  createdAt                 "timestamp(3)" [not null, default: `now()`]
  updatedAt                 "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    user_id
  }

  Note: 'A violation-driven suspension of one action. Layers *over* the granted rights: the grant is preserved so lifting the suspension restores the original scope.'
}

// ----------------------------------------------------------------------------
Table BlockedIp {
  blocked_ip_id      text [pk, default: `uuid()`, note: 'PK']
  ip_address         text [unique, not null]
  reason             text [null]
  user_id            text [null, note: 'FK -> User.user_id | The account the block originated from — null for a manually entered address.']
  blocked_by_user_id text [not null, note: 'logical ref -> User.user_id (no FK constraint)']
  createdAt          "timestamp(3)" [not null, default: `now()`]
  updatedAt          "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table SecurityPolicy {
  security_policy_id           text [pk, default: `uuid()`, note: 'PK']
  singleton                    boolean [unique, not null, default: true]
  password_min_length          integer [not null, default: 8]
  password_require_uppercase   boolean [not null, default: true]
  password_require_lowercase   boolean [not null, default: true]
  password_require_number      boolean [not null, default: true]
  password_require_symbol      boolean [not null, default: false]
  lockout_enabled              boolean [not null, default: true]
  lockout_max_attempts         integer [not null, default: 5]
  lockout_window_minutes       integer [not null, default: 15, note: 'How far back failed attempts are counted, in minutes.']
  lockout_duration_minutes     integer [not null, default: 30, note: 'Minutes a lock is held. 0 means it stays until an administrator lifts it.']
  session_idle_timeout_minutes integer [not null, default: 0, note: 'Minutes of inactivity before a session is refused. 0 disables the check.']
  session_max_duration_hours   integer [not null, default: 0, note: 'Hours a session may live regardless of activity. 0 leaves it to the token\'s own expiry.']
  max_concurrent_sessions      integer [not null, default: 0, note: 'Devices one account may hold at once. 0 means unlimited.']
  login_hours_enabled          boolean [not null, default: false]
  login_hours_start_minute     integer [not null, default: 0, note: 'Minutes past midnight, server time. A start after the end wraps over midnight.']
  login_hours_end_minute       integer [not null, default: 1440]
  ip_allowlist                 "text[]" [not null, default: `'{}'`, note: 'Addresses allowed to sign in. Empty means no allowlist — see BlockedIp for the denylist.']
  updated_by_user_id           text [null, note: 'logical ref -> User.user_id (no FK constraint)']
  createdAt                    "timestamp(3)" [not null, default: `now()`]
  updatedAt                    "timestamp(3)" [not null, note: 'auto-updated on write']

  Note: 'Portal-wide security settings, held as exactly one row: `singleton` is pinned to true and unique, so an upsert can never create a second policy. Every field has a default here that matches the fallback the server applies when the row is missing.'
}

// ----------------------------------------------------------------------------
Table LoginActivity {
  login_activity_id text [pk, default: `uuid()`, note: 'PK']
  user_id           text [null, note: 'FK -> User.user_id | Null when no account matched the submitted email.']
  email             text [not null, note: 'The email exactly as submitted (lowercased), kept even when no account matched.']
  ip_address        text [not null]
  user_agent        text [null]
  source            LoginSource [not null]
  outcome           LoginOutcome [not null]
  failure_reason    text [null, note: 'The message the client was shown; null on a successful sign-in.']
  createdAt         "timestamp(3)" [not null, default: `now()`]

  indexes {
    user_id
    createdAt
    ip_address
    email
  }

  Note: 'One row per sign-in attempt, successful or not. Append-only: nothing updates or deletes a row, so the trail stays reviewable. `user_id` is null when the email matched no account, which is why the typed email is stored alongside it.'
}

// ----------------------------------------------------------------------------
Table OAuthIdentity {
  oauth_identity_id text [pk, default: `uuid()`, note: 'PK']
  provider          AuthProvider [not null]
  provider_user_id  text [not null, note: 'The provider\'s immutable subject id (`sub` for Google, `id` for Facebook). The email is not the key — providers let people change it.']
  email             text [null, note: 'Whatever the provider last reported, kept for support lookups only.']
  user_id           text [not null, note: 'FK -> User.user_id']
  createdAt         "timestamp(3)" [not null, default: `now()`]
  updatedAt         "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (provider, provider_user_id) [unique]
    user_id
  }

  Note: 'A social identity that may sign in as `user`. One row per provider account, so a donor can attach both Google and Facebook to the same CARES user.  Unlike `GmailConnection` — which stores mailbox tokens and grants no access on its own — a row here *is* an authentication factor, so no provider token is kept: the token is verified with the provider at sign-in and then discarded.'
}

// ----------------------------------------------------------------------------
Table GmailConnection {
  gmail_connection_id text [pk, default: `uuid()`, note: 'PK']
  user_id             text [unique, not null, note: 'FK -> User.user_id']
  google_sub          text [not null]
  email               text [not null]
  scope               text [not null, note: 'Granted scopes, space separated, exactly as Google returned them.']
  access_token        text [not null]
  refresh_token       text [not null, note: 'Google only returns this on the first consent, so it is never overwritten with null.']
  access_expires_at   "timestamp(3)" [not null]
  createdAt           "timestamp(3)" [not null, default: `now()`]
  updatedAt           "timestamp(3)" [not null, note: 'auto-updated on write']

  Note: 'One linked Google mailbox per portal user. Tokens are issued by Google OAuth and refreshed server-side; disconnecting deletes the row so nothing stale is kept.'
}

// ----------------------------------------------------------------------------
Table Interest {
  interest_id text [pk, default: `uuid()`, note: 'PK']
  code        InterestCode [unique, not null]
  label       text [not null]
  description text [null]
  is_active   boolean [not null, default: true]
  sort_order  integer [not null, default: 0]
  createdAt   "timestamp(3)" [not null, default: `now()`]
  updatedAt   "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table UserInterest {
  user_interest_id text [pk, default: `uuid()`, note: 'PK']
  user_id          text [unique, not null, note: 'FK -> User.user_id']
  selected         jsonb [not null]
  other_interest   text [null, note: 'What the volunteer typed under "Others"; null unless OTHERS is selected.']
  createdAt        "timestamp(3)" [not null, default: `now()`]
  updatedAt        "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table Event {
  event_id               integer [pk, increment, note: 'PK']
  title                  text [not null]
  description            text [not null]
  event_started          "timestamp(3)" [not null]
  event_ended            "timestamp(3)" [not null]
  location               text [not null]
  max_participants       integer [not null]
  participants           integer [not null, default: 0]
  organizer_name         text [not null]
  category               text [not null]
  department             text [null]
  specified_category     text [null]
  images                 "text[]" [not null, default: `'{}'`]
  status                 EventStatus [not null, default: 'Upcoming']
  funds_donation         boolean [not null, default: false]
  goods_donation         boolean [not null, default: false]
  goods_types            "text[]" [not null, default: `'{}'`]
  beneficiary_applicable boolean [not null, default: false]
  max_beneficiaries      integer [null]
  geojson                jsonb [null]
  area_sqm               float8 [null]
  createdAt              "timestamp(3)" [not null, default: `now()`]
  updatedAt              "timestamp(3)" [not null, note: 'auto-updated on write']
  marker_lat             float8 [null, note: 'Pin the operator dropped inside the geofence — the exact meeting spot.']
  marker_lng             float8 [null]
}

// ----------------------------------------------------------------------------
Table EventAttendance {
  event_attendance_id text [pk, default: `uuid()`, note: 'PK']
  event_id            integer [not null, note: 'FK -> Event.event_id']
  user_id             text [not null, note: 'FK -> User.user_id']
  status              AttendanceStatus [not null, default: 'PENDING']
  validation_method   GeoValidationMethod [null]
  first_ping_at       "timestamp(3)" [null, note: 'First reading inside the event geofence.']
  last_ping_at        "timestamp(3)" [null, note: 'Last reading inside the event geofence.']
  hours_rendered      float8 [null, note: 'Credited service hours; only meaningful once the row is COMPLETED.']
  participation_role  EventParticipationRole [not null, default: 'REGULAR', note: 'The role the volunteer registered for. REGULAR needs no review; the others file an EVENT_ROLE user request a director or coordinator rules on.']
  role_approval       EventRoleApproval [not null, default: 'APPROVED', note: 'Where that role stands. A REJECTED role keeps the registration — the volunteer simply takes part as a regular volunteer.']
  remarks             text [null]
  registered_at       "timestamp(3)" [not null, default: `now()`]
  createdAt           "timestamp(3)" [not null, default: `now()`]
  updatedAt           "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (event_id, user_id) [unique]
    event_id
    user_id
  }

  Note: 'One volunteer\'s registration for one event, plus whatever validation has ruled so far. The row is created on registration and stays PENDING until the coordinates are in and judged: before the event, while it runs, and after it for as long as an offline device still has not pushed.'
}

// ----------------------------------------------------------------------------
Table EventLocationPing {
  event_location_ping_id integer [pk, increment, note: 'PK']
  event_id               integer [null, note: 'FK -> Event.event_id']
  user_id                text [not null, note: 'FK -> User.user_id']
  captured_at            "timestamp(3)" [not null]
  latitude               float8 [not null]
  longitude              float8 [not null]
  accuracy_m             float8 [not null]
  in_area                boolean [not null, note: 'The device\'s own inside-the-geofence check at capture time.']
  source                 GeoValidationMethod [not null]
  createdAt              "timestamp(3)" [not null, default: `now()`]

  indexes {
    (event_id, user_id, captured_at)
    (user_id, captured_at)
  }

  Note: 'One GPS reading from a volunteer\'s device, one per second while their recorder is on. Live readings arrive one at a time (GEOFENCE); readings buffered offline arrive later as a CSV batch (OFFLINE_SYNC). `event_id` is the device\'s best guess and is null when it could not name a joined event — the validation service re-assigns rows from the coordinates, so nothing here is authoritative about attendance.'
}

// ----------------------------------------------------------------------------
Table Conversation {
  conversation_id text [pk, default: `uuid()`, note: 'PK']
  last_message_at "timestamp(3)" [null, note: 'Mirrors the newest message so the contact list can sort without a join.']
  createdAt       "timestamp(3)" [not null, default: `now()`]
  updatedAt       "timestamp(3)" [not null, note: 'auto-updated on write']

  Note: 'Direct (1:1) portal messaging. Participants are portal staff — volunteers use the mobile app and are not addressable here.'
}

// ----------------------------------------------------------------------------
Table ConversationParticipant {
  conversation_participant_id text [pk, default: `uuid()`, note: 'PK']
  conversation_id             text [not null, note: 'FK -> Conversation.conversation_id']
  user_id                     text [not null, note: 'FK -> User.user_id']
  last_read_at                "timestamp(3)" [null, note: 'Everything sent after this timestamp counts as unread for this participant.']
  createdAt                   "timestamp(3)" [not null, default: `now()`]

  indexes {
    (conversation_id, user_id) [unique]
    user_id
  }
}

// ----------------------------------------------------------------------------
Table ChatMessage {
  message_id      text [pk, default: `uuid()`, note: 'PK']
  conversation_id text [not null, note: 'FK -> Conversation.conversation_id']
  sender_id       text [not null, note: 'FK -> User.user_id']
  body            text [not null]
  createdAt       "timestamp(3)" [not null, default: `now()`]

  indexes {
    (conversation_id, createdAt)
  }
}

// ----------------------------------------------------------------------------
Table ChatAttachment {
  attachment_id text [pk, default: `uuid()`, note: 'PK']
  message_id    text [not null, note: 'FK -> ChatMessage.message_id']
  name          text [not null]
  size          integer [not null]
  mime_type     text [not null]
  url           text [not null, note: 'S3 object URL; streamed back through the API, never exposed as a public link.']
  createdAt     "timestamp(3)" [not null, default: `now()`]
}

// ----------------------------------------------------------------------------
Table SupportTicket {
  support_ticket_id text [pk, default: `uuid()`, note: 'PK']
  reference_number  integer [increment, unique, not null]
  subject           text [not null]
  description       text [not null]
  type              SupportTicketType [not null]
  status            SupportTicketStatus [not null, default: 'OPEN']
  priority          SupportTicketPriority [not null, default: 'MEDIUM']
  requester_id      text [not null, note: 'FK -> User.user_id']
  assignee_id       text [null, note: 'FK -> User.user_id | Null while the ticket is unassigned; cleared rather than deleted if the staff account goes away, so the ticket itself survives.']
  source            LoginSource [not null]
  createdAt         "timestamp(3)" [not null, default: `now()`]
  updatedAt         "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    status
    priority
    requester_id
    assignee_id
    updatedAt
  }

  Note: 'A reported problem or request. `reference_number` is the tracking number shown to the requester — sequential and never reused, which is why it is a DB sequence rather than a count of rows.'
}

// ----------------------------------------------------------------------------
Table SupportTicketReply {
  support_ticket_reply_id text [pk, default: `uuid()`, note: 'PK']
  support_ticket_id       text [not null, note: 'FK -> SupportTicket.support_ticket_id']
  author_id               text [null, note: 'FK -> User.user_id | Null once the author\'s account is removed; the thread keeps the message.']
  author_name             text [not null, note: 'Snapshot of the name shown in the thread, so a deleted author still reads right.']
  author_type             SupportTicketAuthorType [not null]
  body                    text [not null]
  createdAt               "timestamp(3)" [not null, default: `now()`]

  indexes {
    (support_ticket_id, createdAt)
  }
}

// ----------------------------------------------------------------------------
Table CertificateTemplate {
  certificate_template_id text [pk, default: `uuid()`, note: 'PK']
  reference               text [unique, not null, note: 'Human reference printed on the card, e.g. `CT-2026-014`.']
  name                    text [not null]
  description             text [not null]
  category                CertificateTemplateCategory [not null, default: 'PARTICIPATION']
  status                  CertificateTemplateStatus [not null, default: 'DRAFT']
  orientation             CertificateOrientation [not null, default: 'LANDSCAPE']
  issued                  integer [not null, default: 0, note: 'Certificates already printed from this template.']
  deployed_events         integer [not null, default: 0, note: 'Events currently deploying it.']
  design                  jsonb [not null]
  updated_by_user_id      text [null, note: 'FK -> User.user_id | Null once the editor\'s account is removed; the template keeps the name.']
  updated_by_name         text [not null, default: '', note: 'Snapshot of who last saved it, so a deleted account still reads right on the card.']
  createdAt               "timestamp(3)" [not null, default: `now()`]
  updatedAt               "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    status
    category
    updatedAt
  }

  Note: 'A certificate design a director maintains in the portal. Everything that is pure drawing instruction — accent, frame, per-block position, fonts, sizes, wording, seal and where each imported image sits — lives in `design`, shaped by `CertificateDesignSchema`. It is one document edited as a whole by one screen, so splitting it into columns would buy nothing and cost a migration per control the customizer gains. What is *not* in there is anything another feature has to join on: the signatory accounts and the uploaded files are their own rows.'
}

// ----------------------------------------------------------------------------
Table CertificateTemplateSignatory {
  certificate_template_signatory_id text [pk, default: `uuid()`, note: 'PK']
  certificate_template_id           text [not null, note: 'FK -> CertificateTemplate.certificate_template_id']
  coordinator_user_id               text [not null, note: 'FK -> User.user_id']
  name                              text [not null]
  title                             text [not null]
  department                        text [not null]
  signature_token                   text [not null, default: '{{signature-image}}', note: 'The placeholder the print job swaps for the coordinator\'s stored signature image (`User.signature_url`). The customizer never shows it — a director picks an account, not a token — but it is held per line rather than assumed globally so a line can print without a signature later without a migration.']
  position                          integer [not null, default: 0, note: 'Left-to-right order of the lines on the sheet.']
  createdAt                         "timestamp(3)" [not null, default: `now()`]
  updatedAt                         "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (certificate_template_id, coordinator_user_id) [unique]
    coordinator_user_id
    (certificate_template_id, position)
  }

  Note: 'One printed signature line. The coordinator account is the source of truth for the signature image, so the line stores the account rather than typed text; the printed strings are snapshotted beside it so a later rename or transfer cannot silently reword a template certificates were already issued from.'
}

// ----------------------------------------------------------------------------
Table CertificateTemplateAsset {
  certificate_template_asset_id text [pk, default: `uuid()`, note: 'PK']
  certificate_template_id       text [not null, note: 'FK -> CertificateTemplate.certificate_template_id']
  kind                          CertificateAssetKind [not null]
  storage_key                   text [not null, note: 'S3 object key, not a URL — the bucket and region are configuration.']
  file_name                     text [not null]
  content_type                  text [not null]
  byte_size                     integer [not null]
  createdAt                     "timestamp(3)" [not null, default: `now()`]

  indexes {
    certificate_template_id
  }

  Note: 'A file a director imported onto a sheet. The bytes live in the private S3 bucket, so `design` references the row by id and the portal reads the bytes back through `GET /v1/certificate-templates/:id/assets/:assetId` — an `<img src>` pointed at the stored object URL would render broken.'
}

// ----------------------------------------------------------------------------
Table CertificateDeployment {
  certificate_deployment_id text [pk, default: `uuid()`, note: 'PK']
  reference                 text [unique, not null, note: 'Human reference for the deployment itself, e.g. `DC-2026-014`.']
  certificate_template_id   text [not null, note: 'FK -> CertificateTemplate.certificate_template_id']
  template_name             text [not null, note: 'Snapshot of the template\'s name, category and shape as deployed.']
  category                  CertificateTemplateCategory [not null]
  orientation               CertificateOrientation [not null]
  design                    jsonb [not null, note: 'The frozen sheet: the same shape as `CertificateTemplate.design`, plus the signature lines as they read on the day.']
  event_id                  integer [not null, note: 'FK -> Event.event_id']
  event_name                text [not null, note: 'Snapshot of the event, so the list reads correctly even if the event is renamed.']
  event_venue               text [not null]
  event_date                "timestamp(3)" [not null]
  status                    CertificateDeploymentStatus [not null, default: 'SCHEDULED']
  participants              integer [not null, default: 0, note: 'Participants the deployment covers — the denominator for everything below.']
  distributed               integer [not null, default: 0, note: 'Certificates generated and released to a participant.']
  claimed                   integer [not null, default: 0, note: 'Of those, how many the recipient actually opened.']
  deployed_by_user_id       text [null, note: 'FK -> User.user_id | Null once the deploying account is removed; the row keeps the name.']
  deployed_by_name          text [not null, default: '']
  createdAt                 "timestamp(3)" [not null, default: `now()`]
  updatedAt                 "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (certificate_template_id, event_id) [unique]
    status
    event_id
    createdAt
  }

  Note: 'One template deployed to one event — what the live certificates page lists. The design, the signature lines and the event\'s own details are all frozen into the row at deploy time: the template it came from stays editable, and a certificate already promised to a volunteer must not silently change wording when a director tidies the template up afterwards. The template is still referenced, because the frozen design points at that template\'s stored artwork.'
}

// ----------------------------------------------------------------------------
Table IssuedCertificate {
  issued_certificate_id     text [pk, default: `uuid()`, note: 'PK']
  certificate_number        text [unique, not null, note: 'Printed on the sheet, e.g. `CERT-2026-000123`.']
  certificate_deployment_id text [not null, note: 'FK -> CertificateDeployment.certificate_deployment_id']
  event_id                  integer [not null, note: 'FK -> Event.event_id']
  user_id                   text [not null, note: 'FK -> User.user_id']
  recipient_name            text [not null, note: 'What the placeholders were filled with, as they read on the day of issue.']
  event_name                text [not null]
  event_date                "timestamp(3)" [not null]
  hours_rendered            float8 [not null, default: 0]
  organization              text [not null]
  template_name             text [not null]
  category                  CertificateTemplateCategory [not null]
  orientation               CertificateOrientation [not null]
  design                    jsonb [not null, note: 'The deployment\'s frozen design plus, per signature line, the S3 key of the coordinator\'s signature image at issue time (`StoredIssuedDesign`).']
  issued_at                 "timestamp(3)" [not null, default: `now()`]
  claimed_at                "timestamp(3)" [null, note: 'When the recipient first opened it in the app; null until then.']
  createdAt                 "timestamp(3)" [not null, default: `now()`]
  updatedAt                 "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (certificate_deployment_id, user_id) [unique]
    user_id
    event_id
    issued_at
  }

  Note: 'One certificate the issuing sweep generated for one participant of one deployment. The sheet is frozen here in full — the deployment\'s design with every placeholder filled and each signature line pointing at the image it printed — so what the volunteer holds never changes if the event, the template or a coordinator\'s profile is edited afterwards.'
}

// ----------------------------------------------------------------------------
Table MonthlyReportFolder {
  monthly_report_folder_id text [pk, default: `uuid()`, note: 'PK']
  name                     text [not null]
  created_by_user_id       text [null, note: 'FK -> User.user_id | Null once the creating account is removed; the folder keeps the name below.']
  created_by_name          text [not null, default: '']
  createdAt                "timestamp(3)" [not null, default: `now()`]
  updatedAt                "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    createdAt
  }

  Note: 'A named tray the director builds on top of the automatic filing — an accreditation packet, a set pulled for a board meeting. College folders are *not* rows: they are derived from each report\'s `department`, so every approved report has a home before anyone files it anywhere, and deleting a folder only drops it back to its college.'
}

// ----------------------------------------------------------------------------
Table MonthlyReport {
  monthly_report_id    text [pk, default: `uuid()`, note: 'PK']
  reference            text [unique, not null, note: 'Tracking number both sides quote, e.g. `MR-2026-014`.']
  title                text [not null]
  period               text [not null, note: 'Reporting month as `YYYY-MM` — the period filter and the grouping key.']
  department           ReportDepartment [not null]
  status               MonthlyReportStatus [not null, default: 'UNDER_REVIEW']
  summary              text [not null]
  metric_events        integer [not null, default: 0]
  metric_volunteers    integer [not null, default: 0]
  metric_service_hours integer [not null, default: 0]
  metric_beneficiaries integer [not null, default: 0]
  submitted_by_user_id text [null, note: 'FK -> User.user_id']
  submitted_by_name    text [not null]
  submitted_by_email   text [not null]
  submitted_by_title   text [not null]
  submitted_at         "timestamp(3)" [not null, default: `now()`]
  reviewer_user_id     text [null, note: 'FK -> User.user_id']
  reviewer_name        text [null, note: 'Snapshot of the deciding director, shown on the row without a join.']
  decided_at           "timestamp(3)" [null]
  decision_note        text [null, note: 'Latest decision note — the only thing a returned report gives the coordinator.']
  folder_id            text [null, note: 'FK -> MonthlyReportFolder.monthly_report_folder_id | The director\'s tray this sits in. Null means it is filed under its college.']
  createdAt            "timestamp(3)" [not null, default: `now()`]
  updatedAt            "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    status
    period
    department
    folder_id
    updatedAt
  }

  Note: 'One coordinator submission for one reporting month. The submitter\'s name, email and post are snapshotted beside the account: a report already decided on must keep reading the way it read on the day, even if the coordinator is renamed or moves college.'
}

// ----------------------------------------------------------------------------
Table MonthlyReportDocument {
  monthly_report_document_id text [pk, default: `uuid()`, note: 'PK']
  monthly_report_id          text [not null, note: 'FK -> MonthlyReport.monthly_report_id']
  file_name                  text [not null, note: 'File name as the coordinator uploaded it, extension included.']
  kind                       MonthlyReportDocumentKind [not null]
  storage_key                text [not null, note: 'S3 object key, not a URL — the bucket and region are configuration.']
  content_type               text [not null]
  byte_size                  integer [not null]
  createdAt                  "timestamp(3)" [not null, default: `now()`]

  indexes {
    monthly_report_id
  }

  Note: 'A file attached to a submission. The bytes live in the private S3 bucket, so the row holds the object key and the portal reads them back through `GET /v1/monthly-reports/:id/documents/:documentId` — a stored object URL in an `<a href>` would 403.'
}

// ----------------------------------------------------------------------------
Table MonthlyReportTrailEntry {
  monthly_report_trail_entry_id text [pk, default: `uuid()`, note: 'PK']
  monthly_report_id             text [not null, note: 'FK -> MonthlyReport.monthly_report_id']
  action                        MonthlyReportTrailAction [not null]
  actor_name                    text [not null, note: 'Snapshot of the actor\'s name, so a rename cannot rewrite the trail.']
  "note"                        text [null]
  createdAt                     "timestamp(3)" [not null, default: `now()`]

  indexes {
    (monthly_report_id, createdAt)
  }

  Note: 'Append-only history of the submission: who submitted, who decided, and the note that came with it. This is the report\'s own record, kept beside the entry rather than in the global audit log because the coordinator reads it too.'
}

// ----------------------------------------------------------------------------
Table Announcement {
  announcement_id text [pk, default: `uuid()`, note: 'PK']
  title           text [not null]
  body            text [not null]
  tone            AnnouncementTone [not null, default: 'INFO']
  audiences       "AnnouncementAudience[]" [not null, default: `'{}'`]
  channels        "AnnouncementChannel[]" [not null, default: `'{}'`]
  state           AnnouncementState [not null, default: 'DRAFT']
  publish_at      "timestamp(3)" [not null]
  expires_at      "timestamp(3)" [null, note: 'Null means it stays up until taken down by hand.']
  pinned          boolean [not null, default: false]
  window_id       text [null, note: 'The maintenance window this notice was written for; windows are not persisted yet, so this is a loose reference rather than a relation.']
  author_id       text [null, note: 'FK -> User.user_id']
  author_name     text [not null, note: 'Snapshot of the author\'s name, so a rename cannot rewrite the board.']
  reach           integer [not null, default: 0, note: 'Accounts it reached when it went out; 0 until it publishes.']
  createdAt       "timestamp(3)" [not null, default: `now()`]
  updatedAt       "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    state
    publish_at
  }

  Note: 'A notice written on the Maintenance board and read back on System Notices. State moves forward on its own once a scheduled `publish_at` or `expires_at` passes; the sweep runs on read, so a page that polls sees the flip without a scheduler.'
}

// ----------------------------------------------------------------------------
Table Notification {
  notification_id text [pk, default: `uuid()`, note: 'PK']
  user_id         text [not null, note: 'FK -> User.user_id']
  title           text [not null]
  description     text [not null]
  category        NotificationCategory [not null]
  tone            NotificationTone [not null, default: 'INFO']
  href            text [null, note: 'Portal path the row opens — the screen the notice is about.']
  dedupe_key      text [null, note: 'Set by schedulers so a repeated sweep cannot notify the same thing twice.']
  audience_role   RoleType [null, note: 'Which side of a mobile account the row belongs to (a donor who also volunteers sees donation news only on the Donor side). Null means the row is about the account itself and shows on every side — and on the portal.']
  read_at         "timestamp(3)" [null]
  dismissed_at    "timestamp(3)" [null]
  createdAt       "timestamp(3)" [not null, default: `now()`]

  indexes {
    (dedupe_key, user_id) [unique]
    (user_id, dismissed_at, createdAt)
  }

  Note: 'One row per recipient. A notice addressed to a role is fanned out to every account holding that role at publish time, so read and dismissed state are per person and a later hire does not inherit a backlog.'
}

// ----------------------------------------------------------------------------
Table EvaluationForm {
  evaluation_form_id text [pk, default: `uuid()`, note: 'PK']
  title              text [not null]
  description        text [not null, default: '']
  header_typography  jsonb [not null]
  questions          jsonb [not null]
  status             EvaluationFormStatus [not null, default: 'DRAFT']
  createdAt          "timestamp(3)" [not null, default: `now()`]
  updatedAt          "timestamp(3)" [not null, note: 'auto-updated on write']
  is_default         boolean [not null, default: false, note: 'The one questionnaire served for an event that has none assigned. At most one row holds it; assigning it elsewhere moves it rather than adding a second.']

  Note: 'The post-event questionnaire the director builds in the portal. One form serves every completed event; the volunteer app only ever sees it once PUBLISHED. The questions are stored as the JSON the builder edits (see the evaluation validators for the shape) so adding a question type never needs a migration.'
}

// ----------------------------------------------------------------------------
Table EvaluationAssignment {
  evaluation_assignment_id text [pk, default: `uuid()`, note: 'PK']
  form_id                  text [not null, note: 'FK -> EvaluationForm.evaluation_form_id']
  event_id                 integer [unique, not null, note: 'FK -> Event.event_id']
  assigned_by_id           text [null, note: 'FK -> User.user_id | The director who assigned it; kept null when the account is later removed.']
  createdAt                "timestamp(3)" [not null, default: `now()`]
  updatedAt                "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    form_id
  }

  Note: 'Which questionnaire one event asks its participants. An event has at most one, a questionnaire can serve many, and an event without a row falls back to the questionnaire flagged `is_default` — so feedback never goes dark on an event the director has not got to yet.'
}

// ----------------------------------------------------------------------------
Table RankingSettings {
  ranking_settings_id       text [pk, default: `uuid()`, note: 'PK']
  points_per_attendance     integer [not null, default: 10, note: 'Points a volunteer earns for every event they attended (COMPLETED).']
  absence_penalty_step      integer [not null, default: 2, note: 'First missed registration costs this much; each straight miss adds it again.']
  absence_reset_days        integer [not null, default: 7, note: 'Misses further apart than this restart the penalty at the first step.']
  default_period            text [not null, default: 'month']
  tiers                     jsonb [not null]
  createdAt                 "timestamp(3)" [not null, default: `now()`]
  updatedAt                 "timestamp(3)" [not null, note: 'auto-updated on write']
  donor_pesos_per_point     integer [not null, default: 100, note: 'Donor board: one point for every this many pesos of confirmed donations.']
  goods_type_values         jsonb [null, note: 'Peso value credited per unit of each goods type (`food`, `clothing`, …) when a goods donation is scored; null falls back to the shipped defaults.']
  participation_role_points jsonb [null, note: 'Extra points per attended event for an approved special role (`ORGANIZER`, `FACILITATOR`, `SPEAKER`), on top of `points_per_attendance`; null falls back to the shipped defaults.']

  Note: 'How the volunteer leaderboard is scored and how its tier ladder is cut. One row: the portal\'s Rankings → Customization edits it, the volunteer app reads the tiers to draw its avatar frames. `tiers` is the JSON the customization form edits (see the rankings validators) so a new frame design never needs a migration.'
}

// ----------------------------------------------------------------------------
Table EvaluationResponse {
  evaluation_response_id text [pk, default: `uuid()`, note: 'PK']
  form_id                text [not null, note: 'FK -> EvaluationForm.evaluation_form_id']
  event_id               integer [not null, note: 'FK -> Event.event_id']
  user_id                text [not null, note: 'FK -> User.user_id']
  answers                jsonb [not null]
  rating                 integer [null]
  status                 EvaluationResponseStatus [not null, default: 'COMPLETE']
  submitted_at           "timestamp(3)" [not null, default: `now()`]
  createdAt              "timestamp(3)" [not null, default: `now()`]
  updatedAt              "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (event_id, user_id) [unique]
    event_id
    user_id
  }

  Note: 'One volunteer\'s answers to the questionnaire for one completed event they took part in. `answers` is keyed by question id; `rating` copies the star-rating answer out so the portal can filter and average without opening the JSON.'
}

// ----------------------------------------------------------------------------
Table UserRequest {
  user_request_id      text [pk, default: `uuid()`, note: 'PK']
  reference_number     integer [increment, unique, not null, note: 'Sequential tracking number; the portal renders it as `REQ-007`.']
  kind                 UserRequestKind [not null]
  status               UserRequestStatus [not null, default: 'PENDING']
  user_id              text [not null, note: 'FK -> User.user_id']
  requested_role       RoleType [null, note: 'ROLE_ACCESS only — the role being asked for.']
  event_id             integer [null, note: 'FK -> Event.event_id | EVENT_JOIN / EVENT_ROLE — the event the request is about.']
  participation_role   EventParticipationRole [null, note: 'EVENT_ROLE only — the event role the volunteer asked to take.']
  id_front_url         text [null, note: 'ROLE_ACCESS / ALUMNI_REGISTRATION / PARTNER_BARANGAY_REGISTRATION / MANUAL_REGISTRATION — the ID presented with the request.']
  id_back_url          text [null]
  selfie_url           text [null]
  face_similarity      float8 [null]
  summary              text [not null, note: 'One-line statement of what is being asked for, written at filing time.']
  decided_by_user_id   text [null, note: 'FK -> User.user_id']
  decided_at           "timestamp(3)" [null]
  rejection_reason     text [null, note: 'Set when a director rejects the request — the reason the requester sees in the app. Cleared never: a re-application is a new row.']
  createdAt            "timestamp(3)" [not null, default: `now()`]
  updatedAt            "timestamp(3)" [not null, note: 'auto-updated on write']
  selfie_embedding     jsonb [null, note: 'The 512-dim face embedding from the session\'s match, kept so acceptance can enrol the biometric without re-running the face service.']
  residency_proof_url  text [null, note: 'EVENT_JOIN only — the proof of residency the beneficiary attached.']
  residency_proof_name text [null]
  residency_proof_mime text [null]
  document_url         text [null, note: 'BENEFICIARY_REGISTRATION only — the supporting document attached to the sign-up form. Any file type; the director opens it before approving.']
  document_name        text [null]
  document_mime        text [null]
  document_size_bytes  integer [null]

  indexes {
    user_id
    status
    (kind, status)
  }

  Note: 'One request filed from the mobile app for a director to rule on. The proof behind a ROLE_ACCESS request (ID sides, selfie) is copied off the Redis registration session at filing time so it outlives that session\'s TTL.'
}

// ----------------------------------------------------------------------------
Table UserRequestTrailEntry {
  user_request_trail_entry_id text [pk, default: `uuid()`, note: 'PK']
  user_request_id             text [not null, note: 'FK -> UserRequest.user_request_id']
  label                       text [not null]
  actor_name                  text [not null, note: 'Who caused it — the requester for the filing, a portal account after that.']
  createdAt                   "timestamp(3)" [not null, default: `now()`]

  indexes {
    user_request_id
  }

  Note: 'One line on a request\'s history — filed, accepted, removed, restored.'
}

// ----------------------------------------------------------------------------
Table NeedsAssessment {
  needs_assessment_id     text [pk, default: `uuid()`, note: 'PK']
  user_id                 text [unique, not null, note: 'FK -> User.user_id']
  needs                   "text[]" [not null, note: 'Q1 — what the household needs help with (`food`, `healthcare`, … `other`).']
  other_need              text [null]
  seriousness             integer [not null, note: 'Q2 — 1 (not serious) to 5 (very serious).']
  barriers                "text[]" [not null, note: 'Q3 — what makes the need hard to meet (`money`, … `other`, `none`).']
  other_barrier           text [null]
  community_problem       text [not null, note: 'Q4 — the problem most commonly seen in the community.']
  other_community_problem text [null]
  concern                 text [null, note: 'Q5 — anything else the household wants CARES to know.']
  submitted_at            "timestamp(3)" [not null, default: `now()`, note: 'When the answers were last submitted — the first take or the latest update.']
  createdAt               "timestamp(3)" [not null, default: `now()`]
  updatedAt               "timestamp(3)" [not null, note: 'auto-updated on write']

  Note: 'A beneficiary\'s Needs Assessment Survey — one per account, overwritten when they update it. Answers are stored as the codes the residential-needs clustering works on (`food`, `money`, …), not the app\'s display labels.'
}

// ----------------------------------------------------------------------------
Table AssistanceRequest {
  assistance_request_id text [pk, default: `uuid()`, note: 'PK']
  reference_number      integer [increment, unique, not null, note: 'Sequential tracking number; the app renders it as `CARES-AR-2026-0007`.']
  user_id               text [not null, note: 'FK -> User.user_id']
  title                 text [not null, note: 'What is needed — the picked option or what the beneficiary typed.']
  category              AssistanceCategory [not null]
  description           text [not null]
  urgency               AssistanceUrgency [not null]
  household_size        integer [not null]
  location_latitude     float8 [null, note: 'Where the assistance is needed, pinned by the beneficiary on the map. Both are set together or both are null.']
  location_longitude    float8 [null]
  location_details      text [null, note: 'Landmark or address details typed beside the pin.']
  status                AssistanceRequestStatus [not null, default: 'PENDING']
  assessment_status     AssistanceAssessmentStatus [not null, default: 'NOT_STARTED']
  assessment_date       "timestamp(3)" [null, note: 'The needs assessment visit — scheduled or held.']
  assigned_organization text [null]
  items                 "text[]" [not null, note: 'What is being released, filled in by staff once it is decided.']
  status_note           text [null, note: 'Staff note shown under the status; the app falls back to a stock line.']
  screened_at           "timestamp(3)" [null]
  decided_at            "timestamp(3)" [null]
  released_at           "timestamp(3)" [null]
  cancelled_at          "timestamp(3)" [null, note: 'Set when the beneficiary withdraws the request themselves.']
  cancel_reason         text [null]
  createdAt             "timestamp(3)" [not null, default: `now()`]
  updatedAt             "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    user_id
    status
  }

  Note: 'Assistance a beneficiary asked for from the app (food pack, medicine, …). The stage timestamps drive the progress trail the app draws.'
}

// ----------------------------------------------------------------------------
Table AssistanceRequestAttachment {
  assistance_request_attachment_id text [pk, default: `uuid()`, note: 'PK']
  assistance_request_id            text [not null, note: 'FK -> AssistanceRequest.assistance_request_id']
  name                             text [not null]
  url                              text [not null]
  mime                             text [not null]
  size_bytes                       integer [not null]
  createdAt                        "timestamp(3)" [not null, default: `now()`]

  indexes {
    assistance_request_id
  }

  Note: 'A proof document filed with an assistance request (ID, bill, photo, …).'
}

// ----------------------------------------------------------------------------
Table Donation {
  donation_id    text [pk, default: `uuid()`, note: 'PK']
  sequence       integer [increment, unique, not null, note: 'Human tracking number — `DN-0007` is sequence 7.']
  user_id        text [not null, note: 'FK -> User.user_id']
  event_id       integer [not null, note: 'FK -> Event.event_id']
  kind           DonationKind [not null]
  status         DonationStatus [not null, default: 'PLEDGED']
  amount         integer [not null, note: 'Whole pesos: what was paid for money; the credited value of the goods (goods-type value × quantity, snapshotted at pledge time) for goods.']
  payment_id     text [unique, null, note: 'FK -> DonationPayment.donation_payment_id']
  goods_type     text [null, note: 'Goods only — the `goods_types` id on the event (`food`, `clothing`, …) or `other`.']
  goods_item     text [null, note: 'Goods only — what the donor said they are giving.']
  goods_quantity integer [null]
  donor_contact  text [null, note: 'Goods only — the number CARES can reach the donor on about the drop-off.']
  delivery_date  "timestamp(3)" [null, note: 'Goods only — the day the donor plans to hand the goods in at the CARES office.']
  confirmed_at   "timestamp(3)" [null]
  createdAt      "timestamp(3)" [not null, default: `now()`]
  updatedAt      "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    user_id
    event_id
    status
  }

  Note: 'The donation ledger the portal\'s Donation Tracking works and the donor app\'s Activity tab reads. A money row is opened by the gateway callback once a checkout is paid; a goods row is opened when the donor pledges. Only CONFIRMED rows count towards the donor board.'
}

// ----------------------------------------------------------------------------
Table DonationTrailEntry {
  donation_trail_entry_id text [pk, default: `uuid()`, note: 'PK']
  donation_id             text [not null, note: 'FK -> Donation.donation_id']
  status                  DonationStatus [not null]
  "note"                  text [null]
  actor_id                text [null, note: 'FK -> User.user_id']
  actor_label             text [not null, note: '`System` for the donor-side submission, otherwise the portal account\'s name.']
  notified_email          text [null, note: 'Donor address the status notice went to; null when nothing was sent.']
  createdAt               "timestamp(3)" [not null, default: `now()`]

  indexes {
    donation_id
  }

  Note: 'Every status move on a donation, with who made it — the audit trail the portal shows and the proof that the donor was notified.'
}

// ----------------------------------------------------------------------------
Table AuditLog {
  audit_log_id  text [pk, default: `uuid()`, note: 'PK']
  action        text [not null, note: 'Machine key, e.g. `access-control.permission.revoked` — stable across wording changes.']
  description   text [not null, note: 'The sentence the portal renders in the grid.']
  category      AuditCategory [not null]
  severity      AuditSeverity [not null, default: 'INFO']
  outcome       AuditOutcome [not null, default: 'SUCCESS']
  actor_user_id text [null, note: 'FK -> User.user_id | Null for background jobs, and for actors whose account was later deleted.']
  actor_name    text [not null]
  actor_email   text [not null]
  actor_role    RoleType [null, note: 'Null when the actor is the system rather than an account.']
  target_type   text [not null, note: 'What the action was performed on — `user`, `event`, `certificate`, `system`, …']
  target_label  text [not null]
  target_id     text [null, note: 'Null when the target is not a single record (a route, a role baseline, a service).']
  ip_address    text [not null]
  user_agent    text [null]
  source        AuditSource [not null, default: 'PORTAL']
  request_id    text [null, note: 'Correlates every entry written by one request.']
  reason        text [null, note: 'Operator-supplied justification, when the action asks for one.']
  changes       jsonb [not null, default: `'[]'::jsonb`, note: 'Field-level before/after pairs: `[{ field, before, after }]`.']
  metadata      jsonb [not null, default: `'{}'::jsonb`, note: 'Free-form context — counts, service scores, template names.']
  createdAt     "timestamp(3)" [not null, default: `now()`]

  indexes {
    actor_user_id
    createdAt
    category
    severity
    outcome
    action
  }

  Note: 'One row per privileged action. Append-only: nothing updates or deletes a row, so the trail stays reviewable. The actor\'s name, email, and role are denormalised at write time so a later rename or role change cannot rewrite history.'
}

// ----------------------------------------------------------------------------
Table Account {
  account_id             text [pk, default: `uuid()`, note: 'PK']
  email                  text [unique, not null]
  password               text [null, note: 'Null for an account that only ever signs in through a social provider — see `OAuthIdentity`. Password sign-in is refused outright when this is null.']
  credential_expires_at  "timestamp(3)" [null, note: 'Set when an administrator provisioned this account with temporary credentials. Sign-in is refused once it passes; null means the password does not expire, which is what a self-registered account and a completed hand-over both look like.']
  provisioned_by_user_id text [null, note: 'logical ref -> User.user_id (no FK constraint) | The administrator who issued the credential in force — null for self-registration.']
  email_verified_at      "timestamp(3)" [null, note: 'When the owner proved the address — the sign-up OTP, a provider that vouches for it, or an administrator mailing the credential to it. Mobile password sign-in is refused while this is null.']
  signature_url          text [null, note: 'Portal signatory image (directors/coordinators); printed onto certificates.']
  is_restricted          boolean [not null, default: false]
  restricted_at          "timestamp(3)" [null]
  restriction_reason     text [null]
  last_login_ip          text [null]
  user_id                text [not null, note: 'FK -> User.user_id']
  createdAt              "timestamp(3)" [not null, default: `now()`]
  updatedAt              "timestamp(3)" [not null, note: 'auto-updated on write']
}

// ----------------------------------------------------------------------------
Table DonationPayment {
  donation_payment_id text [pk, default: `uuid()`, note: 'PK']
  user_id             text [not null, note: 'FK -> User.user_id']
  event_id            integer [null, note: 'FK -> Event.event_id | The director event behind the campaign, when the campaign is event-backed.']
  campaign_id         text [not null]
  campaign_title      text [not null]
  amount              integer [not null, note: 'Whole pesos.']
  currency            text [not null, default: 'PHP']
  method              DonationPaymentMethod [not null]
  status              DonationPaymentStatus [not null, default: 'PENDING']
  idempotency_key     text [not null, note: 'Client-generated per checkout attempt; the same key returns the same row.']
  gateway_reference   text [unique, not null, note: 'The `reference_id` / `external_id` handed to Xendit; callbacks carry it back.']
  gateway_resource_id text [null, note: 'Xendit\'s id for the charge, QR code or invoice we created.']
  payment_reference   text [null, note: 'Xendit\'s id for the settled payment — the reference shown on the receipt.']
  payment_channel     text [null, note: 'Payment channel Xendit reported on settlement (e.g. DD_BPI for a bank transfer).']
  checkout_url        text [null, note: 'GCASH / CARD / BANK_TRANSFER: where the donor completes the payment.']
  qr_string           text [null, note: 'QRPH only: the EMV string the app renders as a QR code.']
  expires_at          "timestamp(3)" [null]
  paid_at             "timestamp(3)" [null]
  failure_reason      text [null]
  createdAt           "timestamp(3)" [not null, default: `now()`]
  updatedAt           "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (user_id, idempotency_key) [unique]
    user_id
    status
  }

  Note: 'One money-donation checkout a donor started from the app. A row is created before the gateway is called so the client\'s idempotency key can dedupe a retried tap, and the gateway reference on it is what every Xendit callback carries back.'
}

// ----------------------------------------------------------------------------
Table PaymentWebhookEvent {
  webhook_id        text [pk, note: 'PK']
  event             text [not null]
  gateway_reference text [null, note: 'logical ref -> DonationPayment.gateway_reference (no FK constraint)']
  payload           jsonb [not null]
  receivedAt        "timestamp(3)" [not null, default: `now()`]

  indexes {
    gateway_reference
  }

  Note: 'Every Xendit callback already applied, keyed by its `webhook-id` header. Xendit retries until it sees a 2xx, so the same event can arrive more than once; inserting here in the same transaction as the status change makes a replay a no-op.'
}

// ----------------------------------------------------------------------------
Table PaymentGatewaySettings {
  payment_gateway_settings_id text [pk, default: `uuid()`, note: 'PK']
  singleton                   boolean [unique, not null, default: true]
  mode                        PaymentGatewayMode [not null, default: 'TEST']
  enabled                     boolean [not null, default: false, note: 'Off until the director is ready to take money; every checkout is refused while false.']
  secret_key_cipher           text [null, note: 'Ciphertext of the Xendit secret API key. Null means "still on the env key".']
  secret_key_last4            text [null, note: 'Last four characters of the saved key, for telling two keys apart in the portal.']
  webhook_token_cipher        text [null, note: 'Ciphertext of the callback verification token from Xendit\'s dashboard.']
  api_url                     text [null, note: 'Blank for https://api.xendit.co — only set when pointing at a mock or proxy.']
  statement_name              text [null, note: 'The name the donor sees on the GCash / card statement.']
  support_email               text [null, note: 'Where donors reach CARES about a payment that went wrong.']
  support_contact             text [null]
  verified_at                 "timestamp(3)" [null, note: 'When the saved key last answered a live call, and why it last did not.']
  verification_error          text [null]
  updated_by_user_id          text [null, note: 'logical ref -> User.user_id (no FK constraint) | No relation, like `SecurityPolicy`: the row outlives the account that saved it.']
  createdAt                   "timestamp(3)" [not null, default: `now()`]
  updatedAt                   "timestamp(3)" [not null, note: 'auto-updated on write']

  Note: 'The Xendit account CARES collects donations into, as the director enters it in the portal\'s Payments module. One row — every donor pays into the same account.  The secrets are held as AES-256-GCM ciphertext (see `secret-cipher-utils.ts`) and are never sent back to a client: the portal only ever sees `secret_key_last4` and the `*_set` flags, which is enough to say "a key is saved, and it ends in 1a2b".'
}

// ----------------------------------------------------------------------------
Table PaymentMethodSetting {
  payment_method_setting_id text [pk, default: `uuid()`, note: 'PK']
  settings_id               text [not null, note: 'FK -> PaymentGatewaySettings.payment_gateway_settings_id']
  method                    DonationPaymentMethod [not null]
  enabled                   boolean [not null, default: false]
  display_name              text [null, note: 'Overrides the channel\'s built-in name in the app; blank keeps the default.']
  instructions              text [null, note: 'One line under the name on the donor\'s method step.']
  account_name              text [null, note: 'The account the settlement lands in, as the director reads it off Xendit — the GCash number or bank account. Reference only: Xendit routes to the account behind the secret key, not to whatever is typed here.']
  account_number            text [null]
  channel_codes             "text[]" [not null, default: `'{}'`, note: 'Xendit channel codes this method opens (CARD / BANK_TRANSFER); empty uses the module\'s defaults.']
  min_amount                integer [not null, default: 0, note: 'Whole pesos. 0 falls back to the module-wide donation limits.']
  max_amount                integer [not null, default: 0]
  sort_order                integer [not null, default: 0]
  verification              PaymentMethodVerification [not null, default: 'NOT_VERIFIED', note: 'Set by the activation check that runs when the director switches this on.']
  verified_at               "timestamp(3)" [null]
  verification_message      text [null, note: 'What the gateway said — the sentence the portal shows under the badge.']
  verified_channel_codes    "text[]" [not null, default: `'{}'`, note: 'Channel codes Xendit reported activated at the last check, for the record.']
  callbacks_registered_at   "timestamp(3)" [null, note: 'When the callback URLs for this channel were last registered with Xendit.']
  account_proof             PaymentAccountProof [not null, default: 'NOT_STARTED', note: '--- ownership proof: is the recorded account really reachable by CARES ---']
  account_proof_amount      integer [null, note: 'Whole pesos sent, and the number the director has to report back. Cleared once the account is verified so a later reader cannot simply look up the answer.']
  account_proof_reference   text [null, note: 'Our reference on the payout, and Xendit\'s id for it.']
  account_proof_id          text [null]
  account_proof_sent_at     "timestamp(3)" [null]
  account_proof_attempts    integer [not null, default: 0, note: 'Wrong answers so far; the proof locks after `ACCOUNT_PROOF_MAX_ATTEMPTS`.']
  account_proof_message     text [null, note: 'What the gateway or the check last said, for the portal to show.']
  account_proof_target      text [null, note: 'The account this proof covered, so editing the number invalidates the proof.']
  account_verified_at       "timestamp(3)" [null]
  createdAt                 "timestamp(3)" [not null, default: `now()`]
  updatedAt                 "timestamp(3)" [not null, note: 'auto-updated on write']

  indexes {
    (settings_id, method) [unique]
  }

  Note: 'One donor-facing payment channel. A channel the director has not enabled is not offered in the app and is refused by the checkout endpoint, so hiding it in the portal and blocking it on the server are one decision.'
}

