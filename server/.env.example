# --- Xendit (donation payments) ---------------------------------------------
# Secret API key from dashboard.xendit.co > Settings > Developers > API Keys.
# A test-mode key (xnd_development_...) keeps every checkout in the sandbox.
XENDIT_SECRET_KEY=
# Callback verification token from Settings > Developers > Callbacks. Xendit sends
# it as `x-callback-token`; callbacks that don't carry it are rejected.
# Register {API_PUBLIC_URL}/api/v1/donations/webhooks/xendit for eWallets,
# QR codes and Invoices. Sandbox callbacks need API_PUBLIC_URL to be reachable
# from the internet (an ngrok / cloudflared tunnel while developing).
XENDIT_WEBHOOK_TOKEN=
# Leave blank for https://api.xendit.co
XENDIT_API_URL=
