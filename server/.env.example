# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cares_db

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=8000
# Comma-separated site origins for CORS (Vite default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Director seeder (pnpm run seed:admin) — do not commit real passwords
SEED_ADMIN_EMAIL=admin@uclm.edu.ph
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRSTNAME=CARES
SEED_ADMIN_LASTNAME=Director
# Optional — auto-derived from email when omitted
# SEED_ADMIN_PHONE=09171234567
# SEED_ADMIN_ADDRESS=University of Cebu – LM
