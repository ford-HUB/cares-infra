# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cares_db

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# The root operator account: cannot have its actions suspended and cannot change its
# sign-in email, so the portal can never be left without a reachable administrator.
PROTECTED_ADMIN_EMAIL=admin@cares.com

# Server
PORT=8000
# Comma-separated site origins for CORS (Vite default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin mailbox — Google OAuth (Gmail API must be enabled on the Google Cloud project).
# GOOGLE_CALLBACK_URL has to match an Authorised redirect URI on the OAuth client exactly.
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/mailbox/google/callback
# Public origin of this API — used to build the link that starts the consent flow.
API_PUBLIC_URL=http://localhost:8000
# Where the browser lands after consent; defaults to SITE_URL + /admin/mail-inbox
SITE_URL=http://localhost:5173
# MAILBOX_REDIRECT_URL=http://localhost:5173/admin/mail-inbox

# Portal seeder (pnpm run seed:admin) — do not commit real passwords
SEED_ADMIN_EMAIL=admin@cares.com
SEED_ADMIN_PASSWORD=p@ssw0rd!
SEED_ADMIN_FIRSTNAME=Cris Dyford
SEED_ADMIN_LASTNAME=Bonghanot
# Optional — auto-derived from email when omitted
# SEED_ADMIN_PHONE=09171234567
# SEED_ADMIN_ADDRESS=University of Cebu – LM
# ADMIN | DIRECTOR | COORDINATOR — defaults to DIRECTOR
# SEED_ADMIN_ROLE=ADMIN

# AWS S3 — ID images, profile assets, and chat attachments
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=
