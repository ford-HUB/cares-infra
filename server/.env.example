# Cloud database (primary — used by getDatabaseUrl())
CLOUD_DATABASE_HOSTNAME=your-cloud-host
CLOUD_DATABASE_NAME=your_cloud_db
CLOUD_DATABASE_PORT=5432
CLOUD_DATABASE_USER=your_user
CLOUD_DATABASE_PASSWORD=your_password
INTERNAL_CLOUD_DATABASE_URL=postgresql://your_user:your_password@your-cloud-host/your_cloud_db
EXTERNAL_CLOUD_DATABASE_URL=postgresql://your_user:your_password@your-cloud-host.example.com/your_cloud_db

# Optional fallback for local Docker Postgres (port 5433 avoids host Postgres on 5432)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cares_db

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=8000
# Comma-separated site origins for CORS (Vite default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Microservices (start with: docker compose up db redis fr-service ocr-service ucid-service -d)
FR_SERVICE_URL=http://localhost:8001
OCR_SERVICE_URL=http://localhost:8002
UCID_SERVICE_URL=http://localhost:8003

REDIS_HOST=localhost
REDIS_PORT=6379

# Director seeder (pnpm run seed:admin) — do not commit real passwords
SEED_ADMIN_EMAIL=admin@uclm.edu.ph
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRSTNAME=CARES
SEED_ADMIN_LASTNAME=Director
# Optional — auto-derived from email when omitted
# SEED_ADMIN_PHONE=09171234567
# SEED_ADMIN_ADDRESS=University of Cebu – LM
