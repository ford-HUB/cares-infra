generator client {
  provider = "prisma-client"
  output   = "./common"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id                      String                         @id @default(uuid())
  firstname                    String
  lastname                     String
  middle_name                  String?
  gender                       GenderType                     @default(OTHER)
  age                          Int                            @default(0)
  current_address              String
  phone_number                 String                         @unique
  avatar                       String?
  role_id                      String
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  portal_department            String?
  address_street               String?
  address_barangay             String?
  address_city                 String?
  address_province             String?
  /// Beneficiaries only — how many people the assistance has to cover.
  household_size               Int?
  accounts                     Account[]
  assistance_requests          AssistanceRequest[]
  needs_assessment             NeedsAssessment?
  authored_announcements       Announcement[]                 @relation("AnnouncementAuthor")
  audit_logs                   AuditLog[]
  blocked_ips                  BlockedIp[]
  certificate_deployments      CertificateDeployment[]        @relation("CertificateDeploymentDeployer")
  edited_certificate_templates CertificateTemplate[]          @relation("CertificateTemplateEditor")
  certificate_signatory_lines  CertificateTemplateSignatory[]
  chat_messages                ChatMessage[]
  chat_participants            ConversationParticipant[]
  donations                    Donation[]                     @relation("DonationDonor")
  donation_payments            DonationPayment[]              @relation("DonationPaymentDonor")
  donation_trail_entries       DonationTrailEntry[]           @relation("DonationTrailActor")
  evaluation_assignments       EvaluationAssignment[]         @relation("EvaluationAssignmentAssigner")
  evaluation_responses         EvaluationResponse[]
  event_attendances            EventAttendance[]
  location_pings               EventLocationPing[]
  gmail_connection             GmailConnection?
  issued_certificates          IssuedCertificate[]
  login_activities             LoginActivity[]
  reviewed_monthly_reports     MonthlyReport[]                @relation("MonthlyReportReviewer")
  submitted_monthly_reports    MonthlyReport[]                @relation("MonthlyReportSubmitter")
  monthly_report_folders       MonthlyReportFolder[]          @relation("MonthlyReportFolderCreator")
  notifications                Notification[]                 @relation("UserNotifications")
  oauth_identities             OAuthIdentity[]
  residency_documents          ResidencyDocument[]
  assigned_support_tickets     SupportTicket[]                @relation("SupportTicketAssignee")
  support_tickets              SupportTicket[]                @relation("SupportTicketRequester")
  support_ticket_replies       SupportTicketReply[]           @relation("SupportTicketReplyAuthor")
  role                         Role                           @relation(fields: [role_id], references: [role_id])
  action_suspensions           UserActionSuspension[]
  user_interest                UserInterest?
  permission_overrides         UserPermissionOverride[]
  decided_user_requests        UserRequest[]                  @relation("UserRequestDecider")
  user_requests                UserRequest[]                  @relation("UserRequestRequester")
  role_avatars                 UserRoleAvatar[]
  user_school_info             UserSchoolInfo[]
  user_verifications           UserVerification[]
}

/// Proof of residency (barangay certificate, clearance) a mobile user uploaded
/// to change their address. The address itself is read off the file by OCR
/// and written to `User.current_address`; the file stays on record here.
model ResidencyDocument {
  residency_document_id String   @id @default(uuid())
  user_id               String
  file_url              String
  file_name             String
  mime_type             String
  size_bytes            Int
  /// What OCR read off the document — the address it set at the time.
  extracted_address     String
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, createdAt])
}

/// A mobile user's profile photo for one side of their account. The role
/// switcher is local to the app, so the same person can be a volunteer, donor
/// and beneficiary; each side keeps its own picture here instead of sharing
/// `User.avatar`.
model UserRoleAvatar {
  user_role_avatar_id String   @id @default(uuid())
  user_id             String
  role_type           RoleType
  avatar_url          String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, role_type])
}

model UserSchoolInfo {
  user_school_info_id String     @id @default(uuid())
  id_number           String     @unique
  graduation_year     Int
  graduation_month    Int
  graduation_day      Int
  department_id       String
  major_id            String
  year_level_id       String
  user_id             String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  /// Scan of the school ID presented at registration; absent for ID-less roles.
  school_id_url       String?
  department          Department @relation(fields: [department_id], references: [department_id])
  major               Major      @relation(fields: [major_id], references: [major_id])
  user                User       @relation(fields: [user_id], references: [user_id])
  year_level          YearLevel  @relation(fields: [year_level_id], references: [year_level_id])
}

model Department {
  department_id    String           @id @default(uuid())
  name             String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user_school_info UserSchoolInfo[]
}

model Major {
  major_id         String           @id @default(uuid())
  name             String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user_school_info UserSchoolInfo[]
}

model YearLevel {
  year_level_id    String           @id @default(uuid())
  name             String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user_school_info UserSchoolInfo[]
}

/// One ID check per submission. The biometric enrolled for that check hangs off the
/// verification rather than the user, so a face scan is always tied to the review
/// it was captured for.
model UserVerification {
  user_verification_id String             @id @default(uuid())
  user_id              String
  status               VerificationStatus @default(N)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user_biometric_id    String?            @unique
  user_biometric       UserBiometric?     @relation(fields: [user_biometric_id], references: [user_biometric_id])
  user                 User               @relation(fields: [user_id], references: [user_id])
}

model UserBiometric {
  user_biometric_id String            @id @default(uuid())
  face_url          String
  embedding         Json?
  embedding_type    EmbeddingType     @default(FACE)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user_verification UserVerification?
}

model Role {
  role_id   String   @id @default(uuid())
  type      RoleType @default(VOLUNTEER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

/// Baseline rights every user of a role inherits. Keyed by `RoleType` rather than
/// `role_id` because `Role` has no unique constraint on `type` — see the admin seeder.
model RolePermissionDefault {
  role_permission_default_id String        @id @default(uuid())
  role_type                  RoleType
  permission                 PermissionKey
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  @@unique([role_type, permission])
}

/// A per-user departure from the role baseline. Only rows that actually differ from
/// the role default are stored, so an untouched user has none.
model UserPermissionOverride {
  user_permission_override_id String                   @id @default(uuid())
  user_id                     String
  permission                  PermissionKey
  effect                      PermissionOverrideEffect
  reason                      String?
  granted_by_user_id          String
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  user                        User                     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, permission])
  @@index([user_id])
}

/// A violation-driven suspension of one action. Layers *over* the granted rights: the
/// grant is preserved so lifting the suspension restores the original scope.
model UserActionSuspension {
  user_action_suspension_id String        @id @default(uuid())
  user_id                   String
  permission                PermissionKey
  reason                    String
  issued_by_user_id         String
  /// Null means indefinite — it stays in force until an admin lifts it.
  expires_at                DateTime?
  lifted_at                 DateTime?
  lifted_by_user_id         String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  user                      User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model BlockedIp {
  blocked_ip_id      String   @id @default(uuid())
  ip_address         String   @unique
  reason             String?
  /// The account the block originated from — null for a manually entered address.
  user_id            String?
  blocked_by_user_id String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User?    @relation(fields: [user_id], references: [user_id])
}

/// Portal-wide security settings, held as exactly one row: `singleton` is pinned to
/// true and unique, so an upsert can never create a second policy. Every field has a
/// default here that matches the fallback the server applies when the row is missing.
model SecurityPolicy {
  security_policy_id           String   @id @default(uuid())
  singleton                    Boolean  @unique @default(true)
  password_min_length          Int      @default(8)
  password_require_uppercase   Boolean  @default(true)
  password_require_lowercase   Boolean  @default(true)
  password_require_number      Boolean  @default(true)
  password_require_symbol      Boolean  @default(false)
  lockout_enabled              Boolean  @default(true)
  lockout_max_attempts         Int      @default(5)
  /// How far back failed attempts are counted, in minutes.
  lockout_window_minutes       Int      @default(15)
  /// Minutes a lock is held. 0 means it stays until an administrator lifts it.
  lockout_duration_minutes     Int      @default(30)
  /// Minutes of inactivity before a session is refused. 0 disables the check.
  session_idle_timeout_minutes Int      @default(0)
  /// Hours a session may live regardless of activity. 0 leaves it to the token's own expiry.
  session_max_duration_hours   Int      @default(0)
  /// Devices one account may hold at once. 0 means unlimited.
  max_concurrent_sessions      Int      @default(0)
  login_hours_enabled          Boolean  @default(false)
  /// Minutes past midnight, server time. A start after the end wraps over midnight.
  login_hours_start_minute     Int      @default(0)
  login_hours_end_minute       Int      @default(1440)
  /// Addresses allowed to sign in. Empty means no allowlist — see BlockedIp for the denylist.
  ip_allowlist                 String[] @default([])
  updated_by_user_id           String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

/// One row per sign-in attempt, successful or not. Append-only: nothing updates or
/// deletes a row, so the trail stays reviewable. `user_id` is null when the email
/// matched no account, which is why the typed email is stored alongside it.
model LoginActivity {
  login_activity_id String       @id @default(uuid())
  /// Null when no account matched the submitted email.
  user_id           String?
  /// The email exactly as submitted (lowercased), kept even when no account matched.
  email             String
  ip_address        String
  user_agent        String?
  source            LoginSource
  outcome           LoginOutcome
  /// The message the client was shown; null on a successful sign-in.
  failure_reason    String?
  createdAt         DateTime     @default(now())
  user              User?        @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@index([createdAt])
  @@index([ip_address])
  @@index([email])
}

/// One row per privileged action. Append-only: nothing updates or deletes a row, so
/// the trail stays reviewable. The actor's name, email, and role are denormalised at
/// write time so a later rename or role change cannot rewrite history.
model AuditLog {
  audit_log_id  String        @id @default(uuid())
  /// Machine key, e.g. `access-control.permission.revoked` — stable across wording changes.
  action        String
  /// The sentence the portal renders in the grid.
  description   String
  category      AuditCategory
  severity      AuditSeverity @default(INFO)
  outcome       AuditOutcome  @default(SUCCESS)
  /// Null for background jobs, and for actors whose account was later deleted.
  actor_user_id String?
  actor_name    String
  actor_email   String
  /// Null when the actor is the system rather than an account.
  actor_role    RoleType?
  /// What the action was performed on — `user`, `event`, `certificate`, `system`, …
  target_type   String
  target_label  String
  /// Null when the target is not a single record (a route, a role baseline, a service).
  target_id     String?
  ip_address    String
  user_agent    String?
  source        AuditSource   @default(PORTAL)
  /// Correlates every entry written by one request.
  request_id    String?
  /// Operator-supplied justification, when the action asks for one.
  reason        String?
  /// Field-level before/after pairs: `[{ field, before, after }]`.
  changes       Json          @default("[]")
  /// Free-form context — counts, service scores, template names.
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now())
  actor_user    User?         @relation(fields: [actor_user_id], references: [user_id])

  @@index([actor_user_id])
  @@index([createdAt])
  @@index([category])
  @@index([severity])
  @@index([outcome])
  @@index([action])
}

model Account {
  account_id             String    @id @default(uuid())
  email                  String    @unique
  /// Null for an account that only ever signs in through a social provider — see
  /// `OAuthIdentity`. Password sign-in is refused outright when this is null.
  password               String?
  user_id                String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  /// Set when an administrator provisioned this account with temporary credentials.
  /// Sign-in is refused once it passes; null means the password does not expire, which
  /// is what a self-registered account and a completed hand-over both look like.
  credential_expires_at  DateTime?
  /// The administrator who issued the credential in force — null for self-registration.
  provisioned_by_user_id String?
  /// Portal signatory image (directors/coordinators); printed onto certificates.
  signature_url          String?
  is_restricted          Boolean   @default(false)
  restricted_at          DateTime?
  restriction_reason     String?
  last_login_ip          String?
  email_verified_at      DateTime?
  user                   User      @relation(fields: [user_id], references: [user_id])
}

/// A social identity that may sign in as `user`. One row per provider account, so a
/// donor can attach both Google and Facebook to the same CARES user.
///
/// Unlike `GmailConnection` — which stores mailbox tokens and grants no access on its
/// own — a row here *is* an authentication factor, so no provider token is kept: the
/// token is verified with the provider at sign-in and then discarded.
model OAuthIdentity {
  oauth_identity_id String       @id @default(uuid())
  provider          AuthProvider
  /// The provider's immutable subject id (`sub` for Google, `id` for Facebook). The
  /// email is not the key — providers let people change it.
  provider_user_id  String
  /// Whatever the provider last reported, kept for support lookups only.
  email             String?
  user_id           String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@index([user_id])
}

/// One linked Google mailbox per portal user. Tokens are issued by Google OAuth and
/// refreshed server-side; disconnecting deletes the row so nothing stale is kept.
model GmailConnection {
  gmail_connection_id String   @id @default(uuid())
  user_id             String   @unique
  google_sub          String
  email               String
  /// Granted scopes, space separated, exactly as Google returned them.
  scope               String
  access_token        String
  /// Google only returns this on the first consent, so it is never overwritten with null.
  refresh_token       String
  access_expires_at   DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Interest {
  interest_id String       @id @default(uuid())
  code        InterestCode @unique
  label       String
  description String?
  is_active   Boolean      @default(true)
  sort_order  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model UserInterest {
  user_interest_id String   @id @default(uuid())
  user_id          String   @unique
  selected         Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Event {
  event_id                Int                     @id @default(autoincrement())
  title                   String
  description             String
  event_started           DateTime
  event_ended             DateTime
  location                String
  max_participants        Int
  participants            Int                     @default(0)
  organizer_name          String
  category                String
  department              String?
  specified_category      String?
  images                  String[]                @default([])
  status                  EventStatus             @default(Upcoming)
  funds_donation          Boolean                 @default(false)
  goods_donation          Boolean                 @default(false)
  goods_types             String[]                @default([])
  beneficiary_applicable  Boolean                 @default(false)
  max_beneficiaries       Int?
  geojson                 Json?
  area_sqm                Float?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  /// Pin the operator dropped inside the geofence — the exact meeting spot.
  marker_lat              Float?
  marker_lng              Float?
  certificate_deployments CertificateDeployment[]
  donations               Donation[]
  donation_payments       DonationPayment[]
  evaluation_assignment   EvaluationAssignment?
  evaluation_responses    EvaluationResponse[]
  attendances             EventAttendance[]
  location_pings          EventLocationPing[]
  issued_certificates     IssuedCertificate[]
  user_requests           UserRequest[]
}

/// One volunteer's registration for one event, plus whatever validation has ruled so far.
/// The row is created on registration and stays PENDING until the coordinates are in and
/// judged: before the event, while it runs, and after it for as long as an offline device
/// still has not pushed.
model EventAttendance {
  event_attendance_id String               @id @default(uuid())
  event_id            Int
  user_id             String
  status              AttendanceStatus     @default(PENDING)
  validation_method   GeoValidationMethod?
  /// First reading inside the event geofence.
  first_ping_at       DateTime?
  /// Last reading inside the event geofence.
  last_ping_at        DateTime?
  /// Credited service hours; only meaningful once the row is COMPLETED.
  hours_rendered      Float?
  remarks             String?
  registered_at       DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  event               Event                @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  user                User                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([event_id])
  @@index([user_id])
}

/// One GPS reading from a volunteer's device, one per second while their recorder is
/// on. Live readings arrive one at a time (GEOFENCE); readings buffered offline arrive
/// later as a CSV batch (OFFLINE_SYNC). `event_id` is the device's best guess and is
/// null when it could not name a joined event — the validation service re-assigns rows
/// from the coordinates, so nothing here is authoritative about attendance.
model EventLocationPing {
  event_location_ping_id Int                 @id @default(autoincrement())
  event_id               Int?
  user_id                String
  captured_at            DateTime
  latitude               Float
  longitude              Float
  accuracy_m             Float
  /// The device's own inside-the-geofence check at capture time.
  in_area                Boolean
  source                 GeoValidationMethod
  createdAt              DateTime            @default(now())
  event                  Event?              @relation(fields: [event_id], references: [event_id])
  user                   User                @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([event_id, user_id, captured_at])
  @@index([user_id, captured_at])
}

/// Direct (1:1) portal messaging. Participants are portal staff — volunteers use
/// the mobile app and are not addressable here.
model Conversation {
  conversation_id String                    @id @default(uuid())
  /// Mirrors the newest message so the contact list can sort without a join.
  last_message_at DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  messages        ChatMessage[]
  participants    ConversationParticipant[]
}

model ConversationParticipant {
  conversation_participant_id String       @id @default(uuid())
  conversation_id             String
  user_id                     String
  /// Everything sent after this timestamp counts as unread for this participant.
  last_read_at                DateTime?
  createdAt                   DateTime     @default(now())
  conversation                Conversation @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade)
  user                        User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
  @@index([user_id])
}

model ChatMessage {
  message_id      String           @id @default(uuid())
  conversation_id String
  sender_id       String
  body            String
  createdAt       DateTime         @default(now())
  attachments     ChatAttachment[]
  conversation    Conversation     @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade)
  sender          User             @relation(fields: [sender_id], references: [user_id], onDelete: Cascade)

  @@index([conversation_id, createdAt])
}

model ChatAttachment {
  attachment_id String      @id @default(uuid())
  message_id    String
  name          String
  size          Int
  mime_type     String
  /// S3 object URL; streamed back through the API, never exposed as a public link.
  url           String
  createdAt     DateTime    @default(now())
  message       ChatMessage @relation(fields: [message_id], references: [message_id], onDelete: Cascade)
}

/// A reported problem or request. `reference_number` is the tracking number shown to
/// the requester — sequential and never reused, which is why it is a DB sequence
/// rather than a count of rows.
model SupportTicket {
  support_ticket_id String                @id @default(uuid())
  reference_number  Int                   @unique @default(autoincrement())
  subject           String
  description       String
  type              SupportTicketType
  status            SupportTicketStatus   @default(OPEN)
  priority          SupportTicketPriority @default(MEDIUM)
  requester_id      String
  /// Null while the ticket is unassigned; cleared rather than deleted if the staff
  /// account goes away, so the ticket itself survives.
  assignee_id       String?
  source            LoginSource
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  assignee          User?                 @relation("SupportTicketAssignee", fields: [assignee_id], references: [user_id])
  requester         User                  @relation("SupportTicketRequester", fields: [requester_id], references: [user_id], onDelete: Cascade)
  replies           SupportTicketReply[]

  @@index([status])
  @@index([priority])
  @@index([requester_id])
  @@index([assignee_id])
  @@index([updatedAt])
}

model SupportTicketReply {
  support_ticket_reply_id String                  @id @default(uuid())
  support_ticket_id       String
  /// Null once the author's account is removed; the thread keeps the message.
  author_id               String?
  /// Snapshot of the name shown in the thread, so a deleted author still reads right.
  author_name             String
  author_type             SupportTicketAuthorType
  body                    String
  createdAt               DateTime                @default(now())
  author                  User?                   @relation("SupportTicketReplyAuthor", fields: [author_id], references: [user_id])
  ticket                  SupportTicket           @relation(fields: [support_ticket_id], references: [support_ticket_id], onDelete: Cascade)

  @@index([support_ticket_id, createdAt])
}

/// A certificate design a director maintains in the portal. Everything that is pure
/// drawing instruction — accent, frame, per-block position, fonts, sizes, wording,
/// seal and where each imported image sits — lives in `design`, shaped by
/// `CertificateDesignSchema`. It is one document edited as a whole by one screen, so
/// splitting it into columns would buy nothing and cost a migration per control the
/// customizer gains. What is *not* in there is anything another feature has to join
/// on: the signatory accounts and the uploaded files are their own rows.
model CertificateTemplate {
  certificate_template_id String                         @id @default(uuid())
  /// Human reference printed on the card, e.g. `CT-2026-014`.
  reference               String                         @unique
  name                    String
  description             String
  category                CertificateTemplateCategory    @default(PARTICIPATION)
  status                  CertificateTemplateStatus      @default(DRAFT)
  orientation             CertificateOrientation         @default(LANDSCAPE)
  /// Certificates already printed from this template.
  issued                  Int                            @default(0)
  /// Events currently deploying it.
  deployed_events         Int                            @default(0)
  design                  Json
  /// Null once the editor's account is removed; the template keeps the name.
  updated_by_user_id      String?
  /// Snapshot of who last saved it, so a deleted account still reads right on the card.
  updated_by_name         String                         @default("")
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  deployments             CertificateDeployment[]
  updated_by              User?                          @relation("CertificateTemplateEditor", fields: [updated_by_user_id], references: [user_id])
  assets                  CertificateTemplateAsset[]
  signatories             CertificateTemplateSignatory[]

  @@index([status])
  @@index([category])
  @@index([updatedAt])
}

/// One printed signature line. The coordinator account is the source of truth for the
/// signature image, so the line stores the account rather than typed text; the printed
/// strings are snapshotted beside it so a later rename or transfer cannot silently
/// reword a template certificates were already issued from.
model CertificateTemplateSignatory {
  certificate_template_signatory_id String              @id @default(uuid())
  certificate_template_id           String
  coordinator_user_id               String
  name                              String
  title                             String
  department                        String
  /// The placeholder the print job swaps for the coordinator's stored signature image
  /// (`User.signature_url`). The customizer never shows it — a director picks an
  /// account, not a token — but it is held per line rather than assumed globally so a
  /// line can print without a signature later without a migration.
  signature_token                   String              @default("{{signature-image}}")
  /// Left-to-right order of the lines on the sheet.
  position                          Int                 @default(0)
  createdAt                         DateTime            @default(now())
  updatedAt                         DateTime            @updatedAt
  template                          CertificateTemplate @relation(fields: [certificate_template_id], references: [certificate_template_id], onDelete: Cascade)
  coordinator                       User                @relation(fields: [coordinator_user_id], references: [user_id])

  @@unique([certificate_template_id, coordinator_user_id], map: "CertificateTemplateSignatory_certificate_template_id_coordin_ke")
  @@index([coordinator_user_id])
  @@index([certificate_template_id, position], map: "CertificateTemplateSignatory_certificate_template_id_positio_id")
}

/// A file a director imported onto a sheet. The bytes live in the private S3 bucket,
/// so `design` references the row by id and the portal reads the bytes back through
/// `GET /v1/certificate-templates/:id/assets/:assetId` — an `<img src>` pointed at the
/// stored object URL would render broken.
model CertificateTemplateAsset {
  certificate_template_asset_id String               @id @default(uuid())
  certificate_template_id       String
  kind                          CertificateAssetKind
  /// S3 object key, not a URL — the bucket and region are configuration.
  storage_key                   String
  file_name                     String
  content_type                  String
  byte_size                     Int
  createdAt                     DateTime             @default(now())
  template                      CertificateTemplate  @relation(fields: [certificate_template_id], references: [certificate_template_id], onDelete: Cascade)

  @@index([certificate_template_id])
}

/// One template deployed to one event — what the live certificates page lists. The
/// design, the signature lines and the event's own details are all frozen into the row
/// at deploy time: the template it came from stays editable, and a certificate already
/// promised to a volunteer must not silently change wording when a director tidies the
/// template up afterwards. The template is still referenced, because the frozen design
/// points at that template's stored artwork.
model CertificateDeployment {
  certificate_deployment_id String                      @id @default(uuid())
  /// Human reference for the deployment itself, e.g. `DC-2026-014`.
  reference                 String                      @unique
  certificate_template_id   String
  /// Snapshot of the template's name, category and shape as deployed.
  template_name             String
  category                  CertificateTemplateCategory
  orientation               CertificateOrientation
  /// The frozen sheet: the same shape as `CertificateTemplate.design`, plus the
  /// signature lines as they read on the day.
  design                    Json
  event_id                  Int
  /// Snapshot of the event, so the list reads correctly even if the event is renamed.
  event_name                String
  event_venue               String
  event_date                DateTime
  status                    CertificateDeploymentStatus @default(SCHEDULED)
  /// Participants the deployment covers — the denominator for everything below.
  participants              Int                         @default(0)
  /// Certificates generated and released to a participant.
  distributed               Int                         @default(0)
  /// Of those, how many the recipient actually opened.
  claimed                   Int                         @default(0)
  /// Null once the deploying account is removed; the row keeps the name.
  deployed_by_user_id       String?
  deployed_by_name          String                      @default("")
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  template                  CertificateTemplate         @relation(fields: [certificate_template_id], references: [certificate_template_id])
  deployed_by               User?                       @relation("CertificateDeploymentDeployer", fields: [deployed_by_user_id], references: [user_id])
  event                     Event                       @relation(fields: [event_id], references: [event_id])
  issued_certificates       IssuedCertificate[]

  @@unique([certificate_template_id, event_id])
  @@index([status])
  @@index([event_id])
  @@index([createdAt])
}

/// One certificate the issuing sweep generated for one participant of one deployment.
/// The sheet is frozen here in full — the deployment's design with every placeholder
/// filled and each signature line pointing at the image it printed — so what the
/// volunteer holds never changes if the event, the template or a coordinator's
/// profile is edited afterwards.
model IssuedCertificate {
  issued_certificate_id     String                      @id @default(uuid())
  /// Printed on the sheet, e.g. `CERT-2026-000123`.
  certificate_number        String                      @unique
  certificate_deployment_id String
  event_id                  Int
  user_id                   String
  /// What the placeholders were filled with, as they read on the day of issue.
  recipient_name            String
  event_name                String
  event_date                DateTime
  hours_rendered            Float                       @default(0)
  organization              String
  template_name             String
  category                  CertificateTemplateCategory
  orientation               CertificateOrientation
  /// The deployment's frozen design plus, per signature line, the S3 key of the
  /// coordinator's signature image at issue time (`StoredIssuedDesign`).
  design                    Json
  issued_at                 DateTime                    @default(now())
  /// When the recipient first opened it in the app; null until then.
  claimed_at                DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  deployment                CertificateDeployment       @relation(fields: [certificate_deployment_id], references: [certificate_deployment_id], onDelete: Cascade)
  event                     Event                       @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  user                      User                        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([certificate_deployment_id, user_id])
  @@index([user_id])
  @@index([event_id])
  @@index([issued_at])
}

/// A named tray the director builds on top of the automatic filing — an accreditation
/// packet, a set pulled for a board meeting. College folders are *not* rows: they are
/// derived from each report's `department`, so every approved report has a home before
/// anyone files it anywhere, and deleting a folder only drops it back to its college.
model MonthlyReportFolder {
  monthly_report_folder_id String          @id @default(uuid())
  name                     String
  /// Null once the creating account is removed; the folder keeps the name below.
  created_by_user_id       String?
  created_by_name          String          @default("")
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  reports                  MonthlyReport[]
  created_by               User?           @relation("MonthlyReportFolderCreator", fields: [created_by_user_id], references: [user_id])

  @@index([createdAt])
}

/// One coordinator submission for one reporting month. The submitter's name, email and
/// post are snapshotted beside the account: a report already decided on must keep
/// reading the way it read on the day, even if the coordinator is renamed or moves
/// college.
model MonthlyReport {
  monthly_report_id    String                    @id @default(uuid())
  /// Tracking number both sides quote, e.g. `MR-2026-014`.
  reference            String                    @unique
  title                String
  /// Reporting month as `YYYY-MM` — the period filter and the grouping key.
  period               String
  department           ReportDepartment
  status               MonthlyReportStatus       @default(UNDER_REVIEW)
  summary              String
  metric_events        Int                       @default(0)
  metric_volunteers    Int                       @default(0)
  metric_service_hours Int                       @default(0)
  metric_beneficiaries Int                       @default(0)
  submitted_by_user_id String?
  submitted_by_name    String
  submitted_by_email   String
  submitted_by_title   String
  submitted_at         DateTime                  @default(now())
  reviewer_user_id     String?
  /// Snapshot of the deciding director, shown on the row without a join.
  reviewer_name        String?
  decided_at           DateTime?
  /// Latest decision note — the only thing a returned report gives the coordinator.
  decision_note        String?
  /// The director's tray this sits in. Null means it is filed under its college.
  folder_id            String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  folder               MonthlyReportFolder?      @relation(fields: [folder_id], references: [monthly_report_folder_id])
  reviewer             User?                     @relation("MonthlyReportReviewer", fields: [reviewer_user_id], references: [user_id])
  submitted_by         User?                     @relation("MonthlyReportSubmitter", fields: [submitted_by_user_id], references: [user_id])
  documents            MonthlyReportDocument[]
  trail                MonthlyReportTrailEntry[]

  @@index([status])
  @@index([period])
  @@index([department])
  @@index([folder_id])
  @@index([updatedAt])
}

/// A file attached to a submission. The bytes live in the private S3 bucket, so the
/// row holds the object key and the portal reads them back through
/// `GET /v1/monthly-reports/:id/documents/:documentId` — a stored object URL in an
/// `<a href>` would 403.
model MonthlyReportDocument {
  monthly_report_document_id String                    @id @default(uuid())
  monthly_report_id          String
  /// File name as the coordinator uploaded it, extension included.
  file_name                  String
  kind                       MonthlyReportDocumentKind
  /// S3 object key, not a URL — the bucket and region are configuration.
  storage_key                String
  content_type               String
  byte_size                  Int
  createdAt                  DateTime                  @default(now())
  report                     MonthlyReport             @relation(fields: [monthly_report_id], references: [monthly_report_id], onDelete: Cascade)

  @@index([monthly_report_id])
}

/// Append-only history of the submission: who submitted, who decided, and the note
/// that came with it. This is the report's own record, kept beside the entry rather
/// than in the global audit log because the coordinator reads it too.
model MonthlyReportTrailEntry {
  monthly_report_trail_entry_id String                   @id @default(uuid())
  monthly_report_id             String
  action                        MonthlyReportTrailAction
  /// Snapshot of the actor's name, so a rename cannot rewrite the trail.
  actor_name                    String
  note                          String?
  createdAt                     DateTime                 @default(now())
  report                        MonthlyReport            @relation(fields: [monthly_report_id], references: [monthly_report_id], onDelete: Cascade)

  @@index([monthly_report_id, createdAt])
}

/// A notice written on the Maintenance board and read back on System Notices. State
/// moves forward on its own once a scheduled `publish_at` or `expires_at` passes; the
/// sweep runs on read, so a page that polls sees the flip without a scheduler.
model Announcement {
  announcement_id String                 @id @default(uuid())
  title           String
  body            String
  tone            AnnouncementTone       @default(INFO)
  audiences       AnnouncementAudience[] @default([])
  channels        AnnouncementChannel[]  @default([])
  state           AnnouncementState      @default(DRAFT)
  publish_at      DateTime
  /// Null means it stays up until taken down by hand.
  expires_at      DateTime?
  pinned          Boolean                @default(false)
  /// The maintenance window this notice was written for; windows are not persisted
  /// yet, so this is a loose reference rather than a relation.
  window_id       String?
  author_id       String?
  /// Snapshot of the author's name, so a rename cannot rewrite the board.
  author_name     String
  /// Accounts it reached when it went out; 0 until it publishes.
  reach           Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  author          User?                  @relation("AnnouncementAuthor", fields: [author_id], references: [user_id])

  @@index([state])
  @@index([publish_at])
}

/// One row per recipient. A notice addressed to a role is fanned out to every account
/// holding that role at publish time, so read and dismissed state are per person and
/// a later hire does not inherit a backlog.
model Notification {
  notification_id String               @id @default(uuid())
  user_id         String
  title           String
  description     String
  category        NotificationCategory
  tone            NotificationTone     @default(INFO)
  /// Portal path the row opens — the screen the notice is about.
  href            String?
  /// Set by schedulers so a repeated sweep cannot notify the same thing twice.
  dedupe_key      String?
  /// Which side of a mobile account the row belongs to (a donor who also
  /// volunteers sees donation news only on the Donor side). Null means the row
  /// is about the account itself and shows on every side — and on the portal.
  audience_role   RoleType?
  read_at         DateTime?
  dismissed_at    DateTime?
  createdAt       DateTime             @default(now())
  user            User                 @relation("UserNotifications", fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([dedupe_key, user_id])
  @@index([user_id, dismissed_at, createdAt])
}

/// The post-event questionnaire the director builds in the portal. One form serves
/// every completed event; the volunteer app only ever sees it once PUBLISHED. The
/// questions are stored as the JSON the builder edits (see the evaluation validators
/// for the shape) so adding a question type never needs a migration.
model EvaluationForm {
  evaluation_form_id String                 @id @default(uuid())
  title              String
  description        String                 @default("")
  header_typography  Json
  questions          Json
  status             EvaluationFormStatus   @default(DRAFT)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  /// The one questionnaire served for an event that has none assigned. At most one
  /// row holds it; assigning it elsewhere moves it rather than adding a second.
  is_default         Boolean                @default(false)
  assignments        EvaluationAssignment[]
  responses          EvaluationResponse[]
}

/// Which questionnaire one event asks its participants. An event has at most one,
/// a questionnaire can serve many, and an event without a row falls back to the
/// questionnaire flagged `is_default` — so feedback never goes dark on an event
/// the director has not got to yet.
model EvaluationAssignment {
  evaluation_assignment_id String         @id @default(uuid())
  form_id                  String
  event_id                 Int            @unique
  /// The director who assigned it; kept null when the account is later removed.
  assigned_by_id           String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  assigned_by              User?          @relation("EvaluationAssignmentAssigner", fields: [assigned_by_id], references: [user_id])
  event                    Event          @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  form                     EvaluationForm @relation(fields: [form_id], references: [evaluation_form_id], onDelete: Cascade)

  @@index([form_id])
}

/// How the volunteer leaderboard is scored and how its tier ladder is cut. One row:
/// the portal's Rankings → Customization edits it, the volunteer app reads the tiers
/// to draw its avatar frames. `tiers` is the JSON the customization form edits (see
/// the rankings validators) so a new frame design never needs a migration.
model RankingSettings {
  ranking_settings_id   String   @id @default(uuid())
  /// Points a volunteer earns for every event they attended (COMPLETED).
  points_per_attendance Int      @default(10)
  /// First missed registration costs this much; each straight miss adds it again.
  absence_penalty_step  Int      @default(2)
  /// Misses further apart than this restart the penalty at the first step.
  absence_reset_days    Int      @default(7)
  default_period        String   @default("month")
  tiers                 Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  /// Donor board: one point for every this many pesos of confirmed donations.
  donor_pesos_per_point Int      @default(100)
  /// Peso value credited per unit of each goods type (`food`, `clothing`, …) when a
  /// goods donation is scored; null falls back to the shipped defaults.
  goods_type_values     Json?
}

/// One volunteer's answers to the questionnaire for one completed event they took
/// part in. `answers` is keyed by question id; `rating` copies the star-rating
/// answer out so the portal can filter and average without opening the JSON.
model EvaluationResponse {
  evaluation_response_id String                   @id @default(uuid())
  form_id                String
  event_id               Int
  user_id                String
  answers                Json
  rating                 Int?
  status                 EvaluationResponseStatus @default(COMPLETE)
  submitted_at           DateTime                 @default(now())
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  event                  Event                    @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  form                   EvaluationForm           @relation(fields: [form_id], references: [evaluation_form_id], onDelete: Cascade)
  user                   User                     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([event_id])
  @@index([user_id])
}

/// One request filed from the mobile app for a director to rule on. The proof
/// behind a ROLE_ACCESS request (ID sides, selfie) is copied off the Redis
/// registration session at filing time so it outlives that session's TTL.
model UserRequest {
  user_request_id      String                  @id @default(uuid())
  /// Sequential tracking number; the portal renders it as `REQ-007`.
  reference_number     Int                     @unique @default(autoincrement())
  kind                 UserRequestKind
  status               UserRequestStatus       @default(PENDING)
  user_id              String
  /// ROLE_ACCESS only — the role being asked for.
  requested_role       RoleType?
  /// EVENT_JOIN only — the event the beneficiary wants to attend.
  event_id             Int?
  id_front_url         String?
  id_back_url          String?
  selfie_url           String?
  face_similarity      Float?
  /// One-line statement of what is being asked for, written at filing time.
  summary              String
  decided_by_user_id   String?
  decided_at           DateTime?
  /// Set when a director rejects the request — the reason the requester sees
  /// in the app. Cleared never: a re-application is a new row.
  rejection_reason     String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  /// The 512-dim face embedding from the session's match, kept so acceptance
  /// can enrol the biometric without re-running the face service.
  selfie_embedding     Json?
  /// EVENT_JOIN only — the proof of residency the beneficiary attached.
  residency_proof_url  String?
  residency_proof_name String?
  residency_proof_mime String?
  decided_by           User?                   @relation("UserRequestDecider", fields: [decided_by_user_id], references: [user_id])
  event                Event?                  @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  user                 User                    @relation("UserRequestRequester", fields: [user_id], references: [user_id], onDelete: Cascade)
  trail                UserRequestTrailEntry[]

  @@index([user_id])
  @@index([status])
  @@index([kind, status])
}

/// One line on a request's history — filed, accepted, removed, restored.
model UserRequestTrailEntry {
  user_request_trail_entry_id String      @id @default(uuid())
  user_request_id             String
  label                       String
  /// Who caused it — the requester for the filing, a portal account after that.
  actor_name                  String
  createdAt                   DateTime    @default(now())
  user_request                UserRequest @relation(fields: [user_request_id], references: [user_request_id], onDelete: Cascade)

  @@index([user_request_id])
}

/// A beneficiary's Needs Assessment Survey — one per account, overwritten when
/// they update it. Answers are stored as the codes the residential-needs
/// clustering works on (`food`, `money`, …), not the app's display labels.
model NeedsAssessment {
  needs_assessment_id     String   @id @default(uuid())
  user_id                 String   @unique
  /// Q1 — what the household needs help with (`food`, `healthcare`, … `other`).
  needs                   String[]
  other_need              String?
  /// Q2 — 1 (not serious) to 5 (very serious).
  seriousness             Int
  /// Q3 — what makes the need hard to meet (`money`, … `other`, `none`).
  barriers                String[]
  other_barrier           String?
  /// Q4 — the problem most commonly seen in the community.
  community_problem       String
  other_community_problem String?
  /// Q5 — anything else the household wants CARES to know.
  concern                 String?
  /// When the answers were last submitted — the first take or the latest update.
  submitted_at            DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

/// Assistance a beneficiary asked for from the app (food pack, medicine, …).
/// The stage timestamps drive the progress trail the app draws.
model AssistanceRequest {
  assistance_request_id String                        @id @default(uuid())
  /// Sequential tracking number; the app renders it as `CARES-AR-2026-0007`.
  reference_number      Int                           @unique @default(autoincrement())
  user_id               String
  /// What is needed — the picked option or what the beneficiary typed.
  title                 String
  category              AssistanceCategory
  description           String
  urgency               AssistanceUrgency
  household_size        Int
  status                AssistanceRequestStatus       @default(PENDING)
  assessment_status     AssistanceAssessmentStatus    @default(NOT_STARTED)
  /// The needs assessment visit — scheduled or held.
  assessment_date       DateTime?
  assigned_organization String?
  /// What is being released, filled in by staff once it is decided.
  items                 String[]
  /// Staff note shown under the status; the app falls back to a stock line.
  status_note           String?
  screened_at           DateTime?
  decided_at            DateTime?
  released_at           DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  user                  User                          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  attachments           AssistanceRequestAttachment[]

  @@index([user_id])
  @@index([status])
}

/// A proof document filed with an assistance request (ID, bill, photo, …).
model AssistanceRequestAttachment {
  assistance_request_attachment_id String            @id @default(uuid())
  assistance_request_id            String
  name                             String
  url                              String
  mime                             String
  size_bytes                       Int
  createdAt                        DateTime          @default(now())
  assistance_request               AssistanceRequest @relation(fields: [assistance_request_id], references: [assistance_request_id], onDelete: Cascade)

  @@index([assistance_request_id])
}

/// One money-donation checkout a donor started from the app. A row is created
/// before the gateway is called so the client's idempotency key can dedupe a
/// retried tap, and the gateway reference on it is what every Xendit callback
/// carries back.
model DonationPayment {
  donation_payment_id String                @id @default(uuid())
  user_id             String
  /// The director event behind the campaign, when the campaign is event-backed.
  event_id            Int?
  campaign_id         String
  campaign_title      String
  /// Whole pesos.
  amount              Int
  currency            String                @default("PHP")
  method              DonationPaymentMethod
  status              DonationPaymentStatus @default(PENDING)
  /// Client-generated per checkout attempt; the same key returns the same row.
  idempotency_key     String
  /// The `reference_id` / `external_id` handed to Xendit; callbacks carry it back.
  gateway_reference   String                @unique
  /// Xendit's id for the charge, QR code or invoice we created.
  gateway_resource_id String?
  /// Xendit's id for the settled payment — the reference shown on the receipt.
  payment_reference   String?
  /// Payment channel Xendit reported on settlement (e.g. DD_BPI for a bank transfer).
  payment_channel     String?
  /// GCASH / CARD / BANK_TRANSFER: where the donor completes the payment.
  checkout_url        String?
  /// QRPH only: the EMV string the app renders as a QR code.
  qr_string           String?
  expires_at          DateTime?
  paid_at             DateTime?
  failure_reason      String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  donation            Donation?
  event               Event?                @relation(fields: [event_id], references: [event_id])
  user                User                  @relation("DonationPaymentDonor", fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, idempotency_key])
  @@index([user_id])
  @@index([status])
}

/// Every Xendit callback already applied, keyed by its `webhook-id` header.
/// Xendit retries until it sees a 2xx, so the same event can arrive more than
/// once; inserting here in the same transaction as the status change makes a
/// replay a no-op.
model PaymentWebhookEvent {
  webhook_id        String   @id
  event             String
  gateway_reference String?
  payload           Json
  receivedAt        DateTime @default(now())

  @@index([gateway_reference])
}

/// The donation ledger the portal's Donation Tracking works and the donor app's
/// Activity tab reads. A money row is opened by the gateway callback once a
/// checkout is paid; a goods row is opened when the donor pledges. Only CONFIRMED
/// rows count towards the donor board.
model Donation {
  donation_id    String               @id @default(uuid())
  /// Human tracking number — `DN-0007` is sequence 7.
  sequence       Int                  @unique @default(autoincrement())
  user_id        String
  event_id       Int
  kind           DonationKind
  status         DonationStatus       @default(PLEDGED)
  /// Whole pesos: what was paid for money; the credited value of the goods
  /// (goods-type value × quantity, snapshotted at pledge time) for goods.
  amount         Int
  payment_id     String?              @unique
  /// Goods only — the `goods_types` id on the event (`food`, `clothing`, …) or `other`.
  goods_type     String?
  /// Goods only — what the donor said they are giving.
  goods_item     String?
  goods_quantity Int?
  /// Goods only — the number CARES can reach the donor on about the drop-off.
  donor_contact  String?
  /// Goods only — the day the donor plans to hand the goods in at the CARES office.
  delivery_date  DateTime?
  confirmed_at   DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  event          Event                @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  payment        DonationPayment?     @relation(fields: [payment_id], references: [donation_payment_id])
  user           User                 @relation("DonationDonor", fields: [user_id], references: [user_id], onDelete: Cascade)
  trail          DonationTrailEntry[]

  @@index([user_id])
  @@index([event_id])
  @@index([status])
}

/// Every status move on a donation, with who made it — the audit trail the portal
/// shows and the proof that the donor was notified.
model DonationTrailEntry {
  donation_trail_entry_id String         @id @default(uuid())
  donation_id             String
  status                  DonationStatus
  note                    String?
  actor_id                String?
  /// `System` for the donor-side submission, otherwise the portal account's name.
  actor_label             String
  /// Donor address the status notice went to; null when nothing was sent.
  notified_email          String?
  createdAt               DateTime       @default(now())
  actor                   User?          @relation("DonationTrailActor", fields: [actor_id], references: [user_id])
  donation                Donation       @relation(fields: [donation_id], references: [donation_id], onDelete: Cascade)

  @@index([donation_id])
}

model PaymentGatewaySettings {
  payment_gateway_settings_id String                 @id
  singleton                   Boolean                @unique @default(true)
  mode                        PaymentGatewayMode     @default(TEST)
