/// The Xendit channel behind each option on the app's payment-method step.
/// GCASH is an e-wallet charge, QRPH a dynamic QR Ph code, CARD and
/// BANK_TRANSFER go through Xendit's hosted checkout (card entry with 3DS,
/// or BPI / UnionBank / RCBC / Chinabank direct debit).
enum DonationPaymentMethod {
  GCASH
  QRPH
  CARD
  BANK_TRANSFER
}

/// Payment lifecycle as Xendit reports it. PENDING is a checkout still open;
/// the other three are terminal and are only ever set from a gateway callback
/// or a status reconcile — never from the app.
enum DonationPaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

/// One money-donation checkout a donor started from the app. A row is created
/// before the gateway is called so the client's idempotency key can dedupe a
/// retried tap, and the gateway reference on it is what every Xendit callback
/// carries back.
model DonationPayment {
  donation_payment_id String                @id @default(uuid())
  user_id             String
  user                User                  @relation("DonationPaymentDonor", fields: [user_id], references: [user_id], onDelete: Cascade)
  /// The director event behind the campaign, when the campaign is event-backed.
  event_id            Int?
  event               Event?                @relation(fields: [event_id], references: [event_id], onDelete: SetNull)
  campaign_id         String
  campaign_title      String
  /// Whole pesos.
  amount              Int
  currency            String                @default("PHP")
  method              DonationPaymentMethod
  status              DonationPaymentStatus @default(PENDING)
  /// Client-generated per checkout attempt; the same key returns the same row.
  idempotency_key     String
  /// The `reference_id` / `external_id` handed to Xendit; callbacks carry it back.
  gateway_reference   String                @unique
  /// Xendit's id for the charge, QR code or invoice we created.
  gateway_resource_id String?
  /// Xendit's id for the settled payment — the reference shown on the receipt.
  payment_reference   String?
  /// Payment channel Xendit reported on settlement (e.g. DD_BPI for a bank transfer).
  payment_channel     String?
  /// GCASH / CARD / BANK_TRANSFER: where the donor completes the payment.
  checkout_url        String?
  /// QRPH only: the EMV string the app renders as a QR code.
  qr_string           String?
  expires_at          DateTime?
  paid_at             DateTime?
  failure_reason      String?
  /// The ledger row opened when this checkout settled as PAID.
  donation            Donation?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([user_id, idempotency_key])
  @@index([user_id])
  @@index([status])
}

/// Every Xendit callback already applied, keyed by its `webhook-id` header.
/// Xendit retries until it sees a 2xx, so the same event can arrive more than
/// once; inserting here in the same transaction as the status change makes a
/// replay a no-op.
model PaymentWebhookEvent {
  webhook_id        String   @id
  event             String
  gateway_reference String?
  payload           Json
  receivedAt        DateTime @default(now())

  @@index([gateway_reference])
}

/// Which Xendit account answers: the key prefix decides it, so the mode is stored
/// alongside the key only so the portal can say out loud which one is live.
enum PaymentGatewayMode {
  TEST
  LIVE
}

/// Where a channel stands with the gateway. A channel is only chargeable once Xendit
/// reports it activated on the account *and* the callbacks for it are registered;
/// until the account exists, switching one on parks it at PENDING.
enum PaymentMethodVerification {
  /// Never checked — the director has not switched it on yet.
  NOT_VERIFIED
  /// Asked for, but the gateway could not answer yet (no account connected).
  PENDING
  /// Xendit reports the channel activated and the callbacks registered.
  VERIFIED
  /// The gateway answered and refused it; `verification_message` says why.
  FAILED
}

/// How far the receiving account has got through ownership proof. CARES sends a small
/// payout of a random amount to the account the director recorded, and the director
/// proves they hold it by reporting the amount that arrived — the standard
/// micro-deposit check, because no API will confirm who owns a GCash number.
enum PaymentAccountProof {
  /// No payout sent yet.
  NOT_STARTED
  /// The payout is with the gateway, not yet reported as received.
  SENDING
  /// Money is on its way; waiting for the director to report the amount.
  AWAITING_CONFIRMATION
  /// The director reported the right amount — the account is theirs to reach.
  VERIFIED
  /// The payout was refused, or the amount was reported wrong too many times.
  FAILED
}

/// The Xendit account CARES collects donations into, as the director enters it in
/// the portal's Payments module. One row — every donor pays into the same account.
///
/// The secrets are held as AES-256-GCM ciphertext (see `secret-cipher-utils.ts`) and
/// are never sent back to a client: the portal only ever sees `secret_key_last4` and
/// the `*_set` flags, which is enough to say "a key is saved, and it ends in 1a2b".
model PaymentGatewaySettings {
  payment_gateway_settings_id String             @id @default(uuid())
  singleton                   Boolean            @unique @default(true)
  mode                        PaymentGatewayMode @default(TEST)
  /// Off until the director is ready to take money; every checkout is refused while false.
  enabled                     Boolean            @default(false)
  /// Ciphertext of the Xendit secret API key. Null means "still on the env key".
  secret_key_cipher           String?
  /// Last four characters of the saved key, for telling two keys apart in the portal.
  secret_key_last4            String?
  /// Ciphertext of the callback verification token from Xendit's dashboard.
  webhook_token_cipher        String?
  /// Blank for https://api.xendit.co — only set when pointing at a mock or proxy.
  api_url                     String?
  /// The name the donor sees on the GCash / card statement.
  statement_name              String?
  /// Where donors reach CARES about a payment that went wrong.
  support_email               String?
  support_contact             String?
  /// When the saved key last answered a live call, and why it last did not.
  verified_at                 DateTime?
  verification_error          String?
  methods                     PaymentMethodSetting[]
  /// No relation, like `SecurityPolicy`: the row outlives the account that saved it.
  updated_by_user_id          String?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
}

/// One donor-facing payment channel. A channel the director has not enabled is not
/// offered in the app and is refused by the checkout endpoint, so hiding it in the
/// portal and blocking it on the server are one decision.
model PaymentMethodSetting {
  payment_method_setting_id String                 @id @default(uuid())
  settings_id               String
  settings                  PaymentGatewaySettings @relation(fields: [settings_id], references: [payment_gateway_settings_id], onDelete: Cascade)
  method                    DonationPaymentMethod
  enabled                   Boolean                @default(false)
  /// Overrides the channel's built-in name in the app; blank keeps the default.
  display_name              String?
  /// One line under the name on the donor's method step.
  instructions              String?
  /// The account the settlement lands in, as the director reads it off Xendit — the
  /// GCash number or bank account. Reference only: Xendit routes to the account
  /// behind the secret key, not to whatever is typed here.
  account_name              String?
  account_number            String?
  /// Xendit channel codes this method opens (CARD / BANK_TRANSFER); empty uses the
  /// module's defaults.
  channel_codes             String[]               @default([])
  /// Whole pesos. 0 falls back to the module-wide donation limits.
  min_amount                Int                    @default(0)
  max_amount                Int                    @default(0)
  sort_order                Int                    @default(0)
  /// Set by the activation check that runs when the director switches this on.
  verification              PaymentMethodVerification @default(NOT_VERIFIED)
  verified_at               DateTime?
  /// What the gateway said — the sentence the portal shows under the badge.
  verification_message      String?
  /// Channel codes Xendit reported activated at the last check, for the record.
  verified_channel_codes    String[]               @default([])
  /// When the callback URLs for this channel were last registered with Xendit.
  callbacks_registered_at   DateTime?
  /// --- ownership proof: is the recorded account really reachable by CARES ---
  account_proof             PaymentAccountProof @default(NOT_STARTED)
  /// Whole pesos sent, and the number the director has to report back. Cleared once
  /// the account is verified so a later reader cannot simply look up the answer.
  account_proof_amount      Int?
  /// Our reference on the payout, and Xendit's id for it.
  account_proof_reference   String?
  account_proof_id          String?
  account_proof_sent_at     DateTime?
  /// Wrong answers so far; the proof locks after `ACCOUNT_PROOF_MAX_ATTEMPTS`.
  account_proof_attempts    Int                 @default(0)
  /// What the gateway or the check last said, for the portal to show.
  account_proof_message     String?
  /// The account this proof covered, so editing the number invalidates the proof.
  account_proof_target      String?
  account_verified_at       DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@unique([settings_id, method])
}

enum DonationKind {
  MONEY
  GOODS
}

/// One ladder for both kinds, walked at different speeds. Goods: PLEDGED →
/// AWAITING_PICKUP (CARES expects the donor to drop the goods off at the office
/// on their delivery date) → VERIFYING → CONFIRMED. Money (already paid through the
/// gateway): PLEDGED → VERIFYING → CONFIRMED. DECLINED is the director's off-ramp;
/// CANCELLED is the donor's, and only from PLEDGED.
enum DonationStatus {
  PLEDGED
  AWAITING_PICKUP
  VERIFYING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum PaymentAccountProof {
  NOT_STARTED
  SENDING
  AWAITING_CONFIRMATION
  VERIFIED
  FAILED
}

enum PaymentGatewayMode {
  TEST
  LIVE
}

enum PaymentMethodVerification {
  NOT_VERIFIED
  PENDING
  VERIFIED
  FAILED
}
