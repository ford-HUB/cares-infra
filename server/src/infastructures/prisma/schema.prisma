/// Append-only; actor details denormalised so renames can't rewrite history.
model AuditLog {
  audit_log_id  String        @id @default(uuid())
  /// e.g. `access-control.permission.revoked`; stable across wording changes.
  action        String
  description   String
  category      AuditCategory
  severity      AuditSeverity @default(INFO)
  outcome       AuditOutcome  @default(SUCCESS)
  /// Null for background jobs and deleted actors.
  actor_user_id String?
  actor_user    User?         @relation(fields: [actor_user_id], references: [user_id], onDelete: SetNull)
  actor_name    String
  actor_email   String
  /// Null when the actor is the system.
  actor_role    RoleType?
  /// e.g. `user`, `event`, `certificate`, `system`.
  target_type   String
  target_label  String
  /// Null when not a single record.
  target_id     String?
  ip_address    String
  user_agent    String?
  source        AuditSource   @default(PORTAL)
  /// Correlates one request's entries.
  request_id    String?
  reason        String?
  /// `[{ field, before, after }]`.
  changes       Json          @default("[]")
  /// Free-form context.
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now())

  @@index([actor_user_id])
  @@index([createdAt])
  @@index([category])
  @@index([severity])
  @@index([outcome])
  @@index([action])
}

model Account {
  account_id String   @id @default(uuid())
