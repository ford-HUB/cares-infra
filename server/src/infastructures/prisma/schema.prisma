  event               Event?                @relation(fields: [event_id], references: [event_id], onDelete: SetNull)
  campaign_id         String
  campaign_title      String
  /// Whole pesos.
  amount              Int
  currency            String                @default("PHP")
  method              DonationPaymentMethod
  status              DonationPaymentStatus @default(PENDING)
  /// Per checkout attempt; the same key returns the same row.
  idempotency_key     String
  /// Xendit `reference_id` / `external_id`; callbacks carry it back.
  gateway_reference   String                @unique
  /// Xendit's charge, QR code or invoice id.
  gateway_resource_id String?
  /// Xendit's settled payment id (receipt reference).
  payment_reference   String?
  /// Reported on settlement (e.g. DD_BPI).
  payment_channel     String?
  /// GCASH / CARD / BANK_TRANSFER.
  checkout_url        String?
  /// QRPH only: the EMV string to render.
  qr_string           String?
  expires_at          DateTime?
  paid_at             DateTime?
  failure_reason      String?
  /// Opened when settled as PAID.
  donation            Donation?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([user_id, idempotency_key])
  @@index([user_id])
  @@index([status])
}

/// Keyed by `webhook-id`; inserted with the status change so replays are no-ops.
model PaymentWebhookEvent {
  webhook_id        String   @id
  event             String
  gateway_reference String?
  payload           Json
  receivedAt        DateTime @default(now())

  @@index([gateway_reference])
}

/// The key prefix decides; stored only so the portal can say which is live.
enum PaymentGatewayMode {
  TEST
  LIVE
}

/// Chargeable only once Xendit reports it active and callbacks are registered; PENDING without an account.
enum PaymentMethodVerification {
  /// Never checked.
  NOT_VERIFIED
  /// No account connected yet.
  PENDING
  /// Active with callbacks registered.
  VERIFIED
  /// Refused; see `verification_message`.
  FAILED
}

/// Micro-deposit check: a random payout the director reports back (no API proves GCash ownership).
enum PaymentAccountProof {
  NOT_STARTED
  /// With the gateway, not yet received.
  SENDING
  /// Waiting for the director to report the amount.
  AWAITING_CONFIRMATION
  /// Reported correctly.
  VERIFIED
  /// Payout refused, or too many wrong answers.
  FAILED
}

/// Single row. Secrets are AES-256-GCM ciphertext (`secret-cipher-utils.ts`), never sent to clients; only `secret_key_last4` and `*_set` flags.
model PaymentGatewaySettings {
  payment_gateway_settings_id String             @id @default(uuid())
  singleton                   Boolean            @unique @default(true)
  mode                        PaymentGatewayMode @default(TEST)
  /// Checkouts are refused while false.
  enabled                     Boolean            @default(false)
  /// Null = still on the env key.
  secret_key_cipher           String?
  /// Tells saved keys apart.
  secret_key_last4            String?
  webhook_token_cipher        String?
  /// Blank = https://api.xendit.co; set only for a mock or proxy.
  api_url                     String?
  /// Shown on the donor's statement.
  statement_name              String?
  support_email               String?
  support_contact             String?
  /// Last successful live call, and why it last failed.
  verified_at                 DateTime?
  verification_error          String?
  methods                     PaymentMethodSetting[]
  /// No relation, like `SecurityPolicy`: outlives the account.
  updated_by_user_id          String?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
}

/// Disabled channels are hidden in the app and refused at checkout.
model PaymentMethodSetting {
  payment_method_setting_id String                 @id @default(uuid())
  settings_id               String
  settings                  PaymentGatewaySettings @relation(fields: [settings_id], references: [payment_gateway_settings_id], onDelete: Cascade)
  method                    DonationPaymentMethod
  enabled                   Boolean                @default(false)
  /// Blank keeps the default.
  display_name              String?
  instructions              String?
  /// Reference only: Xendit routes to the secret key's account, not this.
  account_name              String?
  account_number            String?
  /// CARD / BANK_TRANSFER; empty uses module defaults.
  channel_codes             String[]               @default([])
  /// Whole pesos; 0 uses module-wide limits.
  min_amount                Int                    @default(0)
  max_amount                Int                    @default(0)
  sort_order                Int                    @default(0)
  /// Set by the activation check.
  verification              PaymentMethodVerification @default(NOT_VERIFIED)
  verified_at               DateTime?
  /// Shown under the badge.
  verification_message      String?
  /// For the record.
  verified_channel_codes    String[]               @default([])
  callbacks_registered_at   DateTime?
  /// Ownership proof fields.
  account_proof             PaymentAccountProof @default(NOT_STARTED)
  /// Whole pesos the director must report; cleared once verified.
  account_proof_amount      Int?
  /// Ours and Xendit's payout ids.
  account_proof_reference   String?
  account_proof_id          String?
  account_proof_sent_at     DateTime?
  /// Locks after `ACCOUNT_PROOF_MAX_ATTEMPTS`.
  account_proof_attempts    Int                 @default(0)
  account_proof_message     String?
  /// Editing the number invalidates the proof.
  account_proof_target      String?
  account_verified_at       DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@unique([settings_id, method])
}

enum DonationKind {
  MONEY
  GOODS
}

/// Goods: PLEDGED → AWAITING_PICKUP (office drop-off) → VERIFYING → CONFIRMED. Money: PLEDGED → VERIFYING → CONFIRMED.
/// DECLINED is the director's off-ramp; CANCELLED the donor's, only from PLEDGED.
enum DonationStatus {
  PLEDGED
  AWAITING_PICKUP
  VERIFYING
  CONFIRMED
  DECLINED
  CANCELLED
}
