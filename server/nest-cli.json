{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "shared/templates/**/*",
        "outDir": "dist",
        "watchAssets": true
      },
      {
        "include": "infastructures/prisma/common/package.json",
        "outDir": "dist",
        "watchAssets": true
      }
    ]
  }
}
